<Window x:Class="AetherLauncher.RobloxLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AetherLauncher.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Roblox" Height="760" Width="960" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,13">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="AETHER" Style="{StaticResource SectionHeader}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="never sees your password" Style="{StaticResource Note}" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="SIGN IN WITH ROBLOX" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="This is Roblox's own login page. Type your password here if you want - it goes straight to Roblox, not into Aether." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" />

            <Border x:Name="LoadingLayer" Background="{DynamicResource BgBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock x:Name="LoadingTitle" Text="Opening Roblox…" Style="{StaticResource SectionHeader}"
                               TextAlignment="Center" />
                    <TextBlock x:Name="LoadingText" Style="{StaticResource Note}" Margin="0,8,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="The login runs in Roblox's own page. Aether only takes the session key afterwards and stores it encrypted on this PC." />
                    <c:RippleButton x:Name="FallbackButton" Content="Open in browser instead"
                                    Style="{StaticResource PlainButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Click="Fallback_Click"
                                    Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,11">
            <DockPanel>
                <c:RippleButton DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource GhostButton}"
                                Click="Cancel_Click" VerticalAlignment="Center" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="No password is stored. The session key is encrypted with Windows DPAPI + AES-256-GCM."
                               Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusLine" Style="{StaticResource Note}" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                               Text="Use 2FA, a passkey or a security key just like in your browser." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
