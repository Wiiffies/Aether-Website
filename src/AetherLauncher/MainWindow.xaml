<Window x:Class="AetherLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AetherLauncher.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aether" Height="660" Width="1000" MinHeight="560" MinWidth="840"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}" TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        RenderOptions.ClearTypeHint="Enabled">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Shell" Background="{DynamicResource PageGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ===================== Kopfleiste ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <c:RippleButton x:Name="MinButton" Style="{StaticResource WindowButton}" Click="MinButton_Click"
                                    ToolTip="Minimize">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M1,6 L13,6" />
                    </c:RippleButton>
                    <c:RippleButton x:Name="MaxButton" Style="{StaticResource WindowButton}" Click="MaxButton_Click"
                                    ToolTip="Maximize">
                        <Grid>
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" Data="M1,1 L13,1 13,13 1,13 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Value="Maximized"
                                                         Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M3,5 L11,5 11,13 3,13 Z M5,5 L5,1 13,1 13,9 11,9" Visibility="Collapsed">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Value="Maximized"
                                                         Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </c:RippleButton>
                    <c:RippleButton x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Click="CloseButton_Click"
                                    ToolTip="Close">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M1,1 L13,13 M13,1 L1,13" />
                    </c:RippleButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Aether" Style="{StaticResource AppName}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource VersionText}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />

                    <!-- Nur die Reiter sind klickbar (Chrome-Hittest); Logo und Wortmarke bleiben Ziehfläche.
                         Der blaue Strich gleitet beim Wechsel unter den neuen Reiter. -->
                    <Grid x:Name="NavBar" Margin="24,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NavHome" Style="{StaticResource Tab}" GroupName="Nav" Tag="0"
                                         Checked="NavTab_Checked" ToolTip="Home (Ctrl+1)">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-home.png"
                                                 Tint="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Home" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAccounts" Style="{StaticResource Tab}" GroupName="Nav" Tag="1"
                                         Checked="NavTab_Checked" ToolTip="Accounts (Ctrl+2)">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-users.png"
                                                 Tint="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Accounts" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavEngine" Style="{StaticResource Tab}" GroupName="Nav" Tag="2"
                                         Checked="NavTab_Checked" ToolTip="FastFlags (Ctrl+3)">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-script.png"
                                                 Tint="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Engine" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Tab}" GroupName="Nav" Tag="3"
                                         Checked="NavTab_Checked" ToolTip="Settings (Ctrl+4)">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-settings.png"
                                                 Tint="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Settings" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLog" Style="{StaticResource Tab}" GroupName="Nav" Tag="4"
                                         Checked="NavTab_Checked" ToolTip="Log (Ctrl+5)">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-open.png"
                                                 Tint="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Log" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Border x:Name="NavGlide" Width="26" Height="3" CornerRadius="2" Margin="0,0,0,1"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0"
                                Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavGlideShift" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Seiten ===================== -->
        <Grid Grid.Row="1">

            <!-- ===== Home ===== -->
            <Grid x:Name="PageHome" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.15*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <c:CardPanel x:Name="HeroCard" Grid.Row="0" Radius="10" Padding="16" Margin="0,0,0,12"
                             Fill="{DynamicResource HeroBrush}" StrokeBrush="{DynamicResource BorderBlueBrush}"
                             StrokeThickness="1" HoverFill="{DynamicResource HoverWashSoftBrush}"
                             Template="{StaticResource CardTemplate}" MouseEnter="HeroCard_MouseEnter">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="64" Height="64">
                            <Border Background="{DynamicResource AccentDeepBrush}" CornerRadius="10" />
                            <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="HeroIcon" CornerRadius="10" Background="{Binding HeroIconBrush}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroName" Text="{Binding HeroTitle}" Style="{StaticResource HeroTitle}" />
                            <TextBlock x:Name="HeroSubLine" Text="{Binding HeroSubtitle}" Style="{StaticResource HeroSub}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <c:RippleButton Style="{StaticResource GhostButton}" Padding="12,8"
                                            Command="{Binding LaunchAppCommand}"
                                            ToolTip="Open the Roblox app itself (its home screen) instead of a game">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-home.png" Width="13" Height="13"
                                                 Tint="{DynamicResource TextHiBrush}" />
                                    <TextBlock Text="Roblox app" Margin="6,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>

                            <c:RippleButton Style="{StaticResource PrimaryButton}" MinWidth="96" Padding="16,8" Margin="8,0,0,0"
                                            Command="{Binding LaunchCommand}"
                                            ToolTip="Play the selected game - or open the Roblox app when no game is selected (Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-play.png" Width="13" Height="13"
                                                 Tint="{DynamicResource WhiteBrush}" />
                                    <TextBlock Text="{Binding PlayLabel}" Margin="6,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>
                        </StackPanel>

                        <!-- Glanz, der beim Überfahren über die Karte läuft (Playful-Modus) -->
                        <Border x:Name="HeroShine" Grid.ColumnSpan="3" Width="120" Margin="0,1,0,1"
                                HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="HeroShineShift" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#1FFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </c:CardPanel>

                <c:CardPanel Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <c:RippleButton DockPanel.Dock="Right" Style="{StaticResource PlainButton}"
                                            Command="{Binding ToggleAddGameCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-search.png" Width="13" Height="13"
                                                 Tint="{DynamicResource TextDimBrush}" />
                                    <TextBlock Text="Add game" Margin="5,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>
                            <TextBlock Text="YOUR GAMES" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="4,0,4,8"
                                   Text="Star a game to pin it to the top - pinned games survive every restart." />

                        <c:CardPanel DockPanel.Dock="Top" Style="{StaticResource InnerCard}" Margin="0,0,0,10"
                                     Visibility="{Binding AddGamePanelVisibility}">
                            <StackPanel>
                                <TextBlock Text="Place ID, roblox.com/games link or private server link"
                                           Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <c:RippleButton DockPanel.Dock="Right" Content="Add" Style="{StaticResource GhostButton}"
                                                    Margin="8,0,0,0" Command="{Binding AddPlaceCommand}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding NewPlaceInput, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </c:CardPanel>

                        <Grid>
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding PlacesEmptyVisibility}"
                                       Text="No games saved yet.&#x0a;Add one above with its place ID, for example 1818." />
                            <ListBox x:Name="GamesList" ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace}"
                                     ItemContainerStyle="{StaticResource RowItem}" AllowDrop="True"
                                     PreviewMouseLeftButtonDown="GamesList_PreviewMouseLeftButtonDown"
                                     MouseMove="GamesList_MouseMove"
                                     DragOver="GamesList_DragOver"
                                     Drop="GamesList_Drop"
                                     ToolTip="Drag a game up or down to sort it">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="44" Height="44" Margin="6,0,10,0">
                                                <Border Background="{DynamicResource AccentDeepBrush}" CornerRadius="8" />
                                                <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border CornerRadius="8" Background="{Binding IconBrush}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowSub}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:RippleButton Content="{Binding PinGlyph}" Style="{StaticResource PinButton}"
                                                                ToolTip="{Binding PinTip}" PressScale="0.86"
                                                                Command="{Binding DataContext.PinPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                <c:RippleButton x:Name="RemoveGame" Content="✕" Margin="4,0,0,0"
                                                                Style="{StaticResource IconButton}" Opacity="0" VerticalAlignment="Center"
                                                                ToolTip="Remove game" PressScale="0.88"
                                                                Command="{Binding DataContext.RemovePlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <Setter TargetName="RemoveGame" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </c:CardPanel>

                <!-- ===== Was zuletzt lief: jeder Start landet hier, auch ungespeicherte Spiele =====
                     Roblox' eigene Sitzungen kommen beim Start aus den Logdateien dazu. ===== -->
                <c:CardPanel Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                            <c:RippleButton DockPanel.Dock="Right" Content="Clear" Style="{StaticResource PlainButton}"
                                            Command="{Binding ClearRecentsCommand}"
                                            ToolTip="Forget the whole list" />
                            <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="4,0,4,6"
                                   Text="{Binding RecentsLine}" />

                        <Grid>
                            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding RecentsEmptyVisibility}"
                                       Text="Nothing played yet.&#x0a;Start a game and it turns up here." />

                            <ListBox x:Name="RecentsList" ItemsSource="{Binding Recents}"
                                     ItemContainerStyle="{StaticResource RowItem}"
                                     Visibility="{Binding RecentsVisibility}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Dieselbe Zeilenhöhe und dasselbe Bild wie unter "Your games" -
                                             beide Listen sollen wie eine Liste aussehen. -->
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="44" Height="44" Margin="6,0,10,0">
                                                <Border Background="{DynamicResource AccentDeepBrush}" CornerRadius="8" />
                                                <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border CornerRadius="8" Background="{Binding IconBrush}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowSub}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:RippleButton Content="{Binding SaveGlyph}" Style="{StaticResource SaveButton}"
                                                                ToolTip="{Binding SaveTip}" PressScale="0.86"
                                                                Command="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                <c:RippleButton x:Name="ForgetRecent" Content="✕" Margin="4,0,0,0"
                                                                Style="{StaticResource IconButton}" Opacity="0"
                                                                VerticalAlignment="Center" ToolTip="Remove from the list"
                                                                PressScale="0.88"
                                                                Command="{Binding DataContext.ForgetRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <Setter TargetName="ForgetRecent" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </c:CardPanel>
            </Grid>

            <!-- ===== Accounts ===== -->
            <Grid x:Name="PageAccounts" Margin="14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.45*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <c:CardPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <c:RippleButton DockPanel.Dock="Right" Style="{StaticResource PlainButton}"
                                            Command="{Binding RefreshInstallCommand}"
                                            ToolTip="Re-read the installed client, the channel and the game data">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-search.png" Width="13" Height="13"
                                                 Tint="{DynamicResource TextDimBrush}" />
                                    <TextBlock Text="Rescan" Margin="5,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>
                            <TextBlock Text="YOUR GAMES" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="4,0,4,10"
                                   Text="{Binding InstallSummary}" TextTrimming="CharacterEllipsis" />

                        <ListBox ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace}"
                                 ItemContainerStyle="{StaticResource RowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="26" Height="26" Margin="4,0,9,0">
                                            <Border Background="{DynamicResource AccentDeepBrush}" CornerRadius="6" />
                                            <TextBlock Text="🎮" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="6" Background="{Binding IconBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowSub}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </c:CardPanel>

                <c:CardPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <c:RippleButton Style="{StaticResource PlainButton}" Command="{Binding ToggleAddAccountCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconImage Source="pack://application:,,,/Assets/ic-users.png" Width="13" Height="13"
                                                     Tint="{DynamicResource TextDimBrush}" />
                                        <TextBlock Text="Add account" Margin="5,0,0,0" />
                                    </StackPanel>
                                </c:RippleButton>
                                <c:RippleButton Style="{StaticResource PlainButton}" Command="{Binding RefreshAccountsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconImage Source="pack://application:,,,/Assets/ic-search.png" Width="13" Height="13"
                                                     Tint="{DynamicResource TextDimBrush}" />
                                        <TextBlock Text="Refresh" Margin="5,0,0,0" />
                                    </StackPanel>
                                </c:RippleButton>
                            </StackPanel>
                            <TextBlock Text="ROBLOX ACCOUNTS" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <c:CardPanel DockPanel.Dock="Top" Style="{StaticResource InnerCard}" Margin="0,0,0,10"
                                     Visibility="{Binding AddAccountPanelVisibility}">
                            <StackPanel>
                                <c:RippleButton Content="Sign in with Roblox" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left" Click="SignInWithRoblox_Click"
                                                ToolTip="Roblox's own login page in a private, temporary browser - Aether never sees the password" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Text="Roblox's own login page, including 2FA and passkeys. Aether only receives the session key afterwards and never stores a password." />

                                <TextBlock Text="OR PASTE A LAUNCH KEY" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <PasswordBox x:Name="CookieBox" Style="{StaticResource PasswordInput}"
                                             PasswordChanged="CookieBox_PasswordChanged" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Text="Signed in at roblox.com? The .ROBLOSECURITY cookie is under F12 → Application → Cookies. Stored with Windows DPAPI + AES-256-GCM, sent only to roblox.com." />
                                <DockPanel Margin="0,9,0,0">
                                    <c:RippleButton DockPanel.Dock="Right" Content="Add account" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding AddAccountCommand}" />
                                    <TextBlock Text="{Binding AddAccountError}" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                </DockPanel>
                            </StackPanel>
                        </c:CardPanel>

                        <Grid>
                            <!-- Ohne Konten direkt der bequeme Weg: Roblox' eigene Anmeldung. -->
                            <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding AccountsEmptyVisibility}">
                                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center"
                                           Text="No accounts saved yet." />
                                <c:RippleButton Content="Sign in with Roblox" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                                Click="SignInWithRoblox_Click"
                                                ToolTip="Roblox's own login page - the password never reaches Aether" />
                                <TextBlock Style="{StaticResource Note}" TextAlignment="Center" Margin="0,7,0,0"
                                           Text="…or paste a launch key under 'Add key'." />
                            </StackPanel>
                            <ListBox x:Name="AccountsList" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                     ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="38">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Initialen liegen UNTER dem Bild: sie sind der Ersatz,
                                                 wenn noch kein Avatar geladen wurde. -->
                                            <Grid Grid.Column="0" Width="26" Height="26" Margin="4,0,9,0">
                                                <Ellipse Fill="{DynamicResource AccentSoftBrush}" />
                                                <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextHiBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse Fill="{Binding AvatarBrush}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Handle}" Style="{StaticResource RowTitle}"
                                                           FontSize="11" />
                                                <TextBlock x:Name="AccountSub" Text="{Binding Subtitle}"
                                                           Style="{StaticResource RowSub}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:RippleButton Content="Log in" Style="{StaticResource GhostButton}" Padding="10,5"
                                                                Click="AccountLogin_Click"
                                                                ToolTip="Sign in with Roblox and refresh this account" />
                                                <c:RippleButton Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Play the selected game as this account">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:IconImage Source="pack://application:,,,/Assets/ic-play.png"
                                                                     Width="12" Height="12" Tint="{DynamicResource WhiteBrush}" />
                                                        <TextBlock Text="Launch" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </c:RippleButton>
                                                <c:RippleButton Content="✕" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                                ToolTip="Remove account" PressScale="0.88"
                                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                <Setter TargetName="AccountSub" Property="Foreground"
                                                        Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </c:CardPanel>

                <c:CardPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <c:RippleButton DockPanel.Dock="Right" Style="{StaticResource PlainButton}"
                                            Command="{Binding OpenClientFolderCommand}" ToolTip="Open the install folder">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-open.png" Width="13" Height="13"
                                                 Tint="{DynamicResource TextDimBrush}" />
                                    <TextBlock Text="Open folder" Margin="5,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>
                            <TextBlock Text="ROBLOX CLIENT" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel>
                            <TextBlock Text="{Binding ClientVersionLine}" Style="{StaticResource RowTitle}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ClientServesLine}" Style="{StaticResource RowSub}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding VersionChoiceLine}" Style="{StaticResource Note}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ClientVanillaLine}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                            <c:RippleButton Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Command="{Binding ClientActionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-save.png" Width="13" Height="13"
                                                 Tint="{DynamicResource WhiteBrush}" />
                                    <TextBlock Text="{Binding ClientActionText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>
                        </StackPanel>
                    </DockPanel>
                </c:CardPanel>

                <c:CardPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MultiLaunchSummary}"
                                       Style="{StaticResource Note}" VerticalAlignment="Center" />
                            <TextBlock Text="MULTI-START" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                            <c:RippleButton DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Command="{Binding MultiLaunchCommand}" ToolTip="Start the selected game for every account that is switched on">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconImage Source="pack://application:,,,/Assets/ic-play.png" Width="12" Height="12"
                                                 Tint="{DynamicResource TextHiBrush}" />
                                    <TextBlock Text="Launch all" Margin="5,0,0,0" />
                                </StackPanel>
                            </c:RippleButton>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Delay" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource SegmentBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="4s" GroupName="Delay"
                                                     IsChecked="{Binding DelayIs4}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="8s" GroupName="Delay"
                                                     IsChecked="{Binding DelayIs8}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="15s" GroupName="Delay"
                                                     IsChecked="{Binding DelayIs15}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26" Margin="4,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Handle}" FontSize="11"
                                                       Foreground="{DynamicResource TextMidBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Note}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding IsMarked}" VerticalAlignment="Center"
                                                      ToolTip="Include this account in the multi-start" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </c:CardPanel>
            </Grid>

            <!-- ===== Engine (FastFlags) ===== -->
            <Grid x:Name="PageEngine" Margin="14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <c:RippleButton Content="Format" Style="{StaticResource PlainButton}"
                                            Command="{Binding FormatFlagsCommand}" ToolTip="Read and rewrite the JSON tidily" />
                            <c:RippleButton Content="Copy" Style="{StaticResource PlainButton}"
                                            Command="{Binding CopyFlagsCommand}" ToolTip="Copy the JSON to the clipboard" />
                            <c:RippleButton Content="Import…" Style="{StaticResource PlainButton}"
                                            Command="{Binding ImportFlagsCommand}" ToolTip="Load a ClientAppSettings.json into the editor" />
                            <c:RippleButton Content="Export…" Style="{StaticResource PlainButton}"
                                            Command="{Binding ExportFlagsCommand}" ToolTip="Write the editor content to a file" />
                            <c:RippleButton Content="Clear" Style="{StaticResource PlainButton}"
                                            Command="{Binding ClearFlagsCommand}" ToolTip="Empty the editor" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FASTFLAGS JSON" Style="{StaticResource SectionHeader}" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FlagsCountLabel}" Style="{StaticResource BadgeText}"
                                           FontFamily="{StaticResource MonoFont}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <TextBox Grid.Row="1" Style="{StaticResource CodeBox}"
                             Text="{Binding FastFlagsJson, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="2" Margin="4,8,4,0" FontSize="10" TextWrapping="Wrap"
                               Text="{Binding FlagsStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlagsHasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <c:CardPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                            <TextBlock Text="PRESETS" Style="{StaticResource SectionHeader}" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                       Text="Ticking a preset writes its flags into the JSON straight away - unticking removes them again. Nothing to press afterwards." />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,8,0,0"
                                     Text="{Binding PresetSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by name, description or flag name" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Text="{Binding PresetCountLine}" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap"
                                       Text="Click a group name to fold it away - so the list stays short." />
                        </StackPanel>
                        <!-- Die Schnellansicht lässt sich hier ein- und ausschalten (ab Werk an). -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Quick layout" FontSize="11" Foreground="{DynamicResource TextMidBrush}" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{Binding LayoutShortcutHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:RippleButton Content="Open" Style="{StaticResource PlainButton}" Margin="0,0,8,0"
                                                    Command="{Binding OpenLayoutCommand}"
                                                    ToolTip="Show the quick layout over the app" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OverlayEnabled}"
                                              VerticalAlignment="Center" ToolTip="Switch the quick layout on or off" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="4,10,4,0"
                                       Visibility="{Binding PresetEmptyVisibility}"
                                       Text="Nothing matches that filter." />

                            <ItemsControl ItemsSource="{Binding PresetGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <!-- Der Gruppenkopf klappt die Gruppe auf und zu und zeigt,
                                                 wie viele Vorschläge darin stehen. -->
                                            <c:RippleButton Style="{StaticResource GroupHeader}"
                                                            Command="{Binding ToggleCommand}"
                                                            ToolTip="Show or hide this group">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}"
                                                               FontSize="10" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource TextFaintBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}"
                                                               Style="{StaticResource Note}"
                                                               Foreground="{DynamicResource TextFaintBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GroupLabel}"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </c:RippleButton>
                                            <ItemsControl ItemsSource="{Binding Items}"
                                                          Visibility="{Binding ItemsVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,0,4,9">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Right" Style="{StaticResource HonorBadge}"
                                                                            Margin="6,0,0,0" ToolTip="{Binding HonorTip}">
                                                                        <TextBlock Text="{Binding HonorText}" Style="{StaticResource HonorText}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                                               Foreground="{DynamicResource TextMidBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Note}"
                                                                           Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding Keys}" Style="{StaticResource Note}"
                                                                           Foreground="{DynamicResource TextFaintBrush}"
                                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                                                      IsChecked="{Binding IsMarked}" VerticalAlignment="Center"
                                                                      Margin="8,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </c:CardPanel>

                <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,12,4,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <c:RippleButton Content="Save" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveFastFlagsCommand}" />
                        <c:RippleButton Content="Write to the client now" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding ApplyFastFlagsCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="Presets are saved as they are ticked. Roblox only honours flags on its allowlist (since September 2025); anything else is ignored. An existing ClientAppSettings.json is backed up once as .aetherbak - and in vanilla mode nothing is written at all." />
                </DockPanel>
            </Grid>

            <!-- ===== Settings ===== -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Margin="14" Visibility="Collapsed"
                          c:SmoothScroll.Enabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <c:CardPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="AETHER" Style="{StaticResource SectionHeader}" Margin="4,0,0,10" />

                            <!-- Farbwelten: ein Klick färbt die ganze Oberfläche um, ohne Neustart. -->
                            <TextBlock Text="THEME" Style="{StaticResource GroupLabel}" Margin="4,0,0,6" />
                            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                     Background="Transparent" BorderThickness="0" Padding="0" Margin="4,0,0,6"
                                     ItemContainerStyle="{StaticResource ThemeTile}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="15" Height="15" CornerRadius="4"
                                                    Background="{Binding Surface}" BorderBrush="{Binding Swatch}"
                                                    BorderThickness="1" VerticalAlignment="Center">
                                                <Border Width="5" Height="5" CornerRadius="1" Margin="3,0,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{Binding Swatch}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,2,4,12" />

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Vanilla mode" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="Starts the client exactly as Roblox installed it: no flags, no textures, no extra process. Velocity, Madium, Volt and similar tools then find the normal branch they expect." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding VanillaMode}" VerticalAlignment="Top" />
                            </Grid>

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Multiple Roblox instances" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="Holds the Roblox singleton while clients run, so a second client is allowed. Off in vanilla mode." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Settings.MultiInstance}" VerticalAlignment="Top" />
                            </Grid>

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Apply FastFlags on launch" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="Writes the flags into the ClientSettings folder of the client before every start." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding ApplyFastFlagsOnLaunch}" VerticalAlignment="Top" />
                            </Grid>

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start with the current Roblox login" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="Ignores the account list and uses whatever session Roblox already has." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Settings.UseCurrentLogin}" VerticalAlignment="Top" />
                            </Grid>

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Playful mode" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="Springy page entrances, a shine that runs over the hero card and a livelier press feedback." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding PlayfulMode}" VerticalAlignment="Top" />
                            </Grid>

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Aether pointer" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="The arrow from tools/make-cursor.ps1 replaces the Windows pointer inside this window." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding CustomCursor}" VerticalAlignment="Top" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,0,4,10" />

                            <!-- Das Kürzel der Schnellansicht: hier umbelegen und zurücksetzen. -->
                            <Grid Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Quick layout shortcut" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{Binding LayoutShortcutHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LayoutShortcutLabel}" Style="{StaticResource BadgeText}"
                                                   FontFamily="{StaticResource MonoFont}" />
                                    </Border>
                                    <c:RippleButton x:Name="ChangeShortcutButton" Content="Change" Style="{StaticResource ToolButton}"
                                                    Command="{Binding ChangeShortcutCommand}"
                                                    ToolTip="Press the new keys right after clicking" />
                                    <c:RippleButton Content="Reset" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                                    Command="{Binding ResetShortcutCommand}"
                                                    ToolTip="Back to Delete (Entf)" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,10,4,10" />

                            <!-- Das Ingame-Overlay: eigenes Fenster über dem Roblox-Client. -->
                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="In-game overlay (over Roblox)" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Small panels over the game - frame rate, graphics, notes, server and anti-AFK. Each one is dragged anywhere and remembers its own place. Nothing is injected into Roblox - it draws over it and writes FastFlags." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <c:RippleButton Content="Start now" Style="{StaticResource PlainButton}"
                                                    Margin="0,0,8,0" Command="{Binding StartGameOverlayCommand}"
                                                    ToolTip="Start the overlay host without launching a game" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameOverlayEnabled}"
                                              VerticalAlignment="Top" ToolTip="Start the overlay with every launch" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Open the overlay when Roblox starts" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Off by default - the menu stays closed until you press the shortcut. On: it opens by itself when Roblox is in front." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding GameOverlayAutoShow}" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                    </c:CardPanel>

                    <c:CardPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PROTOCOL HANDLER" Style="{StaticResource SectionHeader}" Margin="4,0,0,10" />
                            <TextBlock Style="{StaticResource Note}" Margin="4,0,4,12"
                                       Text="Hand the roblox-player protocol to Aether and Play clicks on the website run through this launcher. The current handler is saved and can be restored at any time." />
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                <c:RippleButton Content="Take over" Style="{StaticResource GhostButton}"
                                                Command="{Binding RegisterProtocolCommand}" />
                                <c:RippleButton Content="Restore previous" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Command="{Binding RestoreProtocolCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </c:CardPanel>

                    <c:CardPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="UI FONT" Style="{StaticResource SectionHeader}" Margin="4,0,0,10" />
                                <TextBlock Text="The quick brown fox jumps over the lazy dog · 0123456789"
                                           FontSize="12.5" Foreground="{DynamicResource TextMidBrush}"
                                           Margin="4,0,4,8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                                    <c:RippleButton Content="Load font file…" Style="{StaticResource ToolButton}"
                                                    Command="{Binding LoadFontFileCommand}" />
                                    <c:RippleButton Content="Open font folder" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                                    Command="{Binding OpenFontFolderCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="4,8,4,0"
                                           Text="Own files are copied into the data folder and registered for this process only - the system font list stays untouched." />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFont}"
                                     Height="126" ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontFamily="{Binding Preview}"
                                                       FontSize="11.5" Foreground="{DynamicResource TextMidBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Note}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="{Binding DetailVisibility}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </c:CardPanel>

                    <c:CardPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="IN-GAME CURSOR" Style="{StaticResource SectionHeader}" Margin="4,0,0,10" />

                            <Grid Margin="4,0,4,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Replace the pointer in the game" FontSize="11" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,12,0"
                                               Text="Rewrites the visible pointer textures of the installed client before every launch. Every file keeps its original pixel size, and the originals stay as .aetherbak." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                          IsChecked="{Binding CursorEnabled}" VerticalAlignment="Top" />
                            </Grid>

                            <c:CardPanel Style="{StaticResource InnerCard}" Margin="4,0,4,10">
                                <StackPanel>
                                    <TextBlock Text="Pointer image (PNG)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CursorImageLine}" Style="{StaticResource RowSub}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <c:RippleButton Content="Choose PNG…" Style="{StaticResource ToolButton}"
                                                        Command="{Binding ChooseCursorImageCommand}" />
                                        <c:RippleButton Content="Use bundled" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                                        Command="{Binding UseBundledCursorCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </c:CardPanel>

                            <TextBlock Text="{Binding CursorSummary}" Style="{StaticResource Note}" Margin="4,0,4,10" />

                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                <c:RippleButton Content="Apply now" Style="{StaticResource GhostButton}"
                                                Command="{Binding ApplyCursorCommand}" />
                                <c:RippleButton Content="Restore original" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                Command="{Binding RestoreCursorCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </c:CardPanel>

                    <c:CardPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="12"
                                 Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ROBLOX CLIENT" Style="{StaticResource SectionHeader}" Margin="4,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4,0,10,0">
                                    <TextBlock Text="Install folder (empty = %LOCALAPPDATA%\Roblox)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding Settings.RobloxRoot, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Deployment channel" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding Settings.Channel, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,4,0">
                                    <c:RippleButton Content="Rescan client" Style="{StaticResource ToolButton}"
                                                    Command="{Binding RefreshInstallCommand}" />
                                    <c:RippleButton Content="Roblox Studio" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                                    Command="{Binding DownloadStudioCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ClientServesLine}" Style="{StaticResource Note}" Margin="4,10,4,0" />

                            <TextBlock Text="STARTING VERSION" Style="{StaticResource FieldLabel}"
                                       Margin="4,14,0,6" />
                            <TextBlock Style="{StaticResource Note}" Margin="4,0,4,8"
                                       Text="Pin the exact client that other programs expect, or leave it on automatic so the newest installed version starts." />
                            <ListBox ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}"
                                     ItemContainerStyle="{StaticResource RowItem}" MaxHeight="170">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Visibility="{Binding PinnedVisibility}">
                                                <TextBlock Text="IN USE" Style="{StaticResource BadgeText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </c:CardPanel>

                    <c:CardPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="12"
                                 Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="4,0,4,10">
                                <c:RippleButton DockPanel.Dock="Right" Content="Load list" Style="{StaticResource ToolButton}"
                                                Command="{Binding LoadBuildsCommand}"
                                                ToolTip="Ask WEAO and Roblox for the version list" />
                                <TextBlock Text="DOWNLOAD A VERSION" Style="{StaticResource SectionHeader}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource Note}" Margin="4,0,4,10"
                                       Text="The list comes from WEAO (docs.weao.xyz - it tracks the current, next and previous Windows builds) and from Roblox's own deploy history. Downloaded is always the official installer from setup.rbxcdn.com, never a third-party copy. When the installer is done, press Rescan client above and pin the version there." />

                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                         Text="{Binding BuildSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter by version, number or source" />
                                <c:RippleButton Grid.Column="1" Content="Download installer" Margin="8,0,0,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DownloadBuildCommand}"
                                                CommandParameter="{Binding SelectedBuild}"
                                                ToolTip="Download the official installer of the selected build" />
                                <c:RippleButton Grid.Column="2" Content="Install now" Margin="8,0,0,0"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding InstallBuildCommand}"
                                                ToolTip="Run the downloaded installer" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}"
                                     ItemContainerStyle="{StaticResource RowItem}" MaxHeight="190" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" FontSize="11" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Visibility="{Binding InstalledVisibility}">
                                                <TextBlock Text="INSTALLED" Style="{StaticResource BadgeText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding BuildsSummary}" Style="{StaticResource Note}" Margin="4,0,4,4" />
                            <DockPanel Margin="4,0,4,0">
                                <c:RippleButton DockPanel.Dock="Right" Content="Open download folder" Style="{StaticResource PlainButton}"
                                                Command="{Binding OpenDownloadFolderCommand}" />
                                <TextBlock Text="{Binding InstallerLine}" Style="{StaticResource Note}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </c:CardPanel>

                    <c:CardPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="DATA" Style="{StaticResource SectionHeader}" Margin="4,0,0,10" />
                            <TextBlock Style="{StaticResource Note}" Margin="4,0,4,10"
                                       Text="{Binding DataFolderLine}" />
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                <c:RippleButton Content="Open data folder" Style="{StaticResource ToolButton}"
                                                Command="{Binding OpenConfigFolderCommand}" />
                                <c:RippleButton Content="Open log file" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                                Command="{Binding OpenLogFileCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </c:CardPanel>
                </Grid>
            </ScrollViewer>

            <!-- ===== Log ===== -->
            <Grid x:Name="PageLog" Margin="14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <c:RippleButton Content="Clear" Style="{StaticResource ToolButton}" Command="{Binding ClearLogCommand}" />
                        <c:RippleButton Content="Open log file" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                                        Command="{Binding OpenLogFileCommand}" />
                    </StackPanel>
                    <TextBlock Text="LOG" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource CodeBox}" IsReadOnly="True"
                         FontSize="11" Text="{Binding LogText, Mode=OneWay}"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
            <!-- ===== Schnellansicht: ab Werk Entf (Kürzel umbelegbar) ===== -->
            <Grid x:Name="LayoutOverlay" Background="#CC05070C" Opacity="0" Visibility="Collapsed"
                  MouseLeftButtonDown="LayoutOverlay_Click">

                <c:CardPanel x:Name="LayoutCard" Width="560" MaxHeight="540" Opacity="0"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Style="{StaticResource Card}" Padding="16"
                             MouseLeftButtonDown="LayoutCard_Click">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,12">
                            <c:RippleButton DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                                            Command="{Binding CloseLayoutCommand}" ToolTip="Close (Esc)"
                                            PressScale="0.88" VerticalAlignment="Top" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="QUICK LAYOUT" Style="{StaticResource SectionHeader}" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Launches, switches and notes - without leaving the page you are on." />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="2,12,2,0">
                            <c:RippleButton DockPanel.Dock="Right" Content="Change shortcut"
                                            Style="{StaticResource PlainButton}"
                                            Command="{Binding ChangeShortcutCommand}" />
                            <TextBlock Text="{Binding LayoutShortcutHint}" Style="{StaticResource Note}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2,0,2,12">
                                    <c:RippleButton Style="{StaticResource PrimaryButton}" MinWidth="130" Padding="16,9"
                                                    Command="{Binding LaunchCommand}"
                                                    ToolTip="Start the selected game (Ctrl+Enter)">
                                        <StackPanel Orientation="Horizontal">
                                            <c:IconImage Source="pack://application:,,,/Assets/ic-play.png" Width="13" Height="13"
                                                         Tint="{DynamicResource WhiteBrush}" />
                                            <TextBlock Text="{Binding PlayLabel}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </c:RippleButton>
                                    <c:RippleButton Style="{StaticResource GhostButton}" Padding="14,9" Margin="8,0,0,0"
                                                    Command="{Binding LaunchAppCommand}"
                                                    ToolTip="Open the Roblox app itself">
                                        <StackPanel Orientation="Horizontal">
                                            <c:IconImage Source="pack://application:,,,/Assets/ic-home.png" Width="13" Height="13"
                                                         Tint="{DynamicResource TextHiBrush}" />
                                            <TextBlock Text="Roblox app" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </c:RippleButton>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,0,2,12" />

                                <!-- Schalter, die man sonst erst in den Einstellungen findet. -->
                                <Grid Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Vanilla mode" FontSize="11" Foreground="{DynamicResource TextMidBrush}" />
                                        <TextBlock Style="{StaticResource Note}" Margin="0,1,0,0"
                                                   Text="Nothing is written into the client." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                              IsChecked="{Binding VanillaMode}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Apply FastFlags on launch" FontSize="11" Foreground="{DynamicResource TextMidBrush}" />
                                        <TextBlock Style="{StaticResource Note}" Margin="0,1,0,0"
                                                   Text="Write the flags into the client before every start." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                              IsChecked="{Binding ApplyFastFlagsOnLaunch}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="2,0,2,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="In-game pointer" FontSize="11" Foreground="{DynamicResource TextMidBrush}" />
                                        <TextBlock Style="{StaticResource Note}" Margin="0,1,0,0"
                                                   Text="{Binding CursorImageLine}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                              IsChecked="{Binding CursorEnabled}" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,0,2,12" />

                                <TextBlock Text="LAUNCH AS" Style="{StaticResource SectionHeader}" Margin="2,0,0,6" />
                                <TextBlock Text="{Binding LayoutAccountLine}" Style="{StaticResource Note}"
                                           Margin="2,0,2,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Accounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30" Margin="2,0,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Handle}" FontSize="11"
                                                           Foreground="{DynamicResource TextMidBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <c:RippleButton Grid.Column="1" Content="Launch" Style="{StaticResource PlainButton}"
                                                                Command="{Binding DataContext.QuickLaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Start as this account" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="2,12,2,12" />

                                <TextBlock Text="NOTES" Style="{StaticResource SectionHeader}" Margin="2,0,0,6" />
                                <TextBox Style="{StaticResource CodeBox}" Height="86" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Saved automatically into notes.txt" />
                                <DockPanel Margin="2,6,2,0">
                                    <c:RippleButton DockPanel.Dock="Right" Content="Save now" Style="{StaticResource PlainButton}"
                                                    Command="{Binding SaveNotesCommand}" />
                                    <TextBlock Text="{Binding NotesLine}" Style="{StaticResource Note}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </c:CardPanel>
            </Grid>
        </Grid>

        <!-- ===================== Fußzeile ===================== -->
        <Border Grid.Row="2" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel>
                <c:RippleButton DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Margin="10,0,4,0"
                                VerticalAlignment="Center" Command="{Binding OpenLayoutCommand}"
                                ToolTip="Quick layout - launches, switches and notes">
                    <StackPanel Orientation="Horizontal">
                        <c:IconImage Source="pack://application:,,,/Assets/ic-script.png" Width="12" Height="12"
                                     Tint="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="Layout" Margin="5,0,0,0" />
                    </StackPanel>
                </c:RippleButton>

                <c:RippleButton DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Margin="10,0,4,0"
                                VerticalAlignment="Center" Command="{Binding RestartCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconImage Source="pack://application:,,,/Assets/ic-open.png" Width="12" Height="12"
                                     Tint="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="Restart Aether" Margin="5,0,0,0" />
                    </StackPanel>
                </c:RippleButton>

                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLine}" Style="{StaticResource VersionText}"
                           VerticalAlignment="Center" Margin="6,0,8,0" />

                <!-- Value bindet standardmäßig in beide Richtungen; der Fortschritt ist aber
                     nur lesbar, also ausdrücklich OneWay. -->
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="5" Minimum="0" Maximum="100"
                             Value="{Binding DownloadPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,0,0"
                             Visibility="{Binding DownloadingVisibility}" />

                <ProgressBar DockPanel.Dock="Right" Width="90" Height="5" IsIndeterminate="True"
                             VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding BusyVisibility}" />

                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="{Binding Status}"
                           Style="{StaticResource Note}" Foreground="{DynamicResource TextMidBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="360" />

                <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Note}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
