<UserControl x:Class="AetherLauncher.Overlay.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}">
    <StackPanel>
        <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap"
                   Text="The same notes file as the launcher's quick layout - it saves a moment after you stop typing." />
        <TextBox x:Name="NotesBox" Style="{StaticResource InputBox}" Height="140" Margin="0,8,0,0"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" TextChanged="NotesBox_TextChanged" />
        <TextBlock x:Name="NotesLine" Style="{StaticResource Note}" Margin="0,6,0,0"
                   Foreground="{DynamicResource TextFaintBrush}" Text="Saved automatically." />
    </StackPanel>
</UserControl>
