                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
