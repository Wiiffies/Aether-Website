<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AetherLauncher</AssemblyName>
    <RootNamespace>AetherLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>Aether Launcher</Product>
    <Description>Source-available Roblox launcher with account management, multiple instances, and a FastFlags editor.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <ApplicationIcon>Assets\aether.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release without symbols: no PDB with class names and line numbers in the download. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons and logo from the Aether Hub project (Lucide, ISC/MIT; see Assets/ICONS-LICENSE.txt) -->
    <Resource Include="Assets\*.png" />
    <!-- Application cursor generated by tools/make-cursor.ps1 -->
    <Resource Include="Assets\*.cur" />
    <None Include="Assets\ICONS-LICENSE.txt" />
  </ItemGroup>

  <!-- The WPF SDK's implicit-using set is smaller than the base SDK's. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Text" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
