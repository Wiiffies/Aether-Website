			LayoutOrder = i, ClipsDescendants = true, Parent = row,
		})
		round(bar, 6)
		paint(win, bar, "BackgroundColor3", "Row")
		Motion.Shimmer(bar, win, { Period = 1.6, Strength = 0.8, Width = 80 })
		bars[i] = bar
	end
	local api: any = { Instance = row }
	function api:Stop()
		for _, b in ipairs(bars) do
			Motion.Tween(b, 0.2, { BackgroundTransparency = 1 })
		end
		later(0.24, row, function() row.Visible = false end)
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Overlapping avatar stack
-- ---------------------------------------------------------------------
function Card:AddAvatarStack(opts: any)
	opts = opts or {}
	local win = self.Window
	local items = opts.Items or {}
	local size = opts.Size or 28
	local overlap = opts.Overlap or 10
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size + 4),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local api: any = { Instance = row, Avatars = {} }
	for i, it in ipairs(items) do
		local av = new("Frame", {
			BackgroundColor3 = win.Theme.Row, BorderSizePixel = 0,
			Position = UDim2.fromOffset((i - 1) * (size - overlap), 2),
			Size = UDim2.fromOffset(size, size), ZIndex = i, Parent = row,
		})
		pill(av)
		outline(av, win.Theme.Card, 2, 0)
		paint(win, av, "BackgroundColor3", "Row")
		if type(it) == "table" and it.Image then
			local img = new("ImageLabel", {
				BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
				Image = it.Image, ZIndex = i, Parent = av,
			})
			pill(img)
		else
			local label = type(it) == "table" and (it.Initial or "?") or tostring(it):sub(1, 1)
			new("TextLabel", {
				BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
				Font = Enum.Font.GothamBold, TextSize = math.floor(size * 0.4),
				TextColor3 = win.Theme.Sub, Text = string.upper(label), ZIndex = i + 1, Parent = av,
			})
		end
		local sc = scaler(av, 1)
		av.MouseEnter:Connect(function()
			av.ZIndex = 50
			Motion.Spring(sc, "Scale", 1.18, "Groovy", win):To(1.18)
			if type(it) == "table" and it.Name then win:Tooltip(av, it.Name) end
		end)
		av.MouseLeave:Connect(function()
			av.ZIndex = i
			Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
			win:HideTooltip()
		end)
		api.Avatars[i] = av
		later(math.min(i * 0.05, 0.4), av, function() Motion.Pop(sc, win, { From = 0.4, Overshoot = 1.15 }) end)
	end
	if opts.Extra then
		new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(#items * (size - overlap) + 8, 2),
			Size = UDim2.fromOffset(80, size), Font = Enum.Font.Gotham, TextSize = 11,
			TextColor3 = win.Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left,
			Text = opts.Extra, Parent = row,
		})
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Table with sortable headers and zebra rows
-- ---------------------------------------------------------------------
function Card:AddTable(opts: any)
	opts = opts or {}
	local win = self.Window
	local columns = opts.Columns or { "Name", "Value" }
	local rowsData = opts.Rows or {}
	local rowH = opts.RowHeight or 26
	local maxVisible = opts.MaxVisible or 8
	local row = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26 + math.min(#rowsData, maxVisible) * rowH + 8),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local head = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), Parent = row,
	})
	hlist(head, 0, Enum.VerticalAlignment.Center)
	local body = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26),
		ScrollBarThickness = 3, ScrollBarImageColor3 = win.Theme.Stroke2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Parent = row,
	})
	vlist(body, 2)
	local api: any = { Instance = row }
	local sortCol, sortAsc = nil, true
	local function colWidth(i: any)
		local w = opts.Widths and opts.Widths[i]
		if w then return UDim2.new(w, 0, 1, 0) end
		return UDim2.new(1 / #columns, 0, 1, 0)
	end
	for i, c in ipairs(columns) do
		local hb = new("TextButton", {
			BackgroundTransparency = 1, Size = colWidth(i), Text = "",
			AutoButtonColor = false, LayoutOrder = i, Parent = head,
		})
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0),
			Size = UDim2.new(1, -16, 1, 0), Font = Enum.Font.GothamBold, TextSize = 10,
			TextColor3 = win.Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left,
			Text = string.upper(tostring(c)), Parent = hb,
		})
		paint(win, lbl, "TextColor3", "Dim")
		local sc = scaler(lbl, 1)
		hb.MouseEnter:Connect(function()
			Motion.Spring(lbl, "TextColor3", win.Theme.Text, "Snappy", win):To(win.Theme.Text)
		end)
		hb.MouseLeave:Connect(function()
			Motion.Spring(lbl, "TextColor3", sortCol == i and win.Theme.Sub or win.Theme.Dim, "Snappy", win)
				:To(sortCol == i and win.Theme.Sub or win.Theme.Dim)
		end)
		hb.Activated:Connect(function()
			if sortCol == i then sortAsc = not sortAsc else sortCol, sortAsc = i, true end
			Motion.Pop(sc, win, { From = 0.9 })
			table.sort(rowsData, function(a, b)
				local x, y = a[i], b[i]
				if type(x) == "number" and type(y) == "number" then
					if sortAsc then return x < y else return x > y end
				end
				if sortAsc then return tostring(x) < tostring(y) else return tostring(x) > tostring(y) end
			end)
			api:_build()
		end)
	end
	function api:_build()
		for _, c in ipairs(body:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		for r, data in ipairs(rowsData) do
			local line = new("Frame", {
				BackgroundColor3 = win.Theme.Inset, BackgroundTransparency = (r % 2 == 0) and 0 or 1,
				BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, rowH), LayoutOrder = r, Parent = body,
			})
			round(line, 5)
			paint(win, line, "BackgroundColor3", "Inset")
			-- The cells get their own list host. A UIListLayout lays out EVERY
			-- GuiObject child, so a full-row hit button must NOT live in here.
			local cells = new("Frame", {
				BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = line,
			})
			hlist(cells, 0, Enum.VerticalAlignment.Center)
			for i = 1, #columns do
				new("TextLabel", {
					BackgroundTransparency = 1, Size = colWidth(i),
					Font = (opts.MonoColumn == i) and Enum.Font.Code or Enum.Font.Gotham,
					TextSize = 11, TextColor3 = i == 1 and win.Theme.Text or win.Theme.Sub,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
					Text = "  " .. tostring(data[i] ~= nil and data[i] or ""), LayoutOrder = i, Parent = cells,
				})
			end
			local sc = scaler(line, 1)
			line.MouseEnter:Connect(function()
				Motion.Spring(line, "BackgroundTransparency", 0, "Snappy", win):To(0)
				Motion.Spring(line, "BackgroundColor3", win.Theme.Row, "Snappy", win):To(win.Theme.Row)
				Motion.Spring(sc, "Scale", 1.006, "Bouncy", win):To(1.006)
			end)
			line.MouseLeave:Connect(function()
				Motion.Spring(line, "BackgroundTransparency", (r % 2 == 0) and 0 or 1, "Snappy", win):To((r % 2 == 0) and 0 or 1)
				Motion.Spring(line, "BackgroundColor3", win.Theme.Inset, "Snappy", win):To(win.Theme.Inset)
				Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
			end)
			if opts.OnRowClick then
				local hit = new("TextButton", {
					BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
					AutoButtonColor = false, Parent = line,
				})
				hit.Activated:Connect(function() task.spawn(function() pcall(opts.OnRowClick, data, r) end) end)
			end
		end
		row.Size = UDim2.new(1, 0, 0, 26 + math.min(#rowsData, maxVisible) * (rowH + 2) + 8)
	end
	function api:GetRows() return rowsData end
	function api:SetRows(d: any) rowsData = d or {}; api:_build() end
	api.Set = api.SetRows
	api:_build()
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Pagination
-- ---------------------------------------------------------------------
function Card:AddPagination(opts: any)
	opts = opts or {}
	local win = self.Window
	local pages = math.max(1, opts.Pages or 1)
	local current = math.clamp(opts.Default or 1, 1, pages)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local holder = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(math.min(pages, 9) * 30 + 60, 26), Parent = row,
	})
	local l = hlist(holder, 4, Enum.VerticalAlignment.Center)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local api: any = { Instance = row }
	local buttons = {}
	local function repaint()
		for i, b in ipairs(buttons) do
			local on = i == current
			Motion.Spring(b.frame, "BackgroundColor3", on and win.Theme.SegSel or win.Theme.Row, "Snappy", win)
				:To(on and win.Theme.SegSel or win.Theme.Row)
			Motion.Spring(b.label, "TextColor3", on and win.Theme.Text or win.Theme.Sub, "Snappy", win)
				:To(on and win.Theme.Text or win.Theme.Sub)
		end
	end
	actionButton(win, holder, { Text = "", Icon = "chevron", Width = 24, Height = 24, Pad = 5, Order = 0,
		Callback = function() api:Set(current - 1, true) end })
	for i = 1, math.min(pages, 9) do
		local b = new("TextButton", {
			BackgroundColor3 = win.Theme.Row, BorderSizePixel = 0, Size = UDim2.fromOffset(26, 24),
			Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = holder,
		})
		round(b, 6)
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = win.Theme.Sub,
			Text = tostring(i), Parent = b,
		})
		buttons[i] = { frame = b, label = lbl }
		local sc = scaler(b, 1)
		b.MouseEnter:Connect(function() Motion.Spring(sc, "Scale", 1.1, "Bouncy", win):To(1.1) end)
		b.MouseLeave:Connect(function() Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1) end)
		b.Activated:Connect(function() api:Set(i, true) end)
	end
	actionButton(win, holder, { Text = "", Icon = "chevron", Width = 24, Height = 24, Pad = 5, Order = 99,
		Callback = function() api:Set(current + 1, true) end })
	function api:Get() return current end
	function api:Set(v: any, fire: any)
		local nv = math.clamp(math.floor(tonumber(v) or 1), 1, pages)
		local changed = nv ~= current
		current = nv
		repaint()
		if buttons[current] then
			local sc = scaler(buttons[current].frame, 1)
			Motion.Pop(sc, win, { From = 0.85, Overshoot = 1.12 })
		end
		if changed and fire and opts.Callback then task.spawn(function() pcall(opts.Callback, current) end) end
	end
	repaint()
	self.Elements[#self.Elements + 1] = api
	return api
end

