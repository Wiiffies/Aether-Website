		for i = 1, 3 do
			local d = new("Frame", {
				BackgroundColor3 = self.Theme.Accent, BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(80 + (i - 1) * 20, 22),
				Size = UDim2.fromOffset(10, 10), ZIndex = 39, Parent = holder,
			})
			pill(d)
			paint(self, d, "BackgroundColor3", "Accent")
			dots[i] = d
		end
		Motion.Wave(dots, self, { Amplitude = 6, Speed = 5, Phase = 0.7 })
		new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 42),
			Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.Gotham, TextSize = 12,
			TextColor3 = self.Theme.Sub, Text = text or "Working...", ZIndex = 39, Parent = holder,
		})
		Motion.Spring(shade, "GroupTransparency", 0, "UI", self):To(0)
		self._busy = shade
	elseif self._busy then
		local shade = self._busy
		self._busy = nil
		Motion.Spring(shade, "GroupTransparency", 1, "Snappy", self):To(1)
		later(0.2, shade, function() shade:Destroy() end)
	end
end

