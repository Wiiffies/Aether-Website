-- ---------------------------------------------------------------------
-- Badge / tag row
-- ---------------------------------------------------------------------
function Card:AddBadges(opts: any)
	opts = opts or {}
	local win = self.Window
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Height or 24),
