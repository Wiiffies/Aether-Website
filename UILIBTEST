-- ---------------------------------------------------------------------
function Window:AddCommand(opts: any)
	self._commands = self._commands or {}
	self._commands[#self._commands + 1] = opts
	return opts
end

function Window:ShowCommandPalette()
	if self._palette then return end
	local card, close, box = self:_modal(460, 330)
	self._palette = box
	local function reallyClose()
		self._palette = nil
		close()
	end
	card:SetHeader({ Title = "Commands" })
	local list = card:AddList({ Height = 232 })
	local search = card:AddSearchBox({ Placeholder = "Type to filter..." })
	search.Instance.LayoutOrder = -900
	local function render(filter: any)
		for _, c in ipairs(list.Body:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		filter = string.lower(filter or "")
		local n = 0
		for _, cmd in ipairs(self._commands or {}) do
			if filter == "" or string.find(string.lower(cmd.Name or ""), filter, 1, true) then
				n += 1
				local b = new("TextButton", {
					BackgroundColor3 = self.Theme.Row, BackgroundTransparency = 1, BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 30), Text = "", AutoButtonColor = false, LayoutOrder = n, Parent = list.Body,
				})
				round(b, 6)
				local ix = 12
				if cmd.Icon then
					local ic = drawIcon(b, cmd.Icon, 13, self.Theme.Sub, self)
					ic.Frame.Position = UDim2.fromOffset(10, 8.5)
					ix = 30
				end
				new("TextLabel", {
					BackgroundTransparency = 1, Position = UDim2.fromOffset(ix, 0),
					Size = UDim2.new(1, -ix - 12, 1, 0), Font = Enum.Font.Gotham, TextSize = 12,
					TextColor3 = self.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
					Text = cmd.Name or "", Parent = b,
				})
				local sc = scaler(b, 1)
				b.MouseEnter:Connect(function()
					Motion.Spring(b, "BackgroundTransparency", 0, "Snappy", self):To(0)
					Motion.Spring(sc, "Scale", 1.01, "Bouncy", self):To(1.01)
				end)
				b.MouseLeave:Connect(function()
					Motion.Spring(b, "BackgroundTransparency", 1, "Snappy", self):To(1)
					Motion.Spring(sc, "Scale", 1, "Bouncy", self):To(1)
				end)
				b.Activated:Connect(function()
					reallyClose()
					if cmd.Callback then task.spawn(function() pcall(cmd.Callback) end) end
				end)
			end
		end
		if n == 0 then
			list:AddEmptyState({ Icon = "search", Title = "No matches", Text = "Try a different word.", Height = 120 })
		end
		Motion.Reveal(list.Body, self, { Step = 0.015, Distance = 8, Cap = 0.2 })
	end
	search:SetText("")
	render("")
	search.Box:GetPropertyChangedSignal("Text"):Connect(function() render(search:Get()) end)
	self._paletteClose = reallyClose
	return reallyClose
end

-- ---------------------------------------------------------------------
-- Status pill in the title bar
-- ---------------------------------------------------------------------
function Window:AddStatusPill(opts: any)
	opts = opts or {}
	local win = self
	local pillFrame = new("Frame", {
		BackgroundColor3 = self.Theme.NavSel, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, opts.Offset or -112, 0.5, 0),
		Size = UDim2.fromOffset(opts.Width or 84, 22), Parent = self.Top,
	})
	pill(pillFrame)
	paint(self, pillFrame, "BackgroundColor3", "NavSel")
	local dot = new("Frame", {
		BackgroundColor3 = self.Theme[opts.Token or "Good"], BorderSizePixel = 0,
		Position = UDim2.fromOffset(9, 8), Size = UDim2.fromOffset(6, 6), Parent = pillFrame,
	})
	pill(dot)
	paint(self, dot, "BackgroundColor3", opts.Token or "Good")
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(21, 0),
		Size = UDim2.new(1, -28, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 10,
		TextColor3 = self.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
		Text = opts.Text or "Ready", Parent = pillFrame,
	})
	paint(self, lbl, "TextColor3", "Sub")
	local pulse
	if opts.Pulse ~= false then
		local ds = scaler(dot, 1)
		pulse = Motion.Breathe(ds, self, { Amplitude = 0.22, Speed = 2.4 })
	end
	local api: any = { Instance = pillFrame }
	-- The pulse is a permanent loop, so it MUST be stopped on destroy or the
	-- ticker keeps running forever against a dead instance.
	function api:Destroy()
		if api._destroyed then return end
		api._destroyed = true
		if pulse and pulse.Stop then pulse:Stop() end
		for i, p in ipairs(win.StatusPills or {}) do
			if p == api then table.remove(win.StatusPills, i); break end
		end
		Motion.Forget(pillFrame, true)
		pillFrame:Destroy()
	end
	function api:SetText(t: any) lbl.Text = tostring(t) end
	function api:SetToken(t: any)
		Motion.Spring(dot, "BackgroundColor3", win.Theme[t] or win.Theme.Good, "Snappy", win):To(win.Theme[t] or win.Theme.Good)
	end
	self.StatusPills = self.StatusPills or {}
	self.StatusPills[#self.StatusPills + 1] = api
	return api
end

