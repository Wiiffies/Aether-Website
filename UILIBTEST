-- ---------------------------------------------------------------------
-- Drag: velocity tilt while moving, momentum + wobble on release
-- ---------------------------------------------------------------------
-- GuiObject.AbsolutePosition ignores the top-bar inset, GetMouseLocation does
-- not. Only hit-testing needs the correction; drag deltas cancel it out.


-- ---------------------------------------------------------------------
-- Dragging.
--
-- The previous version failed in a real client for three reasons that a
-- mock could not see:
--   1. A Frame with Active = false never receives InputBegan at all.
--   2. It hit-tested descendants with `d.Visible` before `d:IsA(...)`,
--      which raises on UICorner/UIStroke/UIPadding ("Visible is not a
--      valid member of UICorner").
--   3. It guessed the top-bar inset instead of using consistent coordinates.
--
-- This version puts ONE Active TextButton behind the chrome and lets
-- Roblox route input: buttons drawn above it sink their own presses, so no
-- hit-testing is needed. Deltas come from input.Position, which is in the
-- same coordinate space on press and on move, so there is no inset maths.
-- ---------------------------------------------------------------------
local function makeDraggable(win: any, frame: any, handle: any, getScale: any, onMove: any)
	local D = CONFIG.Drag
	local pressing, dragging = false, false
	local pressPointer, pressCenter = nil, nil
	local lastPointer, lastClock, vel = nil, 0, Vector2.new(0, 0)
	local ancestorScale = 1

	-- The drag surface sits BELOW every other child of the handle.
	local surface = new("TextButton", {
		Name = "DragSurface", Text = "", AutoButtonColor = false,
		BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
		Size = UDim2.fromScale(1, 1), ZIndex = 0, Parent = handle,
	})
	-- Sink input over the whole window so the camera does not spin behind it.
	if frame:IsA("GuiObject") then frame.Active = true end

	local rot = Motion.Spring(frame, "Rotation", 0, "Soft", win)
	rot:Snap(0)

	local function parentBox(): (number, number)
		local vp = viewport()
		local pw, ph = vp.X, vp.Y
		local parent = frame.Parent
		if parent and parent:IsA("GuiObject") then
			local as = parent.AbsoluteSize
			if as.X > 0 and as.Y > 0 then pw, ph = as.X, as.Y end
		end
		return pw, ph
	end

	-- Position offsets live in the PARENT's coordinate space, so screen
	-- deltas must be divided by the scale of everything above the frame.
	-- Measured, not guessed: AbsoluteSize already contains every UIScale in
	-- the chain, and getScale() tells us the frame's own contribution.
	local function measureScale()
		local pw = parentBox()
		local sz = frame.Size
		local layoutW = sz.X.Scale * pw + sz.X.Offset
		local own = (getScale and getScale()) or 1
		if own <= 0 then own = 1 end
		local actual = frame.AbsoluteSize.X
		if layoutW > 1 and actual > 1 then
			return math.clamp(actual / (layoutW * own), 0.05, 8)
		end
		return 1
	end

	local function centerLocal()
		local pw, ph = parentBox()
		local p = frame.Position
		return Vector2.new(p.X.Scale * pw + p.X.Offset, p.Y.Scale * ph + p.Y.Offset)
	end

	local function setCenter(v: any)
		local pw, ph = parentBox()
		local sz = frame.Size
		local halfW = (sz.X.Scale * pw + sz.X.Offset) / 2
		local halfH = (sz.Y.Scale * ph + sz.Y.Offset) / 2
		local m = D.EdgeMargin
		local minX, maxX = halfW + m, pw - halfW - m
		local minY, maxY = halfH + m, ph - halfH - m
		if maxX < minX then minX, maxX = pw / 2, pw / 2 end
		if maxY < minY then minY, maxY = ph / 2, ph / 2 end
		local x = math.clamp(v.X, minX, maxX)
		local y = math.clamp(v.Y, minY, maxY)
		frame.Position = UDim2.fromOffset(x, y)
		if onMove then onMove(x, y) end
		return Vector2.new(x, y), (x ~= v.X or y ~= v.Y)
	end

	-- input.Position is a Vector3 in screen pixels and is consistent between
	-- InputBegan and InputChanged, for both mouse and touch.
	local function posOf(input: any)
		local p = input and input.Position
		if p then return Vector2.new(p.X, p.Y) end
		local m = UserInputService:GetMouseLocation()
		return Vector2.new(m.X, m.Y)
	end

	local function beginPress(input: any)
		pressing, dragging = true, false
		ancestorScale = measureScale()
		-- Freeze anything still driving Position/Rotation, or it keeps
		-- writing while we drag and the window snaps back and forth.
		Motion.Stop(frame, "Position")
		Motion.Stop(frame, "Rotation")
		pressPointer = posOf(input)
		pressCenter = centerLocal()
		lastPointer, lastClock, vel = pressPointer, os.clock(), Vector2.new(0, 0)
	end

	local function endPress()
		if not pressing then return end
		local wasDragging = dragging
		pressing, dragging = false, false
		if not wasDragging then
			rot:To(0)
			return
		end
		local center = centerLocal()
		local carry = vel * D.Momentum / ancestorScale
		if carry.Magnitude > 90 then carry = carry.Unit * 90 end
		local landed, hitEdge = setCenter(center + carry)
		local pos = Motion.Spring(frame, "Position", frame.Position, "Glide", win)
		pos:Snap(UDim2.fromOffset(center.X, center.Y))
		if not hitEdge then
			pos:Kick(UDim2.fromOffset(math.clamp(vel.X * D.Wobble, -D.MaxWobble, D.MaxWobble), 0))
		end
		pos:To(UDim2.fromOffset(landed.X, landed.Y))
		rot:To(0)
	end

	local function isPointer(input: any)
		local t = input.UserInputType
		return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
	end

	connect(win, surface.InputBegan, function(input: any)
		if isPointer(input) then beginPress(input) end
	end)

	connect(win, UserInputService.InputChanged, function(input: any)
		if not pressing then return end
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return end
		local pointer = posOf(input)
		local delta = (pointer - pressPointer) / ancestorScale
		if not dragging then
			if delta.Magnitude < D.Threshold then return end
			dragging = true
		end
		local now = os.clock()
		local dt = math.max(now - lastClock, 1 / 240)
		local instant = (pointer - lastPointer) / dt
		if instant.Magnitude > 4000 then instant = instant.Unit * 4000 end
		vel = vel:Lerp(instant, 0.3)
		lastPointer, lastClock = pointer, now
		setCenter(pressCenter + delta)
		rot:To(math.clamp(vel.X * D.Tilt, -D.MaxTilt, D.MaxTilt))
	end)

	connect(win, UserInputService.InputEnded, function(input: any)
		if isPointer(input) then endPress() end
	end)

	-- Alt-tab mid-drag used to leave `pressing` true, so the next mouse
	-- movement teleported the window. Always release.
	connect(win, UserInputService.WindowFocusReleased, endPress)

	return {
		IsDragging = function() return dragging end,
		SetCenter = function(v) ancestorScale = measureScale(); return setCenter(v) end,
		Cancel = endPress,
		Surface = surface,
	}
end

local function ripple(win: any, parent: any, inputPos: any)
	local r = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = win.Theme.AccentHi,
		BackgroundTransparency = 0.72, BorderSizePixel = 0,
		Size = UDim2.fromOffset(0, 0), ZIndex = 5, Parent = parent,
	})
	pill(r)
	local pos = UDim2.fromScale(0.5, 0.5)
	if inputPos then
		local ap, as = parent.AbsolutePosition, parent.AbsoluteSize
		if as.X > 0 and as.Y > 0 then
			pos = UDim2.fromScale(
				math.clamp((inputPos.X - ap.X) / as.X, 0, 1),
				math.clamp((inputPos.Y - ap.Y) / as.Y, 0, 1)
			)
		end
	end
	r.Position = pos
	local size = math.max(parent.AbsoluteSize.X, 60) * 1.6
	Motion.Tween(r, 0.45, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
	later(0.5, r, function() r:Destroy() end)
end

