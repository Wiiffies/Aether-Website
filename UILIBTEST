-- CARD ROWS
-- =====================================================================
local function rowBase(card: any, height: any, token: any)
	local win = card.Window
	local row = new("Frame", {
		BackgroundColor3 = win.Theme[token or "Row"], BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height), LayoutOrder = nextOrder(card), Parent = card.Body,
	})
	round(row, 8)
	return row
end

local function hoverable(win: any, row: any, isSel: any)
	local sc = scaler(row, 1)
	row.MouseEnter:Connect(function()
		if isSel and isSel() then return end
		Motion.Spring(row, "BackgroundColor3", win.Theme.RowHover, "Snappy", win):To(win.Theme.RowHover)
		Motion.Spring(row, "BackgroundTransparency", 0.35, "Snappy", win):To(0.35)
		Motion.Spring(sc, "Scale", 1.008, "Bouncy", win):To(1.008)
	end)
	row.MouseLeave:Connect(function()
		if isSel and isSel() then return end
		Motion.Spring(row, "BackgroundColor3", win.Theme.Row, "Snappy", win):To(win.Theme.Row)
		Motion.Spring(row, "BackgroundTransparency", 1, "Snappy", win):To(1)
		Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
	end)
	return sc
end

