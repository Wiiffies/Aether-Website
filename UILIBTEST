-- Side drawer
-- ---------------------------------------------------------------------
function Window:AddDrawer(opts: any)
	opts = opts or {}
	local width = opts.Width or 300
	local drawer: any = setmetatable({}, Card)
	drawer.Window, drawer.Elements, drawer._order = self, {}, 0
	drawer.Frame = new("CanvasGroup", {
		Name = "Drawer", BackgroundColor3 = self.Theme.Card, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(opts.Side == "left" and 0 or 1, 0),
		Position = UDim2.new(opts.Side == "left" and 0 or 1, 0, 0, 44),
		Size = UDim2.fromOffset(width, 0), GroupTransparency = 0, Visible = false,
		ZIndex = 30, Parent = self.Root,
	})
	drawer.Frame.Size = UDim2.new(0, width, 1, -80)
	drawer.Frame.Position = UDim2.new(opts.Side == "left" and 0 or 1, opts.Side == "left" and -width or width, 0, 44)
	outline(drawer.Frame, self.Theme.Stroke2, 1, 0.3)
	paint(self, drawer.Frame, "BackgroundColor3", "Card")
	drawer.Body = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 3, ScrollBarImageColor3 = self.Theme.Stroke2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 31, Parent = drawer.Frame,
	})
	pad(drawer.Body, 16, 16, 16, 16)
	vlist(drawer.Body, 8)
	local open = false
	function drawer:SetOpen(v: any)
		open = v == true
		if open then drawer.Frame.Visible = true end
		local x = open and 0 or (opts.Side == "left" and -width or width)
		Motion.Spring(drawer.Frame, "Position", UDim2.new(opts.Side == "left" and 0 or 1, x, 0, 44), "Groovy", self)
			:To(UDim2.new(opts.Side == "left" and 0 or 1, x, 0, 44))
		if open then
			Motion.Reveal(drawer.Body, self, { Step = 0.03, Distance = 12 })
		else
			later(0.3, drawer.Frame, function() if not open then drawer.Frame.Visible = false end end)
		end
	end
	function drawer:IsOpen() return open end
	function drawer:Toggle() drawer:SetOpen(not open) end
	self.Drawers = self.Drawers or {}
	self.Drawers[#self.Drawers + 1] = drawer
	return drawer
end

