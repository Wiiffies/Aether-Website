-- fail-safe hero gradient: multiplier stops, all channels <= 1
local function heroSequence(theme: any)
	local a, b = theme.Hero1, theme.Hero2
	local function ratio(x: any, y: any) return math.clamp(y / math.max(x, 1 / 255), 0, 1) end
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.new(ratio(a.R, b.R), ratio(a.G, b.G), ratio(a.B, b.B))),
	})
end

-- flat text+icon action used in card headers and the footer
local function actionButton(win: any, parent: any, opts: any)
	local size = opts.TextSize or 12
	local label = opts.Text or ""
	local iconW = opts.Icon and (size + 5) or 0
	local w = opts.Width or (textWidth(label, size) + iconW + (opts.Pad or 10) * 2)
	local h = opts.Height or 26
	local b = new("TextButton", {
		Name = "Action", BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromOffset(w, h), Text = "", AutoButtonColor = false,
		BackgroundColor3 = win.Theme.Row, LayoutOrder = opts.Order or 1, Parent = parent,
	})
	round(b, opts.Radius or 7)
	local stroke = outline(b, opts.Primary and win.Theme.Accent or win.Theme.Stroke2, 1, 1)
	if opts.Filled then
		b.BackgroundTransparency = 0
		b.BackgroundColor3 = opts.Primary and win.Theme.Accent or win.Theme.Row
		stroke.Transparency = opts.Primary and 1 or 0.35
		paint(win, b, "BackgroundColor3", opts.Primary and "Accent" or "Row")
	end
	local x = opts.Pad or 10
	if opts.Icon then
		local ic = drawIcon(b, opts.Icon, size + 2, opts.Primary and Color3.new(1,1,1) or win.Theme.Sub, win)
		ic.Frame.Position = UDim2.fromOffset(x, (h - (size + 2)) / 2)
		x += size + 5
	end
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -x - (opts.Pad or 10), 1, 0),
		Font = opts.Bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
		TextSize = size, TextColor3 = opts.Primary and Color3.new(1,1,1)
			or (opts.Danger and win.Theme.Bad or win.Theme.Sub),
		TextXAlignment = Enum.TextXAlignment.Left, Text = label, Parent = b,
	})
	if not opts.Primary then paint(win, lbl, "TextColor3", opts.Danger and "Bad" or "Sub") end
	local sc = scaler(b, 1)
	b.MouseEnter:Connect(function()
		Motion.Spring(sc, "Scale", 1.04, "Bouncy", win):To(1.04)
		if opts.Filled and not opts.Primary then
			Motion.Spring(stroke, "Transparency", 0.1, "Snappy", win):To(0.1)
			Motion.Spring(stroke, "Color", win.Theme.Accent, "Snappy", win):To(win.Theme.Accent)
		end
		Motion.Spring(lbl, "TextColor3", opts.Primary and Color3.new(1,1,1) or win.Theme.Text, "Snappy", win):To(opts.Primary and Color3.new(1,1,1) or win.Theme.Text)
		if opts.Filled then
			Motion.Spring(b, "BackgroundColor3", opts.Primary and win.Theme.AccentHi or win.Theme.RowHover, "Snappy", win):To(opts.Primary and win.Theme.AccentHi or win.Theme.RowHover)
		else
			Motion.Spring(b, "BackgroundTransparency", 0.55, "Snappy", win):To(0.55)
		end
	end)
	b.MouseLeave:Connect(function()
		Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
		if opts.Filled then
			Motion.Spring(stroke, "Transparency", opts.Primary and 1 or 0.35, "Snappy", win):To(opts.Primary and 1 or 0.35)
			Motion.Spring(stroke, "Color", opts.Primary and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win):To(opts.Primary and win.Theme.Accent or win.Theme.Stroke2)
		end
		Motion.Spring(lbl, "TextColor3", opts.Primary and Color3.new(1,1,1) or (opts.Danger and win.Theme.Bad or win.Theme.Sub), "Snappy", win):To(opts.Primary and Color3.new(1,1,1) or (opts.Danger and win.Theme.Bad or win.Theme.Sub))
		if opts.Filled then
			Motion.Spring(b, "BackgroundColor3", opts.Primary and win.Theme.Accent or win.Theme.Row, "Snappy", win):To(opts.Primary and win.Theme.Accent or win.Theme.Row)
		else
			Motion.Spring(b, "BackgroundTransparency", 1, "Snappy", win):To(1)
		end
	end)
	b.Activated:Connect(function()
		ripple(win, b, UserInputService:GetMouseLocation())
		Motion.Spring(sc, "Scale", 0.94, "Snappy", win):To(0.94)
		later(0.07, b, function() Motion.Spring(sc, "Scale", 1.04, "Groovy", win):To(1.04) end)
		if opts.Callback then
			task.spawn(function()
				local ok, err = pcall(opts.Callback)
				if not ok then warn("[Aether action] " .. tostring(err)) end
			end)
		end
	end)
	return { Frame = b, Label = lbl, SetText = function(t) lbl.Text = tostring(t) end }
end

