-- ---------------------------------------------------------------------
-- Tooltips
-- ---------------------------------------------------------------------
function Window:Tooltip(target: any, text: any, opts: any)
	opts = opts or {}
	self:HideTooltip(true)
	local tip = new("CanvasGroup", {
		Name = "Tooltip", BackgroundColor3 = self.Theme.Card, BorderSizePixel = 0,
		Size = UDim2.fromOffset(math.min(textWidth(text, 11) + 20, 280), 0),
		AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 0,
		ZIndex = 60, Parent = self.Gui,
	})
	round(tip, 7)
	outline(tip, self.Theme.Stroke2, 1, 0.25)
	paint(self, tip, "BackgroundColor3", "Card")
	pad(tip, 10, 10, 7, 7)
	vlist(tip, 0)
	new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 11,
		TextColor3 = self.Theme.Text, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		Text = tostring(text), ZIndex = 61, Parent = tip,
	})
	local ap, as = target.AbsolutePosition, target.AbsoluteSize
	local vp = viewport()
	local x = math.clamp(ap.X + as.X / 2 - tip.AbsoluteSize.X / 2, 8, math.max(8, vp.X - tip.AbsoluteSize.X - 8))
	local y = ap.Y - 34
	if y < 8 then y = ap.Y + as.Y + 8 end
	tip.Position = UDim2.fromOffset(x, y + 6)
	tip.GroupTransparency = 1
	local sc = scaler(tip, 0.94)
	Motion.Spring(tip, "GroupTransparency", 0, "Snappy", self):To(0)
	Motion.Spring(tip, "Position", UDim2.fromOffset(x, y), "Bouncy", self):To(UDim2.fromOffset(x, y))
	Motion.Spring(sc, "Scale", 1, "Groovy", self):To(1)
	self._tooltip = tip
	return tip
end

function Window:HideTooltip(instant: any)
	local tip = self._tooltip
	if not tip or not tip.Parent then self._tooltip = nil; return end
	self._tooltip = nil
	if instant then tip:Destroy(); return end
	Motion.Spring(tip, "GroupTransparency", 1, "Snappy", self):To(1)
	later(0.16, tip, function() tip:Destroy() end)
end

-- ---------------------------------------------------------------------
-- Context menu (right click anywhere you attach it)
-- ---------------------------------------------------------------------
function Window:ContextMenu(target: any, items: any)
	connect(self, target.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton2 then
			self:ShowContextMenu(items, UserInputService:GetMouseLocation())
		end
	end)
end

function Window:ShowContextMenu(items: any, at: any)
	self:HideContextMenu()
	local vp = viewport()
	local w = 180
	local h = #items * 28 + 12
	local x = math.clamp(at.X, 8, math.max(8, vp.X - w - 8))
	local y = math.clamp(at.Y, 8, math.max(8, vp.Y - h - 8))
	local menu = new("CanvasGroup", {
		Name = "ContextMenu", BackgroundColor3 = self.Theme.Card, BorderSizePixel = 0,
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		GroupTransparency = 1, ZIndex = 55, Parent = self.Gui,
	})
	round(menu, 8)
	outline(menu, self.Theme.Stroke2, 1, 0.2)
	paint(self, menu, "BackgroundColor3", "Card")
	pad(menu, 6, 6, 6, 6)
	vlist(menu, 2)
	local sc = scaler(menu, 0.95)
	for i, it in ipairs(items) do
		if it.Divider then
			local d = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 7), LayoutOrder = i, Parent = menu })
			local line = new("Frame", {
				BackgroundColor3 = self.Theme.Stroke, BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1, -8, 0, 1), ZIndex = 56, Parent = d,
			})
			paint(self, line, "BackgroundColor3", "Stroke")
		else
			local b = new("TextButton", {
				BackgroundColor3 = self.Theme.Row, BackgroundTransparency = 1, BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 26), Text = "", AutoButtonColor = false,
				LayoutOrder = i, ZIndex = 56, Parent = menu,
			})
			round(b, 6)
			local ix = 10
			if it.Icon then
				local ic = drawIcon(b, it.Icon, 13, it.Danger and self.Theme.Bad or self.Theme.Sub, self)
				ic.Frame.Position = UDim2.fromOffset(9, 6.5)
				ic.Frame.ZIndex = 57
				ix = 29
			end
			local lbl = new("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(ix, 0),
				Size = UDim2.new(1, -ix - 10, 1, 0), Font = Enum.Font.Gotham, TextSize = 12,
				TextColor3 = it.Danger and self.Theme.Bad or self.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, Text = it.Text or "", ZIndex = 57, Parent = b,
			})
			paint(self, lbl, "TextColor3", it.Danger and "Bad" or "Text")
			local bs = scaler(b, 1)
			b.MouseEnter:Connect(function()
				Motion.Spring(b, "BackgroundTransparency", 0, "Snappy", self):To(0)
				Motion.Spring(bs, "Scale", 1.02, "Bouncy", self):To(1.02)
			end)
			b.MouseLeave:Connect(function()
				Motion.Spring(b, "BackgroundTransparency", 1, "Snappy", self):To(1)
				Motion.Spring(bs, "Scale", 1, "Bouncy", self):To(1)
			end)
			b.Activated:Connect(function()
				self:HideContextMenu()
				if it.Callback then task.spawn(function() pcall(it.Callback) end) end
			end)
		end
	end
	Motion.Spring(menu, "GroupTransparency", 0, "Snappy", self):To(0)
	Motion.Spring(sc, "Scale", 1, "Groovy", self):To(1)
	Motion.Reveal(menu, self, { Step = 0.02, Distance = 6, Cap = 0.15 })
	self._contextMenu = menu
	self._contextClose = function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local m = UserInputService:GetMouseLocation()
		local ap, as = menu.AbsolutePosition, menu.AbsoluteSize
		if m.X < ap.X or m.X > ap.X + as.X or m.Y < ap.Y or m.Y > ap.Y + as.Y then self:HideContextMenu() end
	end
	connect(self, UserInputService.InputBegan, self._contextClose)
	return menu
end

function Window:HideContextMenu()
	local m = self._contextMenu
	if not m or not m.Parent then self._contextMenu = nil; return end
	self._contextMenu = nil
	Motion.Spring(m, "GroupTransparency", 1, "Snappy", self):To(1)
	later(0.15, m, function() m:Destroy() end)
end

-- ---------------------------------------------------------------------
-- Generic modal shell used by Confirm / Prompt
-- ---------------------------------------------------------------------
function Window:_modal(width: any, height: any)
	local shade = new("Frame", {
		Name = "ModalShade", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 45, Parent = self.Root,
	})
	Motion.Tween(shade, 0.18, { BackgroundTransparency = 0.55 })
	local box = new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height), BackgroundColor3 = self.Theme.Card,
		BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 46, Parent = shade,
	})
	round(box, 12)
	outline(box, self.Theme.SelStroke, 1, 0.35)
	paint(self, box, "BackgroundColor3", "Card")
	local sc = scaler(box, 0.94)
	Motion.Spring(box, "GroupTransparency", 0, "UI", self):To(0)
	Motion.Spring(sc, "Scale", 1, "Groovy", self):To(1)
	local body = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = box })
	pad(body, 20, 20, 18, 18)
	vlist(body, 8)
	local api = setmetatable({ Window = self, Body = body, Elements = {}, _order = 0 }, Card)
	local function close()
		Motion.Spring(box, "GroupTransparency", 1, "Snappy", self):To(1)
		Motion.Spring(sc, "Scale", 0.94, "Snappy", self):To(0.94)
		Motion.Tween(shade, 0.18, { BackgroundTransparency = 1 })
		later(0.22, shade, function() shade:Destroy() end)
	end
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, ZIndex = 45, Parent = shade,
	})
	hit.Activated:Connect(close)
	return api, close, box
end

function Window:Confirm(opts: any)
	opts = opts or {}
	local card, close = self:_modal(400, 190)
	card:SetHeader({ Title = opts.Title or "Are you sure?" })
	card:AddCaption(opts.Text or "")
	card:AddSpacer(6)
	card:AddButtonBar({ Buttons = {
		{ Text = opts.CancelText or "Cancel", Callback = function()
			close()
			if opts.Callback then task.spawn(function() pcall(opts.Callback, false) end) end
		end },
		{ Text = opts.ConfirmText or "Confirm", Primary = true, Callback = function()
			close()
			if opts.Callback then task.spawn(function() pcall(opts.Callback, true) end) end
		end },
	} })
	return close
end

function Window:Prompt(opts: any)
	opts = opts or {}
	local card, close = self:_modal(400, 200)
	card:SetHeader({ Title = opts.Title or "Enter a value" })
	if opts.Text then card:AddCaption(opts.Text) end
	local field = card:AddTextbox({ Placeholder = opts.Placeholder or "", Default = opts.Default or "" })
	card:AddButtonBar({ Buttons = {
		{ Text = "Cancel", Callback = function() close() end },
		{ Text = opts.ConfirmText or "OK", Primary = true, Callback = function()
			local v = field:Get()
			close()
			if opts.Callback then task.spawn(function() pcall(opts.Callback, v) end) end
		end },
	} })
	return close, field
end

