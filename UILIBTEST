local PAINT = setmetatable({}, { __mode = "k" })

local function paint(win: any, object: any, property: any, token: any)
	object[property] = win.Theme[token]
	local list = PAINT[win]
	if not list then list = {}; PAINT[win] = list end
	list[#list + 1] = { o = object, p = property, t = token }
	return object
end

local function connect(win: any, signal: any, fn: any)
	local c = signal:Connect(fn)
	win._conns[#win._conns + 1] = c
	return c
end

