-- NOTE: writefile / readfile / isfile / isfolder / makefolder / getcustomasset
-- are NOT declared as locals here on purpose. A `local writefile = nil` would
-- shadow the executor's real global and silently disable asset loading, which
-- is exactly the class of bug this release is fixing. They are referenced as
-- globals and every use is guarded with a type check.

local ENV = _G
pcall(function()
	if getgenv then
		local g = getgenv()
		if type(g) == "table" then ENV = g end
	end
end)

-- =====================================================================
-- SUPPLIED ASSETS
-- ---------------------------------------------------------------------
-- Roblox cannot load a local .png. The only route from a file on your PC to
-- a live client is the executor's filesystem:
--     writefile(name, bytes)  ->  getcustomasset(name)  ->  rbxasset: URL
-- So the icon PNGs are embedded below as base64, written once to the
-- executor workspace, and resolved here at load time.
--
-- Every step is optional. On a client without an executor (or without
-- getcustomasset) resolution simply fails and the vector glyphs are used,
-- so the UI still draws. Nothing here can throw.
-- =====================================================================
local ASSET_FOLDER = "AetherUI_icons"

local function base64DecodeFast(s: string): string?
	local b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local lut: {[number]: number} = {}
	for i = 1, #b64 do lut[string.byte(b64, i)] = i - 1 end
	local out: {[number]: number} = {}
	local acc, bits, n = 0, 0, 0
	for i = 1, #s do
		local c = string.byte(s, i)
		if c ~= 61 then -- '='
			local v = lut[c]
			if not v then
				if c == 32 or c == 10 or c == 13 or c == 9 then
					continue
				end
				return nil
			end
			acc = acc * 64 + v
			bits += 6
			if bits >= 8 then
				bits -= 8
				local p = 2 ^ bits
				n += 1
				out[n] = math.floor(acc / p) % 256
				acc = acc - math.floor(acc / p) * p
			end
		end
	end
	local chunk, parts = {}, {}
	for i = 1, n do
		chunk[#chunk + 1] = string.char(out[i])
		if #chunk >= 1024 then
			parts[#parts + 1] = table.concat(chunk)
			chunk = {}
		end
	end
	if #chunk > 0 then parts[#parts + 1] = table.concat(chunk) end
	return table.concat(parts)
end

