-- segmented pill group (Uncapped / 60 / 120 / 144 / 240, delay 4s/8s/15s, ...)
function Card:AddSegmented(opts: any)
	opts = opts or {}
	local win = self.Window
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Height or 30),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local x = 0
	if opts.Label then
		local lw = textWidth(opts.Label, 12) + 12
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromOffset(lw, 30),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
		x = lw
	end
	local holder = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -x, 1, 0), Parent = row,
	})
	hlist(holder, 6, Enum.VerticalAlignment.Center)
	local selected = opts.Default or (opts.Options or {})[1]
	local buttons = {}
	local api: any = { Instance = row }
	local function paintAll()
		for _, b in ipairs(buttons) do
			local on = b.value == selected
			Motion.Spring(b.frame, "BackgroundColor3", on and win.Theme.SegSel or win.Theme.Row, "Snappy", win):To(on and win.Theme.SegSel or win.Theme.Row)
			Motion.Spring(b.stroke, "Transparency", on and 0.15 or 0.6, "Snappy", win):To(on and 0.15 or 0.6)
			Motion.Spring(b.stroke, "Color", on and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win):To(on and win.Theme.Accent or win.Theme.Stroke2)
			Motion.Spring(b.label, "TextColor3", on and win.Theme.Text or win.Theme.Sub, "Snappy", win):To(on and win.Theme.Text or win.Theme.Sub)
		end
	end
	for i, opt in ipairs(opts.Options or {}) do
		local w = opts.Width or (textWidth(tostring(opt), 12) + 22)
		local b = new("TextButton", {
			BackgroundColor3 = win.Theme.Row, BorderSizePixel = 0,
			Size = UDim2.fromOffset(w, 26), Text = "", AutoButtonColor = false,
			LayoutOrder = i, Parent = holder,
		})
		round(b, 7)
		local st = outline(b, win.Theme.Stroke2, 1, 0.6)
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = win.Theme.Sub,
			Text = tostring(opt), Parent = b,
		})
		local sc = scaler(b, 1)
		local entry = { frame = b, stroke = st, label = lbl, value = opt }
		buttons[#buttons + 1] = entry
		b.MouseEnter:Connect(function() Motion.Spring(sc, "Scale", 1.06, "Bouncy", win):To(1.06) end)
		b.MouseLeave:Connect(function() Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1) end)
		b.Activated:Connect(function()
			selected = opt
			sc.Scale = 0.9
			Motion.Spring(sc, "Scale", 1, "Groovy", win):To(1)
			paintAll()
			if opts.Callback then task.spawn(function() pcall(opts.Callback, opt) end) end
		end)
	end
	function api:Set(v: any, fire: any)
		selected = v
		paintAll()
		if fire and opts.Callback then task.spawn(function() pcall(opts.Callback, v) end) end
	end
	function api:Get() return selected end
	paintAll()
	self.Elements[#self.Elements + 1] = api
	return api
end

