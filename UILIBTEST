-- Star rating
-- ---------------------------------------------------------------------
function Card:AddRating(opts: any)
	opts = opts or {}
	local win = self.Window
	local count = opts.Stars or 5
	local value = math.clamp(opts.Default or 0, 0, count)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, -(count * 26 + 8), 1, 0),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local holder = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(count * 26, 24), Parent = row,
	})
	hlist(holder, 2, Enum.VerticalAlignment.Center)
	local stars = {}
	local api: any = { Instance = row }
	local function paintStars(upto: any, bounce: any)
		for i, st in ipairs(stars) do
			local on = i <= upto
			st.icon.SetColor(on and win.Theme.Accent or win.Theme.Stroke2)
			if bounce and on then
				later((i - 1) * 0.04, st.frame, function()
					Motion.Pop(st.scale, win, { From = 0.7, Overshoot = 1.25 })
				end)
			end
		end
	end
	for i = 1, count do
		local b = new("TextButton", {
			BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24), Text = "",
			AutoButtonColor = false, LayoutOrder = i, Parent = holder,
		})
		local ic = drawIcon(b, "star", 16, win.Theme.Stroke2, win)
		ic.Frame.Position = UDim2.fromOffset(4, 4)
		local sc = scaler(b, 1)
		stars[i] = { frame = b, icon = ic, scale = sc }
		b.MouseEnter:Connect(function()
			paintStars(i, false)
			Motion.Spring(sc, "Scale", 1.2, "Groovy", win):To(1.2)
		end)
		b.MouseLeave:Connect(function()
			paintStars(value, false)
			Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
		end)
		b.Activated:Connect(function()
			local changed = value ~= i
			value = i
			paintStars(value, true)
			if changed and opts.Callback then task.spawn(function() pcall(opts.Callback, value) end) end
		end)
	end
	function api:Get() return value end
	function api:Set(v: any, fire: any)
		local nv = math.clamp(math.floor(tonumber(v) or 0), 0, count)
		local changed = nv ~= value
		value = nv
		paintStars(value, true)
		if changed and fire ~= false and opts.Callback then task.spawn(function() pcall(opts.Callback, value) end) end
	end
	paintStars(value, false)
	self.Elements[#self.Elements + 1] = api
	return api
end

