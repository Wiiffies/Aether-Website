local function resolveAssets(): {[string]: string}
	local urls: {[string]: string} = {}
	if type(getcustomasset) ~= "function" or type(writefile) ~= "function" then
		return urls -- no executor: vectors only, silently
	end

	pcall(function()
		if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(ASSET_FOLDER) then
			makefolder(ASSET_FOLDER)
		end
	end)

	for name, chunks in pairs(ASSET_B64) do
		local path = ASSET_FOLDER .. "/" .. name .. ".png"
		local written = false
		pcall(function()
			local bytes = base64DecodeFast(table.concat(chunks))
			if not bytes then return end
			if type(isfile) == "function" and isfile(path) then
				-- Already written by an earlier load; trust it to avoid touching
				-- the disk on every re-run. If it is somehow bad, getcustomasset
				-- throws below and we fall back cleanly.
				if type(readfile) == "function" then
					local have = readfile(path)
					if type(have) == "string" and #have == #bytes then
						written = true
						return
					end
				end
			end
			writefile(path, bytes)
			written = true
		end)
		if written then
			local ok, url = pcall(getcustomasset, path)
			if ok and type(url) == "string" and url ~= "" then
				urls[name] = url
			end
		end
	end
	return urls
end

