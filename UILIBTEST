	local sc = scaler(b, 1)
	b.MouseEnter:Connect(function()
		Motion.Spring(b, "BackgroundTransparency", 0, "Snappy", win):To(0)
		Motion.Spring(sc, "Scale", 1.12, "Bouncy", win):To(1.12)
		ic.SetColor(token == "Bad" and win.Theme.Bad or win.Theme.Text)
