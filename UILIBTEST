local TextService = game:GetService("TextService")
local function textWidth(text: any, size: any, font: any)
	local ok, res = pcall(function()
		return TextService:GetTextSize(text, size, font or Enum.Font.GothamMedium, Vector2.new(2000, 40))
	end)
