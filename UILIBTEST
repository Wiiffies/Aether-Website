		Text = opts.Title or "Group", Parent = head,
	})
	local countLabel
	if opts.Badge then
		countLabel = new("TextLabel", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(60, 16),
			Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = win.Theme.Dim,
			TextXAlignment = Enum.TextXAlignment.Right, Text = opts.Badge, Parent = head,
		})
		paint(win, countLabel, "TextColor3", "Dim")
	end
	group.Body = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -36), Parent = holder,
	})
	pad(group.Body, 8, 8, 0, 4)
	vlist(group.Body, 7)

	local function measure()
		local total = 4
		for _, c in ipairs(group.Body:GetChildren()) do
			if c:IsA("GuiObject") and c.Visible then total += c.Size.Y.Offset + 7 end
		end
		return total
	end
	function group:SetOpen(v: any, instant: any)
		open = v == true
		local h = open and (36 + measure()) or 32
		Motion.Spring(chev.Frame, "Rotation", open and 180 or 0, "Groovy", win):To(open and 180 or 0)
		Motion.Spring(stroke, "Color", open and win.Theme.Accent or win.Theme.Stroke, "Snappy", win)
			:To(open and win.Theme.Accent or win.Theme.Stroke)
		Motion.Spring(stroke, "Transparency", open and 0.4 or 0.45, "Snappy", win):To(open and 0.4 or 0.45)
		if instant then
			holder.Size = UDim2.new(1, 0, 0, h)
		else
			Motion.Spring(holder, "Size", UDim2.new(1, 0, 0, h), "Bouncy", win):To(UDim2.new(1, 0, 0, h))
			if open then Motion.Reveal(group.Body, win, { Step = 0.03, Distance = 10, Cap = 0.25 }) end
		end
	end
	function group:IsOpen() return open end
	function group:Refresh() if open then group:SetOpen(true) end end
	function group:SetBadge(t: any) if countLabel then countLabel.Text = tostring(t) end end
	head.Activated:Connect(function()
		ripple(win, head, UserInputService:GetMouseLocation())
		group:SetOpen(not open)
		if opts.Callback then task.spawn(function() pcall(opts.Callback, open) end) end
	end)
	head.MouseEnter:Connect(function()
		Motion.Spring(head, "BackgroundColor3", win.Theme.Row, "Snappy", win):To(win.Theme.Row)
	end)
	head.MouseLeave:Connect(function()
		Motion.Spring(head, "BackgroundColor3", win.Theme.Inset, "Snappy", win):To(win.Theme.Inset)
	end)
	group.Instance = holder
	group:SetOpen(false, true)
	self.Elements[#self.Elements + 1] = group
	return group
end

-- ---------------------------------------------------------------------
-- Sub-tabs inside a card: each page is its own element host
-- ---------------------------------------------------------------------
function Card:AddSubTabs(opts: any)
	opts = opts or {}
	local win = self.Window
	local names = opts.Tabs or { "One", "Two" }
	local height = opts.Height or 180
	local holder = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height + 34),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local bar = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Parent = holder })
	hlist(bar, 6, Enum.VerticalAlignment.Center)
	local underline = new("Frame", {
		BackgroundColor3 = win.Theme.Accent, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 28), Size = UDim2.fromOffset(0, 2), Parent = holder,
	})
	pill(underline)
	paint(win, underline, "BackgroundColor3", "Accent")
	local uX = Motion.Spring(underline, "Position", underline.Position, "Bouncy", win)
	local uW = Motion.Spring(underline, "Size", underline.Size, "Bouncy", win)
	uX:Snap(underline.Position); uW:Snap(underline.Size)

	local api: any = { Instance = holder, Pages = {}, Buttons = {} }
	local active = nil
	local x = 0
	for i, name in ipairs(names) do
		local page = setmetatable({}, Card)
		page.Window, page.Elements, page._order = win, {}, 0
		page.Frame = new("CanvasGroup", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 36),
			Size = UDim2.new(1, 0, 0, height), Visible = false, GroupTransparency = 0, Parent = holder,
		})
		page.Body = new("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
			ScrollBarThickness = 3, ScrollBarImageColor3 = win.Theme.Stroke2,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y, Parent = page.Frame,
		})
		pad(page.Body, 2, 6, 4, 4)
		vlist(page.Body, 7)
		api.Pages[i] = page
		page.Name = name

		local w = textWidth(name, 12) + 24
		local b = new("TextButton", {
			BackgroundColor3 = win.Theme.Row, BackgroundTransparency = 1, BorderSizePixel = 0,
			Size = UDim2.fromOffset(w, 26), Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = bar,
		})
		round(b, 7)
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = win.Theme.Sub,
			Text = name, Parent = b,
		})
		api.Buttons[i] = { Frame = b, Label = lbl, X = x, Width = w }
		x += w + 6
		local sc = scaler(b, 1)
		b.MouseEnter:Connect(function()
			if active == i then return end
			Motion.Spring(b, "BackgroundTransparency", 0.5, "Snappy", win):To(0.5)
			Motion.Spring(lbl, "TextColor3", win.Theme.Text, "Snappy", win):To(win.Theme.Text)
		end)
		b.MouseLeave:Connect(function()
			if active == i then return end
			Motion.Spring(b, "BackgroundTransparency", 1, "Snappy", win):To(1)
			Motion.Spring(lbl, "TextColor3", win.Theme.Sub, "Snappy", win):To(win.Theme.Sub)
		end)
		b.Activated:Connect(function()
			Motion.Pop(sc, win, { From = 0.93 })
			api:SetActive(i)
			if opts.Callback then task.spawn(function() pcall(opts.Callback, i, name) end) end
		end)
	end
	function api:SetActive(i: any)
		i = math.clamp(i, 1, #names)
		if active == i then return end
		local forward = active == nil or i > active
		active = i
		for j, p in ipairs(api.Pages) do
			local btn = api.Buttons[j]
			local on = j == i
			Motion.Spring(btn.Frame, "BackgroundTransparency", on and 0 or 1, "Snappy", win):To(on and 0 or 1)
			Motion.Spring(btn.Label, "TextColor3", on and win.Theme.Text or win.Theme.Sub, "Snappy", win)
				:To(on and win.Theme.Text or win.Theme.Sub)
			if on then
				p.Frame.Visible = true
				p.Frame.GroupTransparency = 1
				p.Frame.Position = UDim2.fromOffset(forward and 16 or -16, 36)
				Motion.Spring(p.Frame, "GroupTransparency", 0, "Snappy", win):To(0)
				Motion.Spring(p.Frame, "Position", UDim2.fromOffset(0, 36), "Bouncy", win):To(UDim2.fromOffset(0, 36))
			elseif p.Frame.Visible then
				Motion.Tween(p.Frame, 0.12, { GroupTransparency = 1 })
				later(0.13, p.Frame, function() if active ~= j then p.Frame.Visible = false end end)
			end
		end
		local btn = api.Buttons[i]
		uX:To(UDim2.fromOffset(btn.X + 6, 28))
		uW:To(UDim2.fromOffset(btn.Width - 12, 2))
	end
	function api:GetActive() return active end
	api:SetActive(opts.Default or 1)
	self.Elements[#self.Elements + 1] = api
	return api
end

