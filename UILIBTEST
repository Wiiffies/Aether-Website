-- ---------------------------------------------------------------------
-- Icon tile grid (app-launcher style)
-- ---------------------------------------------------------------------
function Card:AddIconTiles(opts: any)
	opts = opts or {}
	local win = self.Window
	local items = opts.Items or {}
	local perRow = opts.PerRow or 4
	local tileH = opts.TileHeight or 76
	local rows = math.ceil(#items / perRow)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, rows * tileH + (rows - 1) * 8),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	vlist(row, 8)
	local index = 0
	local api: any = { Instance = row, Tiles = {} }
	for r = 1, rows do
		local line = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, tileH), LayoutOrder = r, Parent = row })
		hlist(line, 8, Enum.VerticalAlignment.Top)
		local inThis = math.min(perRow, #items - index)
		for c = 1, inThis do
			index += 1
			local it = items[index]
			local tile = new("TextButton", {
				BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0, Text = "",
				AutoButtonColor = false, Size = UDim2.new(1 / inThis, -8 * (inThis - 1) / inThis, 1, 0),
				LayoutOrder = c, Parent = line,
			})
			round(tile, 9)
			local st = outline(tile, win.Theme.Stroke, 1, 0.5)
			paint(win, tile, "BackgroundColor3", "Inset")
			local iconHolder = new("Frame", {
				BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(24, 24), Parent = tile,
			})
			drawIcon(iconHolder, it.Icon or "grid", 24, win.Theme[it.Token or "Accent"], win)
			local iscale = scaler(iconHolder, 1)
			new("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.new(0, 4, 0, 44),
				Size = UDim2.new(1, -8, 0, 16), Font = Enum.Font.GothamMedium, TextSize = 11,
				TextColor3 = win.Theme.Sub, Text = it.Name or "", TextTruncate = Enum.TextTruncate.AtEnd, Parent = tile,
			})
			local sc = scaler(tile, 1)
			tile.MouseEnter:Connect(function()
				Motion.Spring(sc, "Scale", 1.04, "Bouncy", win):To(1.04)
				Motion.Spring(iscale, "Scale", 1.2, "Groovy", win):To(1.2)
				Motion.Spring(iscale, "Rotation", -8, "Groovy", win):To(-8)
				Motion.Spring(tile, "BackgroundColor3", win.Theme.Row, "Snappy", win):To(win.Theme.Row)
				Motion.Spring(st, "Color", win.Theme.Accent, "Snappy", win):To(win.Theme.Accent)
				Motion.Spring(st, "Transparency", 0.3, "Snappy", win):To(0.3)
			end)
			tile.MouseLeave:Connect(function()
				Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
				Motion.Spring(iscale, "Scale", 1, "Bouncy", win):To(1)
				Motion.Spring(iscale, "Rotation", 0, "Groovy", win):To(0)
				Motion.Spring(tile, "BackgroundColor3", win.Theme.Inset, "Snappy", win):To(win.Theme.Inset)
				Motion.Spring(st, "Color", win.Theme.Stroke, "Snappy", win):To(win.Theme.Stroke)
				Motion.Spring(st, "Transparency", 0.5, "Snappy", win):To(0.5)
			end)
			tile.Activated:Connect(function()
				ripple(win, tile, UserInputService:GetMouseLocation())
				Motion.Pop(sc, win, { From = 0.93, Overshoot = 1.05 })
				if it.Callback then task.spawn(function() pcall(it.Callback) end) end
			end)
			api.Tiles[index] = tile
			later(math.min(index * 0.04, 0.4), tile, function() Motion.SlideIn(tile, win, { Y = 14 }) end)
		end
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Console with severity colours and a filter
-- ---------------------------------------------------------------------
function Card:AddConsole(opts: any)
	opts = opts or {}
	local win = self.Window
	local height = opts.Height or 180
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local box = new("Frame", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = row,
	})
	round(box, 8)
	outline(box, win.Theme.Stroke, 1, 0.4)
	paint(win, box, "BackgroundColor3", "Inset")
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 3, ScrollBarImageColor3 = win.Theme.Stroke2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Parent = box,
	})
	pad(scroll, 10, 10, 8, 8)
	vlist(scroll, 1)
	local api: any = { Instance = row, Lines = {} }
	local tokens = { info = "Sub", ok = "Good", warn = "Bad", error = "Bad", debug = "Dim" }
	local counter = 0
	function api:Log(text: any, level: any)
		counter += 1
		local token = tokens[level or "info"] or "Sub"
		local line = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Code, TextSize = 11,
			TextColor3 = win.Theme[token], TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true, Text = tostring(text), LayoutOrder = counter,
			TextTransparency = 1, Parent = scroll,
		})
		paint(win, line, "TextColor3", token)
		api.Lines[#api.Lines + 1] = line
		Motion.Spring(line, "TextTransparency", 0, "Snappy", win):To(0)
		if opts.MaxLines and #api.Lines > opts.MaxLines then
			local old = table.remove(api.Lines, 1)
			if old then old:Destroy() end
		end
		if opts.AutoScroll ~= false then
			later(0.03, scroll, function()
				scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.AbsoluteCanvasSize.Y))
			end)
		end
		return line
	end
	function api:Clear()
		for _, l in ipairs(api.Lines) do if l.Parent then l:Destroy() end end
		api.Lines = {}
		counter = 0
	end
	for _, l in ipairs(opts.Lines or {}) do
		if type(l) == "table" then api:Log(l[1], l[2]) else api:Log(l, "info") end
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

