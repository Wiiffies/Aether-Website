		local token = type(b) == "table" and b.Token or (opts.Token or "Accent")
		local w = textWidth(text, 10) + (type(b) == "table" and b.Dot and 24 or 16)
		local f = new("Frame", {
			BackgroundColor3 = win.Theme.NavSel, BorderSizePixel = 0,
			Size = UDim2.fromOffset(w, 20), LayoutOrder = i, Parent = row,
		})
		pill(f)
		paint(win, f, "BackgroundColor3", "NavSel")
		local x = 8
		if type(b) == "table" and b.Dot then
			local d = new("Frame", {
				BackgroundColor3 = win.Theme[token], BorderSizePixel = 0,
				Position = UDim2.fromOffset(8, 7), Size = UDim2.fromOffset(6, 6), Parent = f,
			})
			pill(d)
			paint(win, d, "BackgroundColor3", token)
			x = 19
		end
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(x, 0),
			Size = UDim2.new(1, -x - 8, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 10,
			TextColor3 = win.Theme[token], TextXAlignment = Enum.TextXAlignment.Left,
			Text = text, Parent = f,
		})
		paint(win, lbl, "TextColor3", token)
		local sc = scaler(f, 1)
		f.MouseEnter:Connect(function() Motion.Spring(sc, "Scale", 1.08, "Groovy", win):To(1.08) end)
		f.MouseLeave:Connect(function() Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1) end)
		api.Items[i] = { Frame = f, Label = lbl }
		later(math.min(i * 0.04, 0.3), f, function() Motion.Pop(sc, win, { From = 0.7, Overshoot = 1.1 }) end)
	end
	function api:SetText(i: any, t: any) if api.Items[i] then api.Items[i].Label.Text = tostring(t) end end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Alert / callout
-- ---------------------------------------------------------------------
function Card:AddAlert(opts: any)
	opts = opts or {}
	local win = self.Window
	local kind = opts.Type or "info"
	local token = ({ info = "Accent", success = "Good", warn = "Bad", error = "Bad" })[kind] or "Accent"
	local icon = ({ info = "warn", success = "check", warn = "warn", error = "close" })[kind] or "warn"
	local row = new("Frame", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	round(row, 8)
	outline(row, win.Theme[token], 1, 0.65)
	paint(win, row, "BackgroundColor3", "Inset")
	pad(row, 12, 12, 10, 10)
	vlist(row, 4)
	local head = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = row })
	local ic = drawIcon(head, icon, 14, win.Theme[token], win)
	ic.Frame.Position = UDim2.fromOffset(0, 2)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 0),
		Size = UDim2.new(1, -22, 1, 0), Font = Enum.Font.GothamBold, TextSize = 12,
		TextColor3 = win.Theme[token], TextXAlignment = Enum.TextXAlignment.Left,
		Text = opts.Title or "Notice", Parent = head,
	})
	paint(win, head:FindFirstChildOfClass("TextLabel"), "TextColor3", token)
	if opts.Text then
		local body = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 11,
			TextColor3 = win.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
			Text = opts.Text, LayoutOrder = 2, Parent = row,
		})
		paint(win, body, "TextColor3", "Sub")
	end
	if opts.Pulse then Motion.Wiggle(ic.Frame, win, { Amplitude = 6, Speed = 3 }) end
	local api: any = { Instance = row }
	function api:Dismiss()
		Motion.Tween(row, 0.2, { BackgroundTransparency = 1 })
		later(0.22, row, function() row.Visible = false end)
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Segmented meter (signal bars, quality levels, ...)
-- ---------------------------------------------------------------------
function Card:AddMeter(opts: any)
	opts = opts or {}
	local win = self.Window
	local count = opts.Segments or 10
	local value = math.clamp(opts.Default or 0, 0, count)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -140, 1, 0),
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Name or "Level", Parent = row,
	})
	local holder = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(132, 18), Parent = row,
	})
	local l = hlist(holder, 3, Enum.VerticalAlignment.Center)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	local segs = {}
	local api: any = { Instance = row }
	for i = 1, count do
		local seg = new("Frame", {
			BackgroundColor3 = win.Theme.Stroke2, BorderSizePixel = 0,
			Size = UDim2.fromOffset(math.max(4, 126 / count - 3), 14), LayoutOrder = i, Parent = holder,
		})
		round(seg, 2)
		segs[i] = seg
		local hit = new("TextButton", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
			AutoButtonColor = false, Parent = seg,
		})
		hit.Activated:Connect(function() api:Set(i, true) end)
	end
	function api:Get() return value end
	function api:Set(v: any, fire: any)
		local nv = math.clamp(math.floor(tonumber(v) or 0), 0, count)
		local changed = nv ~= value
		value = nv
		for i, seg in ipairs(segs) do
			local on = i <= value
			later(math.min(math.abs(i - value) * 0.02, 0.2), seg, function()
				Motion.Spring(seg, "BackgroundColor3", on and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win)
					:To(on and win.Theme.Accent or win.Theme.Stroke2)
			end)
		end
		if changed and fire and opts.Callback then task.spawn(function() pcall(opts.Callback, value) end) end
	end
	api:Set(value, false)
	self.Elements[#self.Elements + 1] = api
	return api
end

