-- Returns `any`: the concrete Instance class depends on `class`, and letting
-- Luau infer a union of every GUI class used in this file blows its budget.
local function new(class: string, props: any, children: any?): any
	local obj = Instance.new(class)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else obj[k] = v end
	end
	for _, child in ipairs(children or {}) do child.Parent = obj end
	obj.Parent = parent
	return obj
end

