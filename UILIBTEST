-- ---------------------------------------------------------------------
-- Linear progress with an animated fill and an optional shimmer
-- ---------------------------------------------------------------------
function Card:AddProgress(opts: any)
	opts = opts or {}
	local win = self.Window
	local value = math.clamp(opts.Default or 0, 0, 1)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Label and 36 or 18),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local pct
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, -50, 0, 16),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
		pct = new("TextLabel", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(48, 16),
			Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = win.Theme.Accent,
			TextXAlignment = Enum.TextXAlignment.Right, Text = "", Parent = row,
		})
		paint(win, pct, "TextColor3", "Accent")
	end
	local track = new("Frame", {
		BackgroundColor3 = win.Theme.Stroke2, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, opts.Label and 22 or 6),
		Size = UDim2.new(1, 0, 0, opts.Thickness or 6), ClipsDescendants = true, Parent = row,
	})
	pill(track)
	paint(win, track, "BackgroundColor3", "Stroke2")
	local fill = new("Frame", {
		BackgroundColor3 = opts.Token and win.Theme[opts.Token] or win.Theme.Accent,
		BorderSizePixel = 0, Size = UDim2.fromScale(value, 1), Parent = track,
	})
	pill(fill)
	paint(win, fill, "BackgroundColor3", opts.Token or "Accent")
	local fs = Motion.Spring(fill, "Size", fill.Size, "UI", win)
	fs:Snap(fill.Size)
	if opts.Shimmer ~= false then Motion.Shimmer(fill, win, { Period = 2.6, Strength = 0.72, Width = 60 }) end
	local api: any = { Instance = row }
	function api:Get() return value end
	function api:Set(v: any, fire: any)
		local nv = math.clamp(tonumber(v) or 0, 0, 1)
		local changed = math.abs(nv - value) > 1e-6
		value = nv
		fs:To(UDim2.fromScale(value, 1))
		if pct then
			Motion.CountTo(pct, tonumber(pct.Text:match("%d+")) or 0, math.floor(value * 100 + 0.5), win,
				{ Suffix = "%", Preset = "Snappy" })
		end
		if changed and fire ~= false and opts.Callback then task.spawn(function() pcall(opts.Callback, value) end) end
	end
	api:Set(value, false)
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Ring / donut gauge, drawn from rotated segments (no images)
-- ---------------------------------------------------------------------
function Card:AddRing(opts: any)
	opts = opts or {}
	local win = self.Window
	local size = opts.Size or 96
	local segments = opts.Segments or 40
	local thickness = opts.Thickness or 8
	local value = math.clamp(opts.Default or 0, 0, 1)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Height or (size + 8)),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local holder = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size, size), Parent = row,
	})
	local hs = scaler(holder, 1)
	local segs = {}
	for i = 1, segments do
		local a = (i - 1) / segments * math.pi * 2 - math.pi / 2
		local seg = new("Frame", {
			BackgroundColor3 = win.Theme.Stroke2, BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(size / 2 + math.cos(a) * (size / 2 - thickness / 2), size / 2 + math.sin(a) * (size / 2 - thickness / 2)),
			Size = UDim2.fromOffset(thickness, math.max(3, size * math.pi / segments * 0.85)),
			Rotation = math.deg(a) + 90, Parent = holder,
		})
		pill(seg)
		segs[i] = seg
	end
	local center = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold, TextSize = opts.TextSize or 18,
		TextColor3 = win.Theme.Text, Text = "", Parent = holder,
	})
	paint(win, center, "TextColor3", "Text")
	if opts.Caption then
		new("TextLabel", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.5, 10), Size = UDim2.new(1, 0, 0, 14),
			Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = win.Theme.Dim,
			Text = opts.Caption, Parent = holder,
		})
	end
	local api: any = { Instance = row }
	function api:Get() return value end
	function api:Set(v: any, fire: any)
		local nv = math.clamp(tonumber(v) or 0, 0, 1)
		value = nv
		local lit = math.floor(nv * segments + 0.5)
		for i, seg in ipairs(segs) do
			local on = i <= lit
			later(math.min(i * 0.008, 0.25), seg, function()
				Motion.Spring(seg, "BackgroundColor3", on and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win)
					:To(on and win.Theme.Accent or win.Theme.Stroke2)
			end)
		end
		Motion.CountTo(center, tonumber(center.Text:match("%d+")) or 0, math.floor(nv * 100 + 0.5), win, { Suffix = "%" })
		Motion.Pop(hs, win, { From = 0.94, Overshoot = 1.03 })
		if fire and opts.Callback then task.spawn(function() pcall(opts.Callback, value) end) end
	end
	api:Set(value, false)
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Sparkline / bar chart from plain numbers
-- ---------------------------------------------------------------------
function Card:AddChart(opts: any)
	opts = opts or {}
	local win = self.Window
	local data = opts.Data or { 4, 8, 6, 12, 9, 14, 11, 16 }
	local height = opts.Height or 90
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height + (opts.Label and 18 or 0)),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local plot = new("Frame", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, opts.Label and 18 or 0),
		Size = UDim2.new(1, 0, 0, height), ClipsDescendants = true, Parent = row,
	})
	round(plot, 8)
	paint(win, plot, "BackgroundColor3", "Inset")
	pad(plot, 10, 10, 10, 10)
	local barsHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = plot })
	local l = hlist(barsHolder, opts.Gap or 4, Enum.VerticalAlignment.Bottom)
	l.VerticalAlignment = Enum.VerticalAlignment.Bottom
	local bars = {}
	local api: any = { Instance = row }
	local function build()
		for _, c in ipairs(barsHolder:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		bars = {}
		local maxV = 1e-6
		for _, d in ipairs(data) do maxV = math.max(maxV, math.abs(d)) end
		for i, d in ipairs(data) do
			local frac = math.clamp(math.abs(d) / maxV, 0.02, 1)
			local bar = new("Frame", {
				BackgroundColor3 = (opts.Highlight and i == opts.Highlight) and win.Theme.AccentHi or win.Theme.Accent,
				BackgroundTransparency = (opts.Highlight and i ~= opts.Highlight) and 0.45 or 0,
				BorderSizePixel = 0, LayoutOrder = i,
				Size = UDim2.new(1 / math.max(#data, 1), -(opts.Gap or 4), 0, 0), Parent = barsHolder,
			})
			round(bar, 3)
			bars[i] = bar
			later(math.min(i * 0.03, 0.4), bar, function()
				Motion.Spring(bar, "Size", UDim2.new(1 / math.max(#data, 1), -(opts.Gap or 4), frac, 0), "Groovy", win)
					:To(UDim2.new(1 / math.max(#data, 1), -(opts.Gap or 4), frac, 0))
			end)
			local hit = new("TextButton", {
				BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
				AutoButtonColor = false, Parent = bar,
			})
			hit.MouseEnter:Connect(function()
				Motion.Spring(bar, "BackgroundTransparency", 0, "Snappy", win):To(0)
				if opts.Tooltip ~= false then win:Tooltip(bar, (opts.Names and opts.Names[i] or ("#" .. i)) .. ": " .. tostring(d)) end
			end)
			hit.MouseLeave:Connect(function()
				Motion.Spring(bar, "BackgroundTransparency", (opts.Highlight and i ~= opts.Highlight) and 0.45 or 0, "Snappy", win)
					:To((opts.Highlight and i ~= opts.Highlight) and 0.45 or 0)
				win:HideTooltip()
			end)
		end
	end
	function api:Get() return data end
	function api:SetData(d: any) data = d or {}; build() end
	api.Set = api.SetData
	build()
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- KPI tiles with count-up numbers
-- ---------------------------------------------------------------------
function Card:AddStatTiles(opts: any)
	opts = opts or {}
	local win = self.Window
	local tiles = opts.Tiles or {}
	local perRow = opts.PerRow or 3
	local rows = math.ceil(#tiles / perRow)
	local tileH = opts.TileHeight or 66
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, rows * tileH + (rows - 1) * 8),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	vlist(row, 8)
	local api: any = { Instance = row, Tiles = {} }
	local index = 0
	for r = 1, rows do
		local line = new("Frame", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, tileH), LayoutOrder = r, Parent = row,
		})
		hlist(line, 8, Enum.VerticalAlignment.Top)
		local inThis = math.min(perRow, #tiles - index)
		for c = 1, inThis do
			index += 1
			local t = tiles[index]
			local tile = new("Frame", {
				BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
				Size = UDim2.new(1 / inThis, -8 * (inThis - 1) / inThis, 1, 0),
				LayoutOrder = c, Parent = line,
			})
			round(tile, 8)
			outline(tile, win.Theme.Stroke, 1, 0.5)
			paint(win, tile, "BackgroundColor3", "Inset")
			local ts = scaler(tile, 1)
			new("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 9),
				Size = UDim2.new(1, -24, 0, 13), Font = Enum.Font.GothamBold, TextSize = 10,
				TextColor3 = win.Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left,
				Text = string.upper(t.Label or ""), Parent = tile,
			})
			local valueLabel = new("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 24),
				Size = UDim2.new(1, -24, 0, 24), Font = Enum.Font.GothamBold, TextSize = 20,
				TextColor3 = t.Token and win.Theme[t.Token] or win.Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, Text = "0", Parent = tile,
			})
			paint(win, valueLabel, "TextColor3", t.Token or "Text")
			if t.Sub then
				new("TextLabel", {
					BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 48),
					Size = UDim2.new(1, -24, 0, 12), Font = Enum.Font.Gotham, TextSize = 10,
					TextColor3 = win.Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left,
					Text = t.Sub, Parent = tile,
				})
			end
			tile.MouseEnter:Connect(function()
				Motion.Spring(ts, "Scale", 1.025, "Bouncy", win):To(1.025)
				Motion.Spring(tile, "BackgroundColor3", win.Theme.Row, "Snappy", win):To(win.Theme.Row)
			end)
			tile.MouseLeave:Connect(function()
				Motion.Spring(ts, "Scale", 1, "Bouncy", win):To(1)
				Motion.Spring(tile, "BackgroundColor3", win.Theme.Inset, "Snappy", win):To(win.Theme.Inset)
			end)
			local entry: any = { Label = valueLabel, Frame = tile }
			function entry:Set(v: any)
				Motion.CountTo(valueLabel, tonumber((valueLabel.Text:gsub("%D", ""))) or 0, tonumber(v) or 0, win,
					{ Suffix = t.Suffix or "", Prefix = t.Prefix or "" })
			end
			api.Tiles[index] = entry
			later(math.min(index * 0.06, 0.5), tile, function()
				Motion.SlideIn(tile, win, { Y = 12 })
				entry:Set(t.Value or 0)
			end)
		end
	end
	function api:Get()
		local out = {}
		for i, t in ipairs(tiles) do out[i] = t.Value end
		return out
	end
	function api:Set(i: any, v: any)
		if api.Tiles[i] then tiles[i].Value = v; api.Tiles[i]:Set(v) end
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

