-- slider (overlay panels use these)
function Card:AddSlider(opts: any)
	opts = opts or {}
	local win = self.Window
	local min, max = opts.Min or 0, opts.Max or 100
	if max <= min then max = min + 1 end
	local step = math.max(1e-4, opts.Step or 1)
	local range = max - min
	local value = math.clamp(opts.Default or min, min, max)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 16),
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Name or "Slider", Parent = row,
	})
	local vl = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(58, 16),
		Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = win.Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(value) .. (opts.Suffix or ""), Parent = row,
	})
	paint(win, vl, "TextColor3", "Accent")
	local track = new("Frame", {
		BackgroundColor3 = win.Theme.Stroke2, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 5), Parent = row,
	})
	pill(track)
	paint(win, track, "BackgroundColor3", "Stroke2")
	local a0 = (value - min) / range
	local fill = new("Frame", {
		BackgroundColor3 = win.Theme.Accent, BorderSizePixel = 0,
		Size = UDim2.fromScale(a0, 1), Parent = track,
	})
	pill(fill)
	paint(win, fill, "BackgroundColor3", "Accent")
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(a0, 0.5),
		Size = UDim2.fromOffset(13, 13), BackgroundColor3 = Color3.fromRGB(250, 252, 255),
		BorderSizePixel = 0, Parent = track,
	})
	pill(knob)
	local ks = scaler(knob, 1)
	-- Generous hit area, and Active so it reliably owns the press. The old
	-- 25px strip sat only around the track, so grabbing the knob was fiddly.
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(-8, -14),
		Size = UDim2.new(1, 16, 0, 34), Text = "", Active = true,
		AutoButtonColor = false, ZIndex = 5, Parent = track,
	})
	local fs = Motion.Spring(fill, "Size", fill.Size, "Snappy", win); fs:Snap(fill.Size)
	local ksp = Motion.Spring(knob, "Position", knob.Position, "Snappy", win); ksp:Snap(knob.Position)
	local sliding = false
	local api: any = { Instance = row }
	function api:Set(v: any, fire: any)
		local nv = math.floor(((tonumber(v) or min) - min) / step + 0.5) * step + min
		nv = math.clamp(nv, min, max)
		local changed = nv ~= value
		value = nv
		local a = (value - min) / range
		vl.Text = tostring(math.floor(value * 1000 + 0.5) / 1000) .. (opts.Suffix or "")
		fs:To(UDim2.fromScale(a, 1)); ksp:To(UDim2.fromScale(a, 0.5))
		if fire ~= false and changed and opts.Callback then
			task.spawn(function() pcall(opts.Callback, value) end)
		end
	end
	function api:Get() return value end
	local function fromInput(i: any)
		local as = track.AbsoluteSize
		if as.X <= 0 then return end
		local mousePos = UserInputService:GetMouseLocation()
		local x = (i and i.Position and i.Position.X ~= 0) and i.Position.X or mousePos.X
		api:Set(min + math.clamp((x - track.AbsolutePosition.X) / as.X, 0, 1) * range, true)
	end
	local function isDrag(t: any)
		return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
	end
	local function isPress(t: any)
		return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
	end
	local moveConn = nil
	local releaseConn = nil
	local function stopDrag()
		if not sliding then return end
		sliding = false
		Motion.Spring(ks, "Scale", 1, "UI", win):To(1)
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if releaseConn then releaseConn:Disconnect(); releaseConn = nil end
		if opts.OnCommit then task.spawn(function() pcall(opts.OnCommit, value) end) end
	end
	local function startDrag(i: any)
		sliding = true
		Motion.Spring(ks, "Scale", 1.25, "UI", win):To(1.25)
		fromInput(i)
		if not moveConn then
			moveConn = UserInputService.InputChanged:Connect(function(inp: any)
				if sliding and isDrag(inp.UserInputType) then fromInput(inp) end
			end)
		end
		if not releaseConn then
			releaseConn = UserInputService.InputEnded:Connect(function(inp: any)
				if isPress(inp.UserInputType) then stopDrag() end
			end)
		end
	end
	connect(win, hit.InputBegan, function(i: any)
		if isPress(i.UserInputType) then startDrag(i) end
	end)
	connect(win, hit.InputEnded, function(i: any)
		if isPress(i.UserInputType) then stopDrag() end
	end)
	self.Elements[#self.Elements + 1] = api
	return api
end

