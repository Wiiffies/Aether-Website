-- =====================================================================
-- 4 · MOTION ENGINE  ·  one loop, real springs, fixed sub-steps
-- =====================================================================

local Aether

local PRESET = {
	-- { stiffness, damping }. Critical damping is 2*sqrt(k); every preset
	-- below sits at zeta ~= 0.98 so it lands once and stops. The old values
	-- were badly under-damped (Groovy was zeta 0.41 = 24% overshoot), which
	-- is what made everything wobble and feel cheap.
	Snappy = { 480, 43 },  -- zeta 0.98  ~0.19s settle, no overshoot
	UI     = { 340, 36 },  -- zeta 0.98  default for hover / press / layout
	Bouncy = { 300, 24 },  -- zeta 0.69  deliberate playful pop, ~5% overshoot
	Groovy = { 190, 27 },  -- zeta 0.98  smooth entry, NO wobble
	Soft   = { 220, 29 },  -- zeta 0.98  colour crossfades
	Glide  = { 150, 25 },  -- zeta 1.02  overdamped, large surfaces
}

local Motion = {
	-- Exposed so the spring tuning is inspectable and testable.
	Presets = PRESET,
	Springs = {},
	Alive = false,
	FPS = 60,
	Reduce = false,
	Speed = 1,
	Time = 0,
	_tick = nil,
	_conn = nil,
	_fpsT = 0, _fpsN = 0,
}

local function decompose(v: any)
	local ty = typeof(v)
	if ty == "number" then return { v }, "number" end
	if ty == "UDim2" then return { v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset }, "UDim2" end
	if ty == "UDim" then return { v.Scale, v.Offset }, "UDim" end
	if ty == "Vector2" then return { v.X, v.Y }, "Vector2" end
	if ty == "Color3" then return { v.R, v.G, v.B }, "Color3" end
	return nil, ty
end

local function recompose(kind: any, c: any)
	if kind == "number" then return c[1] end
	if kind == "UDim2" then return UDim2.new(c[1], c[2], c[3], c[4]) end
	if kind == "UDim" then return UDim.new(c[1], c[2]) end
	if kind == "Vector2" then return Vector2.new(c[1], c[2]) end
	if kind == "Color3" then return Color3.new(c[1], c[2], c[3]) end
	return nil
end

-- per-channel rest tolerance (scale/color channels need to be tighter)
local EPS = {
	number = { 1e-4 },
	UDim2  = { 1e-5, 0.02, 1e-5, 0.02 },
	UDim   = { 1e-5, 0.02 },
	Vector2 = { 0.02, 0.02 },
	Color3 = { 0.002, 0.002, 0.002 },
}

local function channelsOf(kind: any, v: any)
	local c = decompose(v)
	if c then return c end
	local n = #EPS[kind]
	local out = {}
	for i = 1, n do out[i] = tonumber(v) or 0 end
	return out
end

local Spring = {}
Spring.__index = Spring

local function syncTargets(s: any)
	local c, kind = decompose(s.Target)
	if not c or kind ~= s.Kind then
		-- type changed under us: hard snap, never mix types
		s.Kind = kind or s.Kind
		s.Eps = EPS[s.Kind] or EPS.number
		c = channelsOf(s.Kind, s.Target)
		s.V = table.clone(c)
		s.Vel = {}
		for i = 1, #c do s.Vel[i] = 0 end
	end
	s.T = c
end

function Spring:To(target: any)
	self.Target = target
	syncTargets(self)
	if Motion.Reduce then return self:Snap(target) end
	if not self.Running then
		self.Running = true
		Motion.Springs[self] = true
		Motion.Wake()
	end
	return self
end

function Spring:Snap(value: any)
	if value ~= nil then self.Value, self.Target = value, value end
	local c, kind = decompose(self.Target)
	if c then
		self.Kind = kind
		self.Eps = EPS[kind] or EPS.number
		self.T = table.clone(c)
		self.V = table.clone(c)
		self.Vel = {}
		for i = 1, #c do self.Vel[i] = 0 end
		self.Value = recompose(kind, self.V)
	end
	self.Running = false
	Motion.Springs[self] = nil
	if self.Object and self.Object.Parent then
		self.Object[self.Property] = self.Value
	end
	if self.OnStep then self.OnStep(self.Value) end
	return self
end

function Spring:Kick(velocity: any)
	local vk = typeof(velocity)
	if vk == self.Kind then
		self.Vel = decompose(velocity) or self.Vel
	elseif self.Kind == "UDim2" then
		local n = tonumber(velocity) or 0
		self.Vel = { 0, n, 0, 0 }
	elseif self.Kind == "UDim" then
		self.Vel = { 0, tonumber(velocity) or 0 }
	else
		local n = tonumber(velocity) or 0
		for i = 1, #self.Vel do self.Vel[i] = n end
	end
	if not Motion.Reduce then
		self.Running = true
		Motion.Springs[self] = true
		Motion.Wake()
	end
	return self
end

function Spring:Stop()
	self.Running = false
	self.Dead = true
	Motion.Springs[self] = nil
end

local function springStep(s: any, dt: any)
	local obj = s.Object
	if s.Dead or (obj and not obj.Parent) then
		s.Running = false
		Motion.Springs[s] = nil
		return
	end
	-- fixed sub-steps: identical behaviour at 30, 60 or 240 FPS, and a
	-- long frame (alt-tab) can never make a spring explode.
	local steps = math.clamp(math.ceil(dt / (1 / 120)), 1, 8)
	local h = dt / steps
	local k, d, m = s.Stiffness, s.Damping, s.Mass
	local V, T, Vel, n = s.V, s.T, s.Vel, #s.V
	for _ = 1, steps do
		for i = 1, n do
			local a = (-k * (V[i] - T[i]) - d * Vel[i]) / m
			Vel[i] += a * h
			V[i] += Vel[i] * h
		end
	end
	local settled = true
	for i = 1, n do
		local e = s.Eps[i] or 1e-4
		if math.abs(V[i] - T[i]) > e or math.abs(Vel[i]) > e * 20 then
			settled = false
			break
		end
	end
	if settled then
		for i = 1, n do V[i] = T[i]; Vel[i] = 0 end
		s.Running = false
		Motion.Springs[s] = nil
	end
	s.Value = recompose(s.Kind, V)
	if obj then obj[s.Property] = s.Value end
	if s.OnStep then s.OnStep(s.Value) end
end

function Motion.Wake()
	if Motion.Alive then return end
	Motion.Alive = true
	if Motion._conn then return end
	Motion._conn = RunService.RenderStepped:Connect(function(rawDt)
		local dt = math.min(rawDt, 1 / 20) * Motion.Speed
		Motion.Time += dt

		Motion._fpsT += rawDt
		Motion._fpsN += 1
		if Motion._fpsT >= 0.4 then
			Motion.FPS = math.floor(Motion._fpsN / Motion._fpsT + 0.5)
			Motion._fpsT, Motion._fpsN = 0, 0
		end

		local active = 0
		for s in pairs(Motion.Springs) do
			active += 1
			local ok, err = pcall(springStep, s, dt)
			if not ok then
				Motion.Springs[s] = nil
				warn("[AetherUI spring] " .. tostring(err))
			end
		end

		if Motion._tick then
			local ok, err = pcall(Motion._tick, dt, Motion.Time)
			if not ok then warn("[AetherUI tick] " .. tostring(err)) end
		end

		-- idle -> disconnect entirely (zero cost when nothing moves)
		local needsTick = false
		if Motion._tick then
			for _, w in ipairs(Aether.Windows) do
				if w.Alive and #w._tickers > 0 then needsTick = true; break end
				if w.Alive and w.Groovy and (w.Visible or w.Minimized) then needsTick = true; break end
				if w.Alive and w.Particles and w.Visible then needsTick = true; break end
			end
		end
		if active == 0 and not needsTick and not next(Motion.Springs) then
			Motion.Alive = false
			if Motion._conn then
				Motion._conn:Disconnect()
				Motion._conn = nil
			end
		end
	end)
end

-- One live spring per (object, property). Without this, every MouseEnter and
-- every drag release created ANOTHER spring driving the same property, and
-- they fought each other - that was the "window teleports while dragging" bug.
Motion._registry = Motion._registry or setmetatable({}, { __mode = "k" })

function Spring:SetPreset(preset: any)
	local p = PRESET[preset or "UI"] or PRESET.UI
	self.Stiffness, self.Damping = p[1], p[2]
	return self
end

-- Stop a spring and leave the object exactly where it currently is.
-- Drop every spring that TARGETS an object, optionally its whole subtree.
-- Motion.Kill works by owner; this works by object, which is what you need
-- when a subtree is destroyed and the registry must not keep it alive.
function Motion.Forget(object: any, recursive: any)
	local function drop(obj: any)
		local byProp = Motion._registry[obj]
		if byProp then
			for _, s in pairs(byProp) do
				s.Dead = true
				s.Running = false
				Motion.Springs[s] = nil
			end
			Motion._registry[obj] = nil
		end
		for s in pairs(Motion.Springs) do
			if s.Object == obj then s:Stop() end
		end
	end
	drop(object)
	if recursive and object.GetDescendants then
		for _, d in ipairs(object:GetDescendants()) do drop(d) end
	end
end

function Motion.Stop(object: any, property: any)
	local byProp = Motion._registry[object]
	if not byProp then return end
	if property then
		local s = byProp[property]
		if s then s.Running = false; Motion.Springs[s] = nil end
	else
		for _, s in pairs(byProp) do s.Running = false; Motion.Springs[s] = nil end
	end
end

function Motion.Spring(object: any, property: any, target: any, preset: any, owner: any, onStep: any)
	-- Value-only springs (onStep) are always independent.
	if object and property and not onStep then
		local byProp = Motion._registry[object]
		local existing = byProp and byProp[property]
		if existing and not existing.Dead and existing.Owner == owner then
			existing:SetPreset(preset)
			return existing
		end
	end
	local p = PRESET[preset or "UI"] or PRESET.UI
	local initial = target
	if object then
		local ok, current = pcall(function() return object[property] end)
		if ok and current ~= nil then initial = current end
	end
	local channels, kind = decompose(initial)
	if not channels then
		channels, kind = decompose(target)
		initial = target
	end
	if not channels then
		-- unsupported type: fall back to a direct assignment, never a crash
		if object then pcall(function() object[property] = target end) end
		channels, kind = { 0 }, "number"
	end
	local s = setmetatable({
		Object = object, Property = property,
		Value = initial, Target = target,
		Kind = kind, Eps = EPS[kind] or EPS.number,
		V = table.clone(channels), T = table.clone(channels),
		Vel = {}, Stiffness = p[1], Damping = p[2], Mass = 1,
		Running = false, Owner = owner, OnStep = onStep,
	}, Spring)
	for i = 1, #channels do s.Vel[i] = 0 end
	syncTargets(s)
	if object and property and not onStep then
		local byProp = Motion._registry[object]
		if not byProp then byProp = {}; Motion._registry[object] = byProp end
		byProp[property] = s
	end
	if Motion.Reduce then s:Snap(target) end
	return s
end

function Motion.Value(initial: any, onStep: any, preset: any, owner: any)
	return Motion.Spring(nil, nil, initial, preset, owner, onStep)
end

function Motion.Kill(owner: any)
	for s in pairs(Motion.Springs) do
		if s.Owner == owner then s:Stop() end
	end
	for object, byProp in pairs(Motion._registry) do
		for prop, s in pairs(byProp) do
			if s.Owner == owner then
				s.Dead = true
				byProp[prop] = nil
			end
		end
		if next(byProp) == nil then Motion._registry[object] = nil end
	end
end

function Motion.Tween(object: any, time: any, props: any, style: any, dir: any)
	if Motion.Reduce then
		for k, v in pairs(props) do object[k] = v end
		return nil
	end
	-- Claim the properties: a live spring and a TweenService tween writing the
	-- same property fight each other and produce visible jitter.
	for k in pairs(props) do Motion.Stop(object, k) end
	local t = TweenService:Create(
		object,
		TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

-- delayed helper that never fires on a destroyed object
local function later(delay: any, object: any, fn: any)
	task.delay(delay, function()
		if object and not object.Parent then return end
		local ok, err = pcall(fn)
		if not ok then warn("[AetherUI] " .. tostring(err)) end
	end)
end
