-- Register your own element once, then call card:MyThing{...} everywhere.
function Aether:RegisterElement(name: any, builder: any)
	assert(type(name) == "string" and type(builder) == "function", "RegisterElement(name, fn)")
	Card[name] = function(self, opts)
		local win = self.Window
		local result = builder(self, opts or {}, {
			Window = win, Theme = win.Theme, Motion = Motion, New = new,
			Round = round, Pill = pill, Outline = outline, Pad = pad,
			VList = vlist, HList = hlist, Scaler = scaler, Icon = drawIcon,
			Paint = paint, Later = later, Action = actionButton, Toggle = makeToggle,
			NextOrder = nextOrder, TextWidth = textWidth, Ripple = ripple,
		})
		if type(result) == "table" then
			self.Elements[#self.Elements + 1] = result
		end
		return result
	end
	return Card[name]
end

-- Add a theme at runtime. Missing tokens fall back to Midnight.
function Aether:AddTheme(name: any, palette: any)
	assert(type(name) == "string", "AddTheme(name, palette)")
	local base = THEMES.Midnight
	local merged = {}
	for k, v in pairs(base) do merged[k] = v end
	for k, v in pairs(palette or {}) do merged[k] = v end
	merged.SegSel = palette.SegSel or merged.SelStroke
	merged.PanelBody = palette.PanelBody or merged.Inset
	THEMES[name] = merged
	local found = false
	for _, n in ipairs(THEME_ORDER) do if n == name then found = true end end
	if not found then THEME_ORDER[#THEME_ORDER + 1] = name end
	return merged
end

function Aether:GetTheme(name: any) return THEMES[name] end
function Aether:ListThemes() return table.clone(THEME_ORDER) end

-- Snapshot / restore every element that exposes Get and Set.
function Window:Snapshot()
	local out = {}
	local function walk(host: any, path: any)
		for i, e in ipairs(host.Elements or {}) do
			if type(e.Get) == "function" and type(e.Set) == "function" then
				local ok, v = pcall(e.Get)
				if ok and v ~= nil and type(v) ~= "table" then out[path .. ":" .. i] = v end
			end
			if e.Elements then walk(e, path .. ":" .. i) end
		end
	end
	for t, tab in ipairs(self.Tabs) do
		for c, card in ipairs(tab.Cards) do walk(card, t .. "." .. c) end
	end
	return out
end

function Window:RestoreSnapshot(state: any)
	local applied = 0
	local function walk(host: any, path: any)
		for i, e in ipairs(host.Elements or {}) do
			local key = path .. ":" .. i
			if state[key] ~= nil and type(e.Set) == "function" then
				if pcall(e.Set, e, state[key], false) then applied += 1 end
			end
			if e.Elements then walk(e, path .. ":" .. i) end
		end
	end
	for t, tab in ipairs(self.Tabs) do
		for c, card in ipairs(tab.Cards) do walk(card, t .. "." .. c) end
	end
	return applied
end

-- =====================================================================
-- 13b · SELF-TEST  ·  Aether:SelfTest(window, options)
-- ---------------------------------------------------------------------
-- A real in-game test runner. It builds a throw-away category, puts one of
-- every widget on it, round-trips every input, fires every animation, then
-- deletes the category and restores whatever tab/theme you were on.
--
--   local report = Aether:SelfTest(win, {
--       Group = "Inputs",                  -- omit to run everything
--       Log   = function(name, ok, detail)  -- stream results anywhere
--           print((ok and "PASS " or "FAIL ") .. name)
--       end,
--       Notify = true,                     -- summary toast (default true)
--   })
--   print(report.Passed, report.Failed)
--
-- Nothing here needs Studio or a test framework: press the button in the
-- demo and read the console. Every check is wrapped in pcall, so one broken
-- widget reports a failure instead of killing the run.
-- =====================================================================

local SELFTEST_GROUPS = { "Window", "Tabs", "Inputs", "Display", "Containers", "Motion", "Overlay", "Theme", "Drag" }

function Aether:SelfTest(win: any, opts: any)
	opts = opts or {}
	win = win or self.Windows[1]
	local report = { Passed = 0, Failed = 0, Total = 0, Results = {}, Groups = {}, Started = os.clock() }
	if not win or win._destroyed then
		report.Failed = 1
		report.Total = 1
		report.Results[1] = { Group = "Window", Name = "a live window exists", Ok = false, Detail = "no window" }
		return report
	end

	local log = opts.Log
	local currentGroup = "-"
	local function check(name: any, fn: any)
		report.Total += 1
		local ok, res = pcall(fn)
		local passed = ok and res ~= false
		local detail
		if not ok then
			detail = tostring(res)
		elseif type(res) == "string" then
			detail = res
		end
		if passed then report.Passed += 1 else report.Failed += 1 end
		local g = report.Groups[currentGroup] or { Passed = 0, Failed = 0 }
		if passed then g.Passed += 1 else g.Failed += 1 end
		report.Groups[currentGroup] = g
		report.Results[#report.Results + 1] = { Group = currentGroup, Name = name, Ok = passed, Detail = detail }
		if log then
			task.spawn(function() pcall(log, name, passed, detail, currentGroup) end)
		end
	end
	local function group(name: any)
		currentGroup = name
		return not opts.Group or opts.Group == name or opts.Group == "all"
	end
	local function expect(cond: any, msg: any)
		if not cond then error(msg or "expectation failed", 2) end
	end

	-- Remember what to put back afterwards.
	local originalTab = win.ActiveTab
	local originalTheme = win.ThemeName
	local scratch, card
	local madePanels, madePills = {}, {}

	local function buildScratch()
		if scratch then return scratch end
		scratch = win:AddTab({ Name = "Self-test", Icon = "bolt" })
		card = scratch:AddCard({ Height = 600, Scroll = true })
		card:SetHeader({ Title = "Self-test", Caption = "Temporary. Removed when the run finishes." })
		win:SetActiveTab(scratch)
		return scratch
	end

	-- ------------------------------------------------------------------
	if group("Window") then
		check("ScreenGui is parented", function()
			expect(win.Gui and win.Gui.Parent, "ScreenGui has no parent")
		end)
		check("window root is visible", function()
			expect(win.Root and win.Root.Visible, "root frame missing or hidden")
		end)
		check("window fits inside the viewport", function()
			local vp = viewport()
			expect(win.Root.AbsoluteSize.X <= vp.X + 1, "window wider than the screen")
			expect(win.Root.AbsoluteSize.Y <= vp.Y + 1, "window taller than the screen")
		end)
		check("every documented window method exists", function()
			local need = {
				"AddTab", "SetActiveTab", "AddTicker", "SetFooter", "Show", "Hide", "Toggle",
				"Minimize", "Restore", "ToggleSize", "AddOverlayPanel", "SetOverlayVisible",
				"ToggleOverlay", "ResetLayout", "SetOverlayOpacity", "ShowLayout", "HideLayout",
				"Notify", "SetTheme", "SetKey", "SetOverlayKey", "Destroy", "Tooltip",
				"HideTooltip", "ContextMenu", "ShowContextMenu", "HideContextMenu", "Confirm",
				"Prompt", "AddCommand", "ShowCommandPalette", "AddStatusPill", "SetBusy",
				"AddDrawer", "Snapshot", "RestoreSnapshot",
			}
			local missing = {}
			for _, n in ipairs(need) do
				if type(win[n]) ~= "function" then missing[#missing + 1] = n end
			end
			expect(#missing == 0, "missing: " .. table.concat(missing, ", "))
			return #need .. " methods"
		end)
		check("hotkeys are bound", function()
			expect(win.ToggleKey ~= nil, "window key not set")
			expect(win.OverlayKeys and #win.OverlayKeys > 0, "no overlay key bound")
		end)
		check("show / hide / toggle round-trip", function()
			local was = win.Visible
			win:Hide()
			expect(win.Visible == false, "Hide() did not clear the flag")
			task.wait(0.3)
			expect(not win.Root.Visible, "Hide() did not hide the frame")
			win:Show()
			task.wait(0.3)
			expect(win.Visible == true and win.Root.Visible, "Show() did not show")
			win:Toggle()
			task.wait(0.3)
			win:Toggle()
			task.wait(0.3)
			expect(win.Visible == was, "Toggle() is not symmetrical")
		end)
		check("minimize / restore round-trip", function()
			win:Minimize()
			expect(win.Minimized, "Minimize() did not set the flag")
			win:Restore()
			expect(not win.Minimized, "Restore() did not clear the flag")
		end)
		check("footer accepts an update", function()
			win:SetFooter({ Left = "Self-test running..." })
			win:SetFooter({ Left = "Placeholder UI - nothing here talks to a server." })
		end)
		check("status pill can be created and retokenised", function()
			local p = win:AddStatusPill({ Text = "Testing", Token = "Accent", Offset = -240 })
			madePills[#madePills + 1] = p
			p:SetText("Still testing")
			p:SetToken("Good")
			expect(p.Instance ~= nil, "pill has no instance")
		end)
		check("busy flag toggles", function()
			win:SetBusy(true)
			win:SetBusy(false)
		end)
	end

	-- ------------------------------------------------------------------
	if group("Tabs") then
		check("at least one category exists", function()
			expect(#win.Tabs >= 1, "no tabs")
			return #win.Tabs .. " categories"
		end)
		check("a new category can be added", function()
			buildScratch()
			expect(scratch.Page ~= nil, "tab has no page")
			expect(scratch.Button ~= nil, "tab has no nav pill")
		end)
		check("switching tabs shows exactly one page", function()
			buildScratch()
			win:SetActiveTab(scratch)
			task.wait(0.2)
			local visible = 0
			for _, t in ipairs(win.Tabs) do
				if t.Page.Visible then visible += 1 end
			end
			expect(visible == 1, visible .. " pages visible, expected 1")
		end)
		check("every existing tab can be selected", function()
			for _, t in ipairs(win.Tabs) do
				win:SetActiveTab(t)
				expect(win.ActiveTab == t, "could not select " .. tostring(t.Name))
			end
			return #win.Tabs .. " tabs selected"
		end)
		check("Tab:Destroy removes the category and re-packs the nav", function()
			buildScratch()
			local n = #win.Tabs
			scratch:Destroy()
			scratch, card = nil, nil
			expect(#win.Tabs == n - 1, "tab count did not drop")
			for i, t in ipairs(win.Tabs) do
				expect(t.Order == i, "tab order not re-packed at " .. i)
			end
		end)
	end

	-- ------------------------------------------------------------------
	if group("Inputs") then
		buildScratch()
		check("slider round-trips and clamps", function()
			local e = card:AddSlider({ Name = "ST slider", Min = 0, Max = 10, Default = 5 })
			expect(e:Get() == 5, "default wrong")
			e:Set(99)
			expect(e:Get() == 10, "did not clamp high")
			e:Set(-99)
			expect(e:Get() == 0, "did not clamp low")
		end)
		check("toggle fires only on change", function()
			local fired = 0
			local e = card:AddToggleRow({ Name = "ST toggle", Default = false, Callback = function() fired += 1 end })
			e:Set(true)
			e:Set(true)
			expect(e:Get() == true, "value did not stick")
			expect(fired == 1, "callback fired " .. fired .. " times, expected 1")
		end)
		check("segmented control round-trips", function()
			local e = card:AddSegmented({ Label = "ST seg", Options = { "a", "b", "c" }, Default = "a" })
			e:Set("c")
			expect(e:Get() == "c", "segment did not stick")
		end)
		check("dropdown round-trips and opens / closes", function()
			local e = card:AddDropdown({ Label = "ST drop", Options = { "a", "b", "c" }, Default = "a" })
			e:Set("b")
			expect(e:Get() == "b", "value did not stick")
			e:SetOpen(true)
			expect(e.Open == true, "did not open")
			e:SetOpen(false)
			expect(e.Open == false, "did not close")
			e:Toggle()
			expect(e.Open == true, "Toggle did not open")
			e:Close()
			e:SetOptions({ "x", "y" })
			e:Set("y")
			expect(e:Get() == "y", "SetOptions broke the value")
		end)
		check("multi-select dropdown keeps a list", function()
			local e = card:AddDropdown({ Label = "ST multi", Multi = true, Search = true,
				Options = { "p", "q", "r" }, Default = { "p" } })
			e:Set({ "p", "r" })
			expect(type(e:Get()) == "table" and #e:Get() == 2, "multi value wrong")
		end)
		check("textbox round-trips, numeric mode returns a number", function()
			local e = card:AddTextbox({ Label = "ST text", Default = "hello" })
			e:SetText("world")
			expect(e:Get() == "world", "text did not stick")
			local n = card:AddTextbox({ Label = "ST num", Numeric = true, Default = "42" })
			expect(n:Get() == 42, "numeric textbox did not return 42")
		end)
		check("checkbox fires only on change", function()
			local fired = 0
			local e = card:AddCheckbox({ Name = "ST check", Default = false, Callback = function() fired += 1 end })
			e:Set(true)
			e:Set(true)
			expect(e:Get() == true and fired == 1, "checkbox misbehaved")
		end)
		check("radio group round-trips", function()
			local e = card:AddRadioGroup({ Label = "ST radio", Options = { "lo", "mid", "hi" }, Default = "mid" })
			e:Set("hi")
			expect(e:Get() == "hi", "radio did not stick")
		end)
		check("stepper snaps to step and clamps", function()
			local e = card:AddStepper({ Name = "ST step", Min = 0, Max = 10, Step = 2, Default = 4 })
			e:Set(7)
			expect(e:Get() == 8, "did not snap to the step")
			e:Set(99)
			expect(e:Get() == 10, "did not clamp")
		end)
		check("colour picker round-trips", function()
			local e = card:AddColorPicker({ Label = "ST colour", Default = Color3.fromRGB(255, 0, 0) })
			e:Set(Color3.fromRGB(0, 255, 0))
			local c = e:Get()
			expect(c.G > 0.9 and c.R < 0.1, "colour did not round-trip")
		end)
		check("search box round-trips", function()
			local e = card:AddSearchBox({ Placeholder = "Search..." })
			e:SetText("abc")
			expect(e:Get() == "abc", "search text did not stick")
		end)
		check("copy field round-trips", function()
			local e = card:AddCopyField({ Label = "ST copy", Text = "abc" })
			e:SetText("def")
			expect(e:Get() == "def", "copy text did not stick")
		end)
		check("rating clamps to its star count", function()
			local e = card:AddRating({ Label = "ST rate", Stars = 5, Default = 3 })
			e:Set(9)
			expect(e:Get() == 5, "did not clamp high")
			e:Set(-1)
			expect(e:Get() == 0, "did not clamp low")
		end)
		check("keybind captures and reports a key", function()
			local e = card:AddKeybind({ Label = "ST key", Default = Enum.KeyCode.F })
			expect(e:Get() == Enum.KeyCode.F, "default key wrong")
			e:Set(Enum.KeyCode.G)
			expect(e:Get() == Enum.KeyCode.G, "key did not stick")
		end)
		check("key row round-trips", function()
			local e = card:AddKeyRow({ Label = "ST key row", Default = Enum.KeyCode.H })
			expect(e:Get() == Enum.KeyCode.H, "key row default wrong")
		end)
		check("code box round-trips", function()
			local e = card:AddCodeBox({ Height = 80, Text = "print(1)" })
			expect(e:Get() == "print(1)", "code box text wrong")
		end)
	end

	-- ------------------------------------------------------------------
	if group("Display") then
		buildScratch()
		local function renders(name, fn)
			check(name .. " renders", function()
				local e = fn()
				expect(e ~= nil, "returned nil")
				local inst = (type(e) == "table" and e.Instance) or e
				expect(inst ~= nil, "no Instance")
			end)
		end
		renders("label", function() return card:AddLabel("Self-test label") end)
		renders("caption", function() return card:AddCaption("Self-test caption") end)
		renders("divider", function() return card:AddDivider() end)
		renders("spacer", function() return card:AddSpacer(6) end)
		renders("note", function() return card:AddNote("Self-test note") end)
		renders("section label", function() return card:AddSectionLabel("Section") end)
		renders("button bar", function()
			return card:AddButtonBar({ Align = "left", Buttons = { { Text = "ST", Callback = function() end } } })
		end)
		check("progress clamps to 0..1", function()
			local e = card:AddProgress({ Label = "ST progress", Default = 0.5 })
			e:Set(2)
			expect(e:Get() == 1, "did not clamp high")
			e:Set(-1)
			expect(e:Get() == 0, "did not clamp low")
		end)
		renders("ring", function() return card:AddRing({ Size = 60, Default = 0.42, Caption = "ST" }) end)
		renders("chart", function()
			return card:AddChart({ Height = 70, Values = { 3, 7, 2, 9, 4, 6, 8 } })
		end)
		check("stat tiles update", function()
			local e = card:AddStatTiles({ Tiles = { { Label = "A", Value = 1 }, { Label = "B", Value = 2 } } })
			e:Set(1, 5)
			expect(#e.Tiles == 2, "tiles missing")
		end)
		renders("key / value list", function()
			return card:AddKeyValue({ Mode = "rows", Items = { { Key = "One", Value = "1" } } })
		end)
		renders("badges", function() return card:AddBadges({ Items = { { Text = "ST", Token = "Accent" } } }) end)
		renders("alert", function() return card:AddAlert({ Type = "info", Title = "ST", Text = "Alert." }) end)
		renders("meter", function() return card:AddMeter({ Name = "ST meter", Default = 0.6 }) end)
		renders("timeline", function()
			return card:AddTimeline({ Items = { { Title = "One", Text = "First" }, { Title = "Two", Text = "Second" } } })
		end)
		renders("empty state", function()
			return card:AddEmptyState({ Icon = "folder", Title = "Empty", Text = "Nothing.", Height = 80 })
		end)
		renders("skeleton", function() return card:AddSkeleton({ Lines = 2, Height = 30 }) end)
		renders("avatar stack", function()
			return card:AddAvatarStack({ Items = { { Initial = "A", Name = "A" } }, Extra = "+1" })
		end)
		check("table renders rows and paginates", function()
			local e = card:AddTable({
				Columns = { "Name", "Value" }, MaxVisible = 2, RowHeight = 22,
				Rows = { { "a", "1" }, { "b", "2" }, { "c", "3" } },
			})
			expect(e ~= nil, "no table")
			if e.SetRows then e:SetRows({ { "x", "9" } }) end
		end)
		renders("pagination", function() return card:AddPagination({ Pages = 4, Default = 1 }) end)
		renders("breadcrumb", function() return card:AddBreadcrumb({ Items = { "Home", "Sub", "Here" } }) end)
		renders("icon tiles", function()
			return card:AddIconTiles({ Tiles = { { Icon = "bolt", Title = "ST", Text = "Tile" } } })
		end)
		check("console logs and clears", function()
			local e = card:AddConsole({ Height = 60, MaxLines = 10 })
			e:Log("self-test line", "info")
			expect(#e.Lines == 1, "log did not append")
			e:Clear()
			expect(#e.Lines == 0, "clear did not empty")
		end)
		renders("game row", function()
			return card:AddGameRow({ Name = "ST game", Desc = "Placeholder", Selected = false })
		end)
		renders("account row", function()
			return card:AddAccountRow({ Name = "ST account", Desc = "Placeholder" })
		end)
		renders("preset row", function()
			return card:AddPresetRow({ Name = "ST preset", Desc = "Placeholder" })
		end)
		renders("input row", function()
			return card:AddInputRow({ Name = "ST input", Default = "value" })
		end)
	end

	-- ------------------------------------------------------------------
	if group("Containers") then
		buildScratch()
		check("accordion opens, closes and hosts elements", function()
			local a = card:AddAccordion({ Title = "ST group", Badge = "1" })
			a:AddLabel("Nested")
			a:SetOpen(true)
			a:SetOpen(false)
			expect(a.Instance ~= nil, "no accordion")
		end)
		check("sub-tabs switch pages", function()
			local s = card:AddSubTabs({ Tabs = { "One", "Two" }, Height = 90 })
			s.Pages[1]:AddLabel("First")
			s.Pages[2]:AddLabel("Second")
			s:SetActive(2)
			expect(s:GetActive() == 2, "sub-tab did not switch")
			s:SetActive(1)
			expect(s:GetActive() == 1, "sub-tab did not switch back")
		end)
		check("list container hosts elements", function()
			local l = card:AddList({ Height = 80 })
			l:AddLabel("List item")
			expect(l.Frame ~= nil and #l.Elements == 1, "list did not host the element")
		end)
		check("tooltip shows and hides", function()
			win:Tooltip(card.Frame, { Title = "ST", Text = "Tooltip" })
			win:HideTooltip()
		end)
		check("context menu opens and closes", function()
			win:ShowContextMenu({ { Text = "ST item", Callback = function() end } }, Vector2.new(200, 200))
			win:HideContextMenu()
		end)
		check("command palette registers and opens", function()
			win:AddCommand({ Name = "Self-test command", Icon = "bolt", Callback = function() end })
			win:ShowCommandPalette()
			win:ShowCommandPalette()
		end)
		check("drawer opens and closes", function()
			local d = win:AddDrawer({ Title = "ST drawer", Side = "right", Width = 240 })
			d:AddLabel("Drawer body")
			d:SetOpen(true)
			expect(d:IsOpen(), "drawer did not open")
			d:Toggle()
			expect(not d:IsOpen(), "drawer did not toggle closed")
			task.wait(0.4)
			if d.Frame then d.Frame:Destroy() end
		end)
		check("confirm modal builds without blocking", function()
			local close = win:Confirm({ Title = "ST", Text = "Confirm?", Callback = function() end })
			expect(type(close) == "function", "Confirm did not return a close function")
			close()
		end)
		check("prompt modal builds without blocking", function()
			local close = win:Prompt({ Title = "ST", Placeholder = "Type...", Callback = function() end })
			expect(type(close) == "function", "Prompt did not return a close function")
			close()
		end)
		check("layout modal opens and closes", function()
			win:ShowLayout()
			win:HideLayout()
		end)
		check("notifications stack and expire", function()
			win:Notify({ Title = "Self-test", Text = "Toast.", Type = "info", Duration = 0.4 })
			expect(#win._notify >= 1, "toast was not queued")
		end)
	end

	-- ------------------------------------------------------------------
	if group("Motion") then
		local host = new("Frame", {
			Size = UDim2.fromOffset(80, 40), BackgroundTransparency = 1, Parent = win.Root,
		})
		local hostScale = new("UIScale", { Scale = 1, Parent = host })
		local hostStroke = new("UIStroke", { Color = win.Theme.Stroke, Thickness = 1, Parent = host })
		local hostLabel = new("TextLabel", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "0", Parent = host,
		})
		check("one spring per object + property", function()
			local a = Motion.Spring(host, "Rotation", 0, "UI", win)
			local b = Motion.Spring(host, "Rotation", 0, "UI", win)
			expect(a == b, "registry created two competing springs")
		end)
		check("Motion.Stop freezes a spring", function()
			local s = Motion.Spring(host, "Rotation", 0, "UI", win)
			s:To(30)
			Motion.Stop(host, "Rotation")
			expect(not s.Running, "spring still running after Stop")
		end)
		check("Motion.Forget drops the registry entry", function()
			Motion.Spring(host, "Rotation", 0, "UI", win)
			Motion.Forget(host)
			expect(Motion._registry[host] == nil, "registry entry survived Forget")
		end)
		local flourishes = {
			{ "Pop", function() Motion.Pop(hostScale, win, { From = 0.9 }) end },
			{ "SlideIn", function() Motion.SlideIn(host, win, { Y = 10 }) end },
			{ "Flip", function() Motion.Flip(hostScale, win, nil, { Half = 0.05 }) end },
			{ "Reveal", function() Motion.Reveal(host, win, { Distance = 6 }) end },
			{ "Shake", function() Motion.Shake(host, win, { Strength = 3, Duration = 0.1 }) end },
			{ "Wiggle", function() return Motion.Wiggle(host, win, { Amplitude = 2 }) end },
			{ "Breathe", function() return Motion.Breathe(hostScale, win, { Amplitude = 0.02 }) end },
			{ "Wave", function() return Motion.Wave({ host }, win, { Amplitude = 2 }) end },
			{ "Orbit", function() return Motion.Orbit(host, win, { Radius = 2 }) end },
			{ "Glow", function() return Motion.Glow(hostStroke, win, {}) end },
			{ "Shimmer", function() return Motion.Shimmer(host, win, { Period = 1 }) end },
			{ "BorderTrace", function() return Motion.BorderTrace(host, win, {}) end },
			{ "Magnet", function() return Motion.Magnet(host, win, {}) end },
			{ "Tilt", function() return Motion.Tilt(host, win, {}) end },
			{ "FocusRing", function() return Motion.FocusRing(host, win, {}) end },
			{ "Sparkle", function() Motion.Sparkle(host, win, { Count = 4 }) end },
			{ "Confetti", function() Motion.Confetti(host, win, { Count = 4 }) end },
			{ "CountTo", function() Motion.CountTo(hostLabel, 0, 10, win, { Duration = 0.1 }) end },
			{ "Typewriter", function() Motion.Typewriter(hostLabel, "self-test", win, { Speed = 0.01 }) end },
			{ "FadeWords", function() Motion.FadeWords(host, "self test", win, {}) end },
			{ "Stagger", function() Motion.Stagger({ host }, function() end, 0.01, win) end },
			{ "Sequence", function() Motion.Sequence({ { 0, function() end }, { 0.01, function() end } }, win) end },
			{ "Value", function() return Motion.Value(0, function() end, "UI", win) end },
			{ "Tween", function() Motion.Tween(host, 0.05, { BackgroundTransparency = 1 }) end },
		}
		local stopped = {}
		for _, f in ipairs(flourishes) do
			check("Motion." .. f[1] .. " runs", function()
				local eff = f[2]()
				if type(eff) == "table" and eff.Stop then stopped[#stopped + 1] = eff end
			end)
		end
		check("looping effects stop cleanly", function()
			for _, e in ipairs(stopped) do e:Stop() end
			return #stopped .. " loops stopped"
		end)
		check("reduce-motion is honoured", function()
			local was = Motion.Reduce
			Aether:SetReduceMotion(true)
			expect(Motion.Reduce == true, "Reduce did not turn on")
			local s = Motion.Spring(host, "Rotation", 0, "UI", win)
			s:To(45)
			expect(math.abs(host.Rotation - 45) < 0.001, "spring did not snap under reduce-motion")
			Aether:SetReduceMotion(was)
		end)
		check("speed multiplier is clamped", function()
			local was = Motion.Speed
			Aether:SetSpeed(2)
			expect(Motion.Speed == 2, "speed did not apply")
			Aether:SetSpeed(0)
			expect(Motion.Speed > 0, "speed must never reach zero")
			Aether:SetSpeed(was)
		end)
		Motion.Forget(host, true)
		host:Destroy()
	end

	-- ------------------------------------------------------------------
	if group("Overlay") then
		check("overlay toggles both ways", function()
			local was = win.OverlayVisible
			win:SetOverlayVisible(true)
			expect(win.OverlayVisible == true, "overlay did not open")
			win:SetOverlayVisible(false)
			expect(win.OverlayVisible == false, "overlay did not close")
			win:SetOverlayVisible(was)
		end)
		check("a panel can be added, moved and destroyed", function()
			local p = win:AddOverlayPanel({ Name = "Self-test panel", Subtitle = "Temporary.",
				Position = { 60, 60 }, Size = { 240, 140 } })
			madePanels[#madePanels + 1] = p
			expect(p.Frame ~= nil, "panel has no frame")
			expect(p.Drag ~= nil, "panel is not draggable")
			p.Drag.SetCenter(Vector2.new(200, 200))
			p:AddLabel("Panel body")
		end)
		check("panels stay inside the viewport", function()
			local p = madePanels[1] or win.Panels[1]
			if not p then return "no panels to check" end
			p.Drag.SetCenter(Vector2.new(99999, 99999))
			local vp = viewport()
			local pos, size = p.Frame.AbsolutePosition, p.Frame.AbsoluteSize
			expect(pos.X + size.X <= vp.X + 2, "panel escaped the right edge")
			expect(pos.Y + size.Y <= vp.Y + 2, "panel escaped the bottom edge")
			return "clamped to the viewport"
		end)
		check("overlay opacity applies", function()
			win:SetOverlayOpacity(0.6)
			win:SetOverlayOpacity(1)
		end)
		check("ResetLayout restores panel positions", function()
			win:ResetLayout()
		end)
		check("overlay key can be rebound", function()
			local old = win.OverlayKeys[1]
			win:SetOverlayKey(Enum.KeyCode.F8)
			expect(win.OverlayKeys[1] == Enum.KeyCode.F8, "overlay key did not rebind")
			win:SetOverlayKey(old)
		end)
	end

	-- ------------------------------------------------------------------
	if group("Theme") then
		check("every built-in theme applies", function()
			local names = Aether.ListThemes and Aether:ListThemes() or Aether.ThemeOrder
			for _, n in ipairs(names) do
				win:SetTheme(n)
				expect(win.Theme ~= nil, "theme " .. tostring(n) .. " produced no palette")
			end
			return #names .. " themes"
		end)
		check("a custom theme can be registered", function()
			Aether:AddTheme("Self-test theme", { Accent = Color3.fromRGB(120, 200, 255) })
			win:SetTheme("Self-test theme")
			expect(win.Theme.Accent.B > 0.9, "custom accent did not apply")
		end)
		check("snapshot / restore round-trips", function()
			local snap = win:Snapshot()
			local n = 0
			for _ in pairs(snap) do n += 1 end
			expect(n > 0, "snapshot was empty")
			local restored = win:RestoreSnapshot(snap)
			expect(restored >= 0, "restore returned nothing")
			return n .. " values"
		end)
	end

	-- ------------------------------------------------------------------
	if group("Drag") then
		check("window exposes a drag controller", function()
			expect(win.Drag ~= nil, "no drag controller")
			expect(type(win.Drag.SetCenter) == "function", "no SetCenter")
		end)
		check("dragging is not stuck on", function()
			expect(not win.Drag.IsDragging(), "a drag is still active")
		end)
		check("the window cannot be pushed off screen", function()
			local before = win.Root.Position
			win.Drag.SetCenter(Vector2.new(99999, 99999))
			local vp = viewport()
			local pos, size = win.Root.AbsolutePosition, win.Root.AbsoluteSize
			expect(pos.X + size.X <= vp.X + 2, "window escaped the right edge")
			expect(pos.Y + size.Y <= vp.Y + 2, "window escaped the bottom edge")
			win.Drag.SetCenter(Vector2.new(
				before.X.Scale * vp.X + before.X.Offset,
				before.Y.Scale * vp.Y + before.Y.Offset
			))
		end)
		check("drag wobble is gentle", function()
			local d = Aether.Config.Drag
			expect(d.MaxTilt <= 2.5, "MaxTilt is too strong: " .. tostring(d.MaxTilt))
			expect(d.Threshold >= 3, "drag threshold is too small, clicks would drag")
		end)
		check("no spring is left running on the window when idle", function()
			task.wait(0.35)
			local n = 0
			for s in pairs(Motion.Springs) do
				if s.Object == win.Root and s.Running then n += 1 end
			end
			expect(n == 0, n .. " springs still driving the window")
		end)
	end

	-- ------------------------------------------------------------------
	-- Clean up: remove everything the run created, put the user back where
	-- they were. A self-test that leaves debris behind is a bug.
	-- ------------------------------------------------------------------
	currentGroup = "Cleanup"
	check("temporary panels removed", function()
		local before = #win.Panels
		for _, p in ipairs(madePanels) do p:Destroy() end
		expect(#win.Panels == before - #madePanels, "panels were left behind")
	end)
	check("temporary status pills removed", function()
		local before = #(win.StatusPills or {})
		for _, p in ipairs(madePills) do p:Destroy() end
		expect(#(win.StatusPills or {}) == before - #madePills, "status pills were left behind")
	end)
	check("temporary category removed", function()
		if scratch then
			scratch:Destroy()
			scratch, card = nil, nil
		end
	end)
	check("original theme restored", function()
		if originalTheme then win:SetTheme(originalTheme) end
	end)
	check("original category restored", function()
		if originalTab and not originalTab._destroyed then
			win:SetActiveTab(originalTab)
			expect(win.ActiveTab == originalTab, "could not return to the original tab")
		end
	end)

	report.Seconds = os.clock() - report.Started
	if opts.Notify ~= false then
		win:Notify({
			Title = "Self-test " .. (report.Failed == 0 and "passed" or "found problems"),
			Text = string.format("%d / %d checks passed in %.2fs", report.Passed, report.Total, report.Seconds),
			Type = report.Failed == 0 and "success" or "error",
			Duration = 5,
		})
	end
	return report
end

Aether.SelfTestGroups = SELFTEST_GROUPS

return Aether
