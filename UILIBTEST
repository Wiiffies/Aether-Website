function Card:AddList(opts: any)
	opts = opts or {}
	local win = self.Window
	local list = setmetatable({}, Card)
	list.Window = win
	list.Elements = {}
	list.Frame = new("ScrollingFrame", {
		Name = "List", BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, opts.Height or 160),
		ScrollBarThickness = 4, ScrollBarImageColor3 = win.Theme.Stroke2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = opts.Order or nextOrder(self), Parent = self.Body,
	})
	pad(list.Frame, 0, 8, 0, 0)
	vlist(list.Frame, 4)
	list.Body = list.Frame
	self.Elements[#self.Elements + 1] = list
	return list
end

function Card:AddSpacer(h: any)
	local f = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 6), LayoutOrder = nextOrder(self), Parent = self.Body })
	return { Instance = f }
end

-- =====================================================================
-- QUICK LAYOUT MODAL  ·  centred over a dimmed page
-- =====================================================================
function Window:ShowLayout()
	if self._layout and self._layout.Parent then return end
	local shade = new("Frame", {
		Name = "LayoutShade", BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = self.Root,
	})
	Motion.Tween(shade, 0.18, { BackgroundTransparency = 0.55 })
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, ZIndex = 40, Parent = shade,
	})
	local modal = new("CanvasGroup", {
		Name = "QuickLayout", AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(460, 400),
		BackgroundColor3 = self.Theme.Card, BorderSizePixel = 0,
		GroupTransparency = 1, ZIndex = 41, Parent = shade,
	})
	round(modal, 12)
	outline(modal, self.Theme.SelStroke, 1, 0.35)
	local ms = scaler(modal, 0.94)
	self._layout = shade
	local body = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = modal })
	pad(body, 20, 20, 18, 18)
	vlist(body, 8)
	local proxy = setmetatable({ Window = self, Body = body, Elements = {} }, Card)
	proxy:SetHeader({ Title = "Quick layout" })
	proxy:AddCaption("Toggle the panels that float over Roblox. Drag any panel by its title bar - each one keeps its own place.")
	for _, p in ipairs(self.Panels) do
		proxy:AddToggleRow({
			Name = p.Name, Default = p.Visible,
			Callback = function(v) p:SetVisible(v) end,
		})
	end
	proxy:AddDivider()
	proxy:AddButtonBar({
		Align = "right",
		Buttons = {
			{ Text = "Reset layout", Icon = "move", Callback = function() self:ResetLayout() end },
			{ Text = "Open overlay", Icon = "play", Primary = true, Callback = function() self:SetOverlayVisible(true) end },
		},
	})
	local closeBtn = chromeButton(self, modal, "close", -10, "Sub", function() self:HideLayout() end)
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -10, 0, 12)
	Motion.Spring(modal, "GroupTransparency", 0, "UI", self):To(0)
	Motion.Spring(ms, "Scale", 1, "Groovy", self):To(1)
	self._layoutModal, self._layoutScale = modal, ms
	hit.Activated:Connect(function() self:HideLayout() end)
end

function Window:HideLayout()
	local shade, modal, ms = self._layout, self._layoutModal, self._layoutScale
	if not shade or not shade.Parent then return end
	self._layout = nil
	if modal then
		Motion.Spring(modal, "GroupTransparency", 1, "Snappy", self):To(1)
		if ms then Motion.Spring(ms, "Scale", 0.94, "Snappy", self):To(0.94) end
	end
	Motion.Tween(shade, 0.18, { BackgroundTransparency = 1 })
	later(0.22, shade, function() shade:Destroy() end)
end

-- =====================================================================
-- 8 · MOTION EXTRAS
-- ---------------------------------------------------------------------
-- Everything here is built on the same single-connection spring engine.
-- Persistent effects register as zero-interval tickers, so they cost
-- nothing once stopped and they die with the window that owns them.
-- =====================================================================

-- A running effect. :Stop() removes its ticker; :Pause()/:Resume() gate it.
local Effect = {}
Effect.__index = Effect

local function effect(win: any, fn: any)
	local self = setmetatable({}, Effect)
	self.Window = win
	self.Alive = true
	self.Paused = false
	self.Started = Motion.Time
	local tk = win:AddTicker(0, function()
		if not self.Alive or self.Paused or Motion.Reduce then return end
		fn(Motion.Time - self.Started, Motion.Time)
	end)
	self._ticker = tk
	return self
end

function Effect:Stop()
	if not self.Alive then return end
	self.Alive = false
	local list = self.Window and self.Window._tickers
	if list then
		for i, t in ipairs(list) do
			if t == self._ticker then table.remove(list, i); break end
		end
	end
end

function Effect:Pause() self.Paused = true end
function Effect:Resume() self.Paused = false end

-- ---------------------------------------------------------------------
-- Sequencing
-- ---------------------------------------------------------------------
-- Motion.Sequence({ {0, fn}, {0.1, fn}, ... }, owner)
-- Returns a handle with :Cancel(). Every step is parent-guarded.
function Motion.Sequence(steps: any, owner: any, guard: any)
	local cancelled = false
	local handle = { Cancel = function() cancelled = true end }
	for _, step in ipairs(steps or {}) do
		local at, fn = step[1], step[2]
		later(at or 0, guard or (owner and owner.Gui), function()
			if cancelled then return end
			local ok, err = pcall(fn)
			if not ok then warn("[Aether sequence] " .. tostring(err)) end
		end)
	end
	return handle
end

-- Motion.Stagger(list, fn, step, owner) - the classic cascade
function Motion.Stagger(list: any, fn: any, step: any, owner: any, cap: any)
	step = step or 0.045
	cap = cap or 0.6
	for i, item in ipairs(list or {}) do
		local delay = math.min((i - 1) * step, cap)
		later(delay, owner and owner.Gui, function()
			local ok, err = pcall(fn, item, i)
			if not ok then warn("[Aether stagger] " .. tostring(err)) end
		end)
	end
end

-- ---------------------------------------------------------------------
-- Number + text animation
-- ---------------------------------------------------------------------
-- Rolls a label from one number to another with a spring, not a lerp.
function Motion.CountTo(label: any, from: any, to: any, owner: any, opts: any)
	opts = opts or {}
	local fmt = opts.Format or function(v) return tostring(math.floor(v + 0.5)) end
	local spring = Motion.Value(from, function(v)
		if label and label.Parent then label.Text = (opts.Prefix or "") .. fmt(v) .. (opts.Suffix or "") end
	end, opts.Preset or "UI", owner)
	spring:Snap(from)
	spring:To(to)
	return spring
end

-- Types text out one character at a time, with a blinking caret.
function Motion.Typewriter(label: any, text: any, owner: any, opts: any)
	opts = opts or {}
	local cps = opts.CharsPerSecond or 42
	local caret = opts.Caret ~= false
	text = tostring(text or "")
	label.Text = ""
	local done = false
	local eff = effect(owner, function(t)
		local n = math.min(#text, math.floor(t * cps))
		local showCaret = caret and (math.floor(t * 2.4) % 2 == 0)
		label.Text = string.sub(text, 1, n) .. ((not done and showCaret) and "|" or "")
		if n >= #text and not done then
			done = true
			label.Text = text
			if opts.OnDone then task.spawn(function() pcall(opts.OnDone) end) end
		end
	end)
	if opts.AutoStop ~= false then
		later(#text / cps + 0.6, label, function() eff:Stop(); label.Text = text end)
	end
	return eff
end

-- Fades a run of words in one after another using separate labels.
function Motion.FadeWords(parent: any, text: any, owner: any, opts: any)
	opts = opts or {}
	local win = owner
	local holder = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Height or 20),
		Parent = parent,
	})
	local x = 0
	local labels = {}
	for word in tostring(text or ""):gmatch("%S+") do
		local w = textWidth(word, opts.TextSize or 13) + 6
		local l = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(w, opts.Height or 20),
			Font = opts.Font or Enum.Font.GothamMedium, TextSize = opts.TextSize or 13,
			TextColor3 = opts.Color or win.Theme.Text, TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left, Text = word, Parent = holder,
		})
		labels[#labels + 1] = l
		x += w
	end
	Motion.Stagger(labels, function(l)
		local rest = UDim2.new(l.Position.X.Scale, l.Position.X.Offset, 0, 0)
		Motion.Spring(l, "TextTransparency", 0, "UI", win):To(0)
		Motion.Spring(l, "Position", rest, "Bouncy", win)
			:Snap(UDim2.new(rest.X.Scale, rest.X.Offset, 0, 8))
			:To(rest)
	end, opts.Step or 0.05, win)
	return { Instance = holder, Labels = labels }
end

-- ---------------------------------------------------------------------
-- Looping flourishes
-- ---------------------------------------------------------------------
-- A soft highlight that sweeps across a card. Never uses a white backing
-- frame: the bar is tinted with the accent and faded by a gradient.
function Motion.Shimmer(frame: any, owner: any, opts: any)
	opts = opts or {}
	local win = owner
	local bar = new("Frame", {
		Name = "Shimmer", BorderSizePixel = 0, ZIndex = 2,
		BackgroundColor3 = opts.Color or win.Theme.AccentHi,
		BackgroundTransparency = opts.Strength or 0.86,
		Size = UDim2.new(0, opts.Width or 120, 1, 0),
		Position = UDim2.new(-0.4, 0, 0, 0), Parent = frame,
	})
	local grad = new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Rotation = opts.Rotation or 18,
		Parent = bar,
	})
	local period = opts.Period or 4.5
	local eff = effect(win, function(t)
		local phase = (t % period) / period
		if phase > 0.55 then
			bar.Visible = false
		else
			bar.Visible = true
			bar.Position = UDim2.new(-0.35 + phase / 0.55 * 1.7, 0, 0, 0)
		end
	end)
	eff.Bar = bar
	eff.Gradient = grad
	return eff
end

-- Pulses a UIStroke in and out - "this thing is live".
function Motion.Glow(stroke: any, owner: any, opts: any)
	opts = opts or {}
	local lo, hi = opts.Low or 0.75, opts.High or 0.15
	local speed = opts.Speed or 1.6
	return effect(owner, function(t)
		local a = (math.sin(t * speed) + 1) / 2
		stroke.Transparency = lo + (hi - lo) * a
	end)
end

-- Gentle rotation wobble.
function Motion.Wiggle(object: any, owner: any, opts: any)
	opts = opts or {}
	local amp, speed = opts.Amplitude or 4, opts.Speed or 2
	local base = object.Rotation
	Motion.Stop(object, "Rotation")
	return effect(owner, function(t)
		object.Rotation = base + math.sin(t * speed) * amp
	end)
end

-- Breathing UIScale.
function Motion.Breathe(scaleObject: any, owner: any, opts: any)
	opts = opts or {}
	local amp, speed = opts.Amplitude or 0.03, opts.Speed or 1.4
	local base = opts.Base or 1
	Motion.Stop(scaleObject, "Scale")
	return effect(owner, function(t)
		scaleObject.Scale = base + math.sin(t * speed) * amp
	end)
end

-- Phase-offset bob across a row of objects (a "wave").
function Motion.Wave(objects: any, owner: any, opts: any)
	opts = opts or {}
	local amp, speed, phase = opts.Amplitude or 4, opts.Speed or 2.4, opts.Phase or 0.45
	local bases = {}
	for i, o in ipairs(objects) do bases[i] = o.Position; Motion.Stop(o, "Position") end
	return effect(owner, function(t)
		for i, o in ipairs(objects) do
			if o.Parent then
				local b = bases[i]
				o.Position = UDim2.new(b.X.Scale, b.X.Offset, b.Y.Scale, b.Y.Offset + math.sin(t * speed - i * phase) * amp)
			end
		end
	end)
end

-- Small circular drift, for badges and status dots.
function Motion.Orbit(object: any, owner: any, opts: any)
	opts = opts or {}
	local r, speed = opts.Radius or 3, opts.Speed or 1.8
	local base = object.Position
	Motion.Stop(object, "Position")
	return effect(owner, function(t)
		object.Position = UDim2.new(
			base.X.Scale, base.X.Offset + math.cos(t * speed) * r,
			base.Y.Scale, base.Y.Offset + math.sin(t * speed) * r
		)
	end)
end

-- A dot that runs around the border of a frame.
function Motion.BorderTrace(frame: any, owner: any, opts: any)
	opts = opts or {}
	local win = owner
	local dot = new("Frame", {
		Name = "Trace", BackgroundColor3 = opts.Color or win.Theme.AccentHi,
		BorderSizePixel = 0, Size = UDim2.fromOffset(opts.Size or 5, opts.Size or 5),
		AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3, Parent = frame,
	})
	pill(dot)
	local speed = opts.Speed or 0.28
	return effect(win, function(t)
		local w, h = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
		if w <= 0 or h <= 0 then return end
		local per = 2 * (w + h)
		local d = ((t * speed) % 1) * per
		local x, y
		if d < w then x, y = d, 0
		elseif d < w + h then x, y = w, d - w
		elseif d < 2 * w + h then x, y = w - (d - w - h), h
		else x, y = 0, h - (d - 2 * w - h) end
		dot.Position = UDim2.fromOffset(x, y)
	end)
end

-- ---------------------------------------------------------------------
-- One-shot flourishes
-- ---------------------------------------------------------------------
-- Decaying random shake, for errors and "nope" feedback.
function Motion.Shake(object: any, owner: any, opts: any)
	opts = opts or {}
	local strength, dur = opts.Strength or 7, opts.Duration or 0.4
	local base = object.Position
	Motion.Stop(object, "Position")
	local eff = effect(owner, function(t)
		local k = math.max(0, 1 - t / dur)
		object.Position = UDim2.new(
			base.X.Scale, base.X.Offset + (math.random() - 0.5) * 2 * strength * k,
			base.Y.Scale, base.Y.Offset + (math.random() - 0.5) * 2 * strength * k * 0.5
		)
	end)
	later(dur + 0.05, object, function()
		eff:Stop()
		object.Position = base
	end)
	return eff
end

-- Squash-and-stretch pop, the workhorse press feedback.
function Motion.Pop(scaleObject: any, owner: any, opts: any)
	opts = opts or {}
	local from, over = opts.From or 0.86, opts.Overshoot or 1.05
	local pop = Motion.Spring(scaleObject, "Scale", from, "Groovy", owner)
	pop:Snap(from)
	pop:SetPreset("Groovy"):To(over)
	later(opts.Hold or 0.16, scaleObject.Parent or owner.Gui, function()
		Motion.Spring(scaleObject, "Scale", opts.Rest or 1, "Bouncy", owner):To(opts.Rest or 1)
	end)
end

-- Slides + fades an object in from an offset.
function Motion.SlideIn(object: any, owner: any, opts: any)
	opts = opts or {}
	local dx, dy = opts.X or 0, opts.Y or 18
	local target = object.Position
	Motion.Spring(object, "Position", target, opts.Preset or "Bouncy", owner)
		:Snap(UDim2.new(target.X.Scale, target.X.Offset + dx, target.Y.Scale, target.Y.Offset + dy))
		:To(target)
	if object:IsA("CanvasGroup") then object.GroupTransparency = 1 end
	if object:IsA("CanvasGroup") then
		Motion.Spring(object, "GroupTransparency", 0, "UI", owner):To(0)
	end
end

-- Flips a card around its vertical axis by squashing X, swapping, expanding.
function Motion.Flip(scaleObject: any, owner: any, onHalfway: any, opts: any)
	opts = opts or {}
	local half = opts.Half or 0.13
	Motion.Tween(scaleObject, half, { Scale = 0.02 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	later(half, scaleObject.Parent or owner.Gui, function()
		if onHalfway then task.spawn(function() pcall(onHalfway) end) end
		Motion.Spring(scaleObject, "Scale", 1, "Groovy", owner):To(1)
	end)
end

-- Cascades a container's children in. Used by pages, lists and menus.
function Motion.Reveal(container: any, owner: any, opts: any)
	opts = opts or {}
	local items = {}
	for _, c in ipairs(container:GetChildren()) do
		if c:IsA("GuiObject") and c.Visible then items[#items + 1] = c end
	end
	table.sort(items, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	Motion.Stagger(items, function(o)
		if o:IsA("CanvasGroup") then
			o.GroupTransparency = 1
			Motion.Spring(o, "GroupTransparency", 0, "UI", owner):To(0)
		end
		local p = o.Position
		Motion.Spring(o, "Position", p, opts.Preset or "Bouncy", owner)
			:Snap(UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + (opts.Distance or 14)))
			:To(p)
	end, opts.Step or 0.035, owner, opts.Cap or 0.5)
	return items
end

-- A short celebratory burst. Cheap: fixed particle count, all destroyed.
function Motion.Confetti(parent: any, owner: any, opts: any)
	opts = opts or {}
	local win = owner
	local count = math.clamp(opts.Count or 18, 1, 48)
	local colors = opts.Colors or { win.Theme.Accent, win.Theme.AccentHi, win.Theme.Good, win.Theme.Text }
	local origin = opts.Origin or Vector2.new(0.5, 0.5)
	for i = 1, count do
		local size = math.random(4, 8)
		local p = new("Frame", {
			Name = "Confetti", BorderSizePixel = 0, ZIndex = 20,
			BackgroundColor3 = colors[(i % #colors) + 1],
			Size = UDim2.fromOffset(size, size * (math.random(6, 14) / 10)),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(origin.X, origin.Y),
			Rotation = math.random(0, 360), Parent = parent,
		})
		round(p, 2)
		local angle = (i / count) * math.pi * 2 + math.random() * 0.4
		local dist = math.random(60, 150)
		local tx = origin.X + math.cos(angle) * dist / math.max(parent.AbsoluteSize.X, 1)
		local ty = origin.Y + math.sin(angle) * dist / math.max(parent.AbsoluteSize.Y, 1)
		Motion.Tween(p, 0.5, {
			Position = UDim2.fromScale(tx, ty),
			Rotation = p.Rotation + math.random(-220, 220),
		}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		later(0.42, p, function() Motion.Tween(p, 0.35, { BackgroundTransparency = 1 }) end)
		later(0.85, p, function() p:Destroy() end)
	end
end

-- Tiny sparkles that drift up and fade - used on "success" states.
function Motion.Sparkle(parent: any, owner: any, opts: any)
	opts = opts or {}
	local win = owner
	for i = 1, math.clamp(opts.Count or 8, 1, 24) do
		local d = new("Frame", {
			BackgroundColor3 = opts.Color or win.Theme.AccentHi, BorderSizePixel = 0,
			Size = UDim2.fromOffset(3, 3), ZIndex = 20,
			Position = UDim2.fromScale(math.random(), math.random()), Parent = parent,
		})
		pill(d)
		local p = d.Position
		later(i * 0.04, d, function()
			Motion.Tween(d, 0.7, {
				Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset - math.random(18, 40)),
				BackgroundTransparency = 1,
			}, Enum.EasingStyle.Quad)
		end)
		later(0.9 + i * 0.04, d, function() d:Destroy() end)
	end
end

-- ---------------------------------------------------------------------
-- Pointer-reactive behaviour
-- ---------------------------------------------------------------------
-- The button leans toward the cursor while hovered.
function Motion.Magnet(button: any, owner: any, opts: any)
	opts = opts or {}
	local strength = opts.Strength or 0.16
	local base = button.Position
	local inside = false
	local spring = Motion.Spring(button, "Position", base, "Bouncy", owner)
	spring:Snap(base)
	button.MouseEnter:Connect(function() inside = true end)
	button.MouseLeave:Connect(function()
		inside = false
		base = button.Position
		spring:To(base)
	end)
	connect(owner, UserInputService.InputChanged, function(i)
		if not inside or Motion.Reduce then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local m = UserInputService:GetMouseLocation()
		local ap, as = button.AbsolutePosition, button.AbsoluteSize
		if as.X <= 0 then return end
		local dx = (m.X - (ap.X + as.X / 2)) * strength
		local dy = (m.Y - (ap.Y + as.Y / 2)) * strength
		spring:To(UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset + dy))
	end)
	return { Reset = function() spring:To(base) end }
end

-- Tilts a card toward the cursor, like it is sitting on glass.
function Motion.Tilt(frame: any, owner: any, opts: any)
	opts = opts or {}
	local maxDeg = opts.Max or 2.5
	local rot = Motion.Spring(frame, "Rotation", 0, "Bouncy", owner)
	rot:Snap(0)
	local inside = false
	frame.MouseEnter:Connect(function() inside = true end)
	frame.MouseLeave:Connect(function() inside = false; rot:To(0) end)
	connect(owner, UserInputService.InputChanged, function(i)
		if not inside or Motion.Reduce then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local m = UserInputService:GetMouseLocation()
		local ap, as = frame.AbsolutePosition, frame.AbsoluteSize
		if as.X <= 0 then return end
		rot:To(math.clamp((m.X - (ap.X + as.X / 2)) / as.X, -0.5, 0.5) * maxDeg * 2)
	end)
	return rot
end

-- Focus ring that grows in when a field takes focus.
function Motion.FocusRing(frame: any, owner: any, opts: any)
	opts = opts or {}
	local win = owner
	local ring = outline(frame, win.Theme.Accent, opts.Thickness or 1.6, 1)
	local scale = scaler(frame, 1)
	return {
		Enter = function()
			Motion.Spring(ring, "Transparency", 0.1, "Snappy", win):To(0.1)
			Motion.Spring(scale, "Scale", 1.012, "Bouncy", win):To(1.012)
		end,
		Leave = function()
			Motion.Spring(ring, "Transparency", 1, "Snappy", win):To(1)
			Motion.Spring(scale, "Scale", 1, "Bouncy", win):To(1)
		end,
		Stroke = ring,
	}
end

-- Animated check-mark drawn from two bars.
local function drawCheck(parent: any, size: any, color: any, win: any)
	local holder = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Parent = parent,
	})
	local a = new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.22, 0.55), Size = UDim2.fromOffset(0, size * 0.16),
		Rotation = 45, Parent = holder,
	})
	local b = new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.42, 0.70), Size = UDim2.fromOffset(0, size * 0.16),
		Rotation = -45, Parent = holder,
	})
	pill(a); pill(b)
	return {
		Instance = holder,
		Show = function(animated)
			local la, lb = size * 0.34, size * 0.60
			if animated == false then
				a.Size = UDim2.fromOffset(la, size * 0.16)
				b.Size = UDim2.fromOffset(lb, size * 0.16)
				return
			end
			a.Size = UDim2.fromOffset(0, size * 0.16)
			b.Size = UDim2.fromOffset(0, size * 0.16)
			Motion.Spring(a, "Size", UDim2.fromOffset(la, size * 0.16), "Snappy", win):To(UDim2.fromOffset(la, size * 0.16))
			later(0.07, holder, function()
				Motion.Spring(b, "Size", UDim2.fromOffset(lb, size * 0.16), "Groovy", win):To(UDim2.fromOffset(lb, size * 0.16))
			end)
		end,
		Hide = function()
			Motion.Spring(a, "Size", UDim2.fromOffset(0, size * 0.16), "Snappy", win):To(UDim2.fromOffset(0, size * 0.16))
			Motion.Spring(b, "Size", UDim2.fromOffset(0, size * 0.16), "Snappy", win):To(UDim2.fromOffset(0, size * 0.16))
		end,
		SetColor = function(c) a.BackgroundColor3 = c; b.BackgroundColor3 = c end,
	}
end

-- =====================================================================
-- 9 · INPUT ELEMENTS
-- ---------------------------------------------------------------------
-- Every element follows the same contract:
--   api:Get()            current value
--   api:Set(v, fire)     set it; fire defaults to true, only fires on change
--   api.Instance         the root GuiObject (for LayoutOrder / parenting)
