-- Draw a Lucide icon as vector strokes. Each segment is a round-capped
-- capsule; consecutive capsules overlap at the joints so curves read smooth.
-- Full circles use one Frame + UICorner + UIStroke instead of a polyline.
-- If the user has uploaded a PNG for this name, that image is used instead.
-- Resolve the image URL for an icon name, or nil for the vector fallback.
-- Precedence: explicit CONFIG override > supplied PNG > nil (vectors).
local function iconImageFor(name: any): string?
	if CONFIG.IconImages[name] and CONFIG.IconImages[name] ~= "" then
		return CONFIG.IconImages[name]
	end
	if name == "logo" and CONFIG.LogoImage ~= "" then
		return CONFIG.LogoImage
	end
	if CONFIG.UseSuppliedAssets and ASSET_URLS[name] then
		return ASSET_URLS[name]
	end
	return nil
end

local function drawIcon(parent: any, name: any, size: any, color: any, owner: any)
	local holder = new("Frame", {
		Name = "Icon", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size), Parent = parent,
	})

	local uploaded = iconImageFor(name)
	if uploaded then
		-- The supplied glyphs are flat WHITE on transparent, so ImageColor3
		-- multiplies cleanly into the theme colour. The logo is full-colour
		-- artwork and must NOT be tinted (its ImageColor3 stays white).
		local tint = (name == "logo")
		local img = new("ImageLabel", {
			Name = "Image", BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1), Image = uploaded,
			ImageColor3 = tint and Color3.new(1, 1, 1) or color,
			ScaleType = Enum.ScaleType.Fit, Parent = holder,
		})
		return {
			Frame = holder,
			SetColor = function(c)
				if not tint then
					if img.Parent then Motion.Spring(img, "ImageColor3", c, "Soft", owner):To(c) end
				end
			end,
		}
	end
	local segs = ICON_SEG[name] or ICON_SEG.grid
	local rings = ICON_RING[name]
	local u = size / 24
	-- Lucide's stroke-width is 2 in a 24-unit box. Keep a visible floor so
	-- small icons do not disappear on a low-DPI screen.
	local w = math.max(1.25, u * 2)
	local parts, strokes = {}, {}

	for _, seg in ipairs(segs) do
		local x1, y1, x2, y2 = seg[1] * u, seg[2] * u, seg[3] * u, seg[4] * u
		local dx, dy = x2 - x1, y2 - y1
		local len = math.sqrt(dx * dx + dy * dy)
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(math.max(len, 0.01), w),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color, BorderSizePixel = 0, Parent = holder,
		})
		new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
		parts[#parts + 1] = bar
	end

	if rings then
		for _, r in ipairs(rings) do
			local d = r[3] * 2 * u
			local ring = new("Frame", {
				Name = "Ring", BackgroundTransparency = 1,
				Position = UDim2.fromOffset(r[1] * u - d / 2, r[2] * u - d / 2),
				Size = UDim2.fromOffset(d, d), Parent = holder,
			})
			new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ring })
			local st = new("UIStroke", {
				Color = color, Thickness = w,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring,
			})
			strokes[#strokes + 1] = st
		end
	end

	return {
		Frame = holder,
		SetColor = function(c)
			for _, b in ipairs(parts) do
				if b.Parent then Motion.Spring(b, "BackgroundColor3", c, "Soft", owner):To(c) end
			end
			for _, st in ipairs(strokes) do
				if st.Parent then Motion.Spring(st, "Color", c, "Soft", owner):To(c) end
			end
		end,
	}
end

