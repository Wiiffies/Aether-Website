-- Where the ScreenGui goes. Executor hidden-UI container when available,
-- otherwise PlayerGui. Shared so the fatal-error panel can use it too.
local function resolveGuiParent(explicit: any)
	if explicit then return explicit end
	local found
	pcall(function()
		if type(gethui) == "function" then
			local h = gethui()
			if h and typeof(h) == "Instance" then found = h end
		end
	end)
	if found then return found end
	return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
end

