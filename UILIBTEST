-- Scope the custom cursor to this library's own surfaces.
-- Setting UserInputService.MouseIcon at boot changed the pointer for the whole
-- game, which is not what "in the menu" means. Instead the root elements watch
-- the pointer: entering any of them applies the cursor, leaving clears it.
-- MouseEnter/MouseLeave bubble to ancestors in Roblox, so listening on the
-- roots is enough - no per-button wiring.
function Window:_wireCursor()
	if not self.CursorImage then return end
	local targetUrl = self.CursorImage or ""
	local hovered = false

	local function applyCursor(force: boolean?)
		if hovered or force then
			pcall(function()
				if UserInputService.MouseIcon ~= targetUrl then
					UserInputService.MouseIcon = targetUrl
				end
			end)
		else
			pcall(function()
				if UserInputService.MouseIcon == targetUrl then
					UserInputService.MouseIcon = ""
				end
			end)
		end
	end

	local function set(on: boolean)
		if hovered == on then return end
		hovered = on
		applyCursor()
	end

	-- Watch the root surfaces
	local roots = { self.Root, self.Orb, self.NotifyHost }
	for _, root in ipairs(roots) do
		if root and typeof(root) == "Instance" and root:IsA("GuiObject") then
			connect(self, root.MouseEnter, function() set(true) end)
			connect(self, root.MouseLeave, function() set(false) end)
		end
	end
	self._watchCursorSurface = function(obj)
		if obj and typeof(obj) == "Instance" and obj:IsA("GuiObject") then
			connect(self, obj.MouseEnter, function() set(true) end)
			connect(self, obj.MouseLeave, function() set(false) end)
		end
	end

	-- Crucial Roblox behavior fix: When hovering over ANY GuiButton (TextButton, ImageButton),
	-- Roblox engine attempts to reset UserInputService.MouseIcon to the default white pointing hand!
	-- We bind to RenderStepped while hovered so our custom cursor stays locked on buttons, sliders, etc.
	connect(self, RunService.RenderStepped, function()
		if hovered and self.Visible then
			applyCursor(true)
		end
	end)

	-- Window focus loss safety
	connect(self, UserInputService.WindowFocusReleased, function() set(false) end)
	self._cursorSet = set
end

function Window:_step(dt: any, t: any)
	if self.Groovy and self.LogoScale.Parent and self.Visible then
		self.LogoScale.Scale = 1 + math.sin(t * 2.0) * 0.05
	end
	if self.Minimized and self.OrbScale.Parent then
		self.OrbScale.Scale = 1 + math.sin(t * 3) * 0.06
	end
	for _, tk in ipairs(self._tickers) do
		tk.acc += dt
		if tk.acc >= tk.interval then
			tk.acc = 0
			local ok, err = pcall(tk.fn)
			if not ok then warn("[Aether ticker] " .. tostring(err)) end
		end
	end
end

function Window:AddTicker(interval: any, fn: any)
	local tk = { interval = interval or 0.5, acc = 0, fn = fn }
	self._tickers[#self._tickers + 1] = tk
	Motion.Wake()
	return tk
end

function Window:SetFooter(opts: any)
	opts = opts or {}
	if opts.Left then self.FooterLeft.Text = opts.Left end
	if opts.Center then self.FooterCenter.Text = opts.Center end
	if opts.Actions then
		for _, c in ipairs(self.FooterActions:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		for i, a in ipairs(opts.Actions) do
			actionButton(self, self.FooterActions, {
				Text = a.Text, Icon = a.Icon, Callback = a.Callback,
				TextSize = 11, Height = 24, Pad = 4, Order = i,
			})
		end
	end
end

function Window:Show(instant: any)
	self.Visible, self.Minimized = true, false
	self.Root.Visible, self.Orb.Visible = true, false
	self._fit()
	local target = self.BaseScale or 1
	if instant then
		self.Scale.Scale = target * 0.9
		self.Root.GroupTransparency = 1
	end
	self.Scale.Scale = math.min(self.Scale.Scale, target * 0.92)
	self.Root.GroupTransparency = math.max(self.Root.GroupTransparency, 0.6)
	Motion.Spring(self.Scale, "Scale", target, "Groovy", self):To(target)
	Motion.Spring(self.Root, "GroupTransparency", 0, "UI", self):To(0)
	if self.ActiveTab then self:_revealCards(self.ActiveTab) end
end

function Window:Hide()
	self.Visible = false
	Motion.Spring(self.Scale, "Scale", (self.BaseScale or 1) * 0.92, "Snappy", self):To((self.BaseScale or 1) * 0.92)
	Motion.Spring(self.Root, "GroupTransparency", 1, "Snappy", self):To(1)
	later(0.22, self.Gui, function()
		if not self.Visible then self.Root.Visible = false end
	end)
end

function Window:Toggle() if self.Visible then self:Hide() else self:Show() end end

function Window:Minimize()
	self:Hide()
	self.Minimized = true
	later(0.16, self.Gui, function()
		if not self.Minimized then return end
		self.Orb.Visible = true
		self.OrbScale.Scale = 0.2
		Motion.Spring(self.OrbScale, "Scale", 1, "Groovy", self):To(1)
	end)
end

function Window:Restore()
	self.Orb.Visible = false
	self:Show()
end

function Window:ToggleSize()
	if self._big then
		self._size = Vector2.new(CONFIG.Size[1], CONFIG.Size[2])
		self._big = false
	else
		local vp = viewport()
		self._size = Vector2.new(math.min(vp.X - 60, 1280), math.min(vp.Y - 60, 820))
		self._big = true
	end
	Motion.Spring(self.Root, "Size", UDim2.fromOffset(self._size.X, self._size.Y), "Groovy", self)
		:To(UDim2.fromOffset(self._size.X, self._size.Y))
	self._fit()
end

-- =====================================================================
-- TABS  ·  horizontal nav pills, unlimited
-- =====================================================================
-- Split into three small builders: one big AddTab exceeded Luau's type-check
-- complexity budget, which made Studio report cascading bogus type errors.
local function buildTabButton(win: any, tab: any, opts: any)
	local w = math.floor(textWidth(tab.Name, 13) + 15 + 6 + 26)
	tab.Width = w
	tab._x = 0
	tab.Button = new("TextButton", {
		Name = tab.Name, BackgroundColor3 = win.Theme.NavSel,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.fromOffset(w, 28), Text = "", AutoButtonColor = false,
		LayoutOrder = tab.Order, Parent = win.NavList,
	})
	round(tab.Button, 8)
	tab.Stroke = outline(tab.Button, win.Theme.SelStroke, 1, 1)
	tab.Icon = drawIcon(tab.Button, opts.Icon or "grid", 14, win.Theme.Sub, win)
	tab.Icon.Frame.Position = UDim2.fromOffset(13, 7)
	tab.Label = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(33, 0),
		Size = UDim2.new(1, -43, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13,
		TextColor3 = win.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
		Text = tab.Name, Parent = tab.Button,
	})
	tab.BtnScale = scaler(tab.Button, 1)
end

local function buildTabPage(win: any, tab: any)
	tab.Page = new("CanvasGroup", {
		Name = tab.Name .. "_Page", BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), Visible = false, GroupTransparency = 0,
		Parent = win.Content,
	})
	tab.Scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 4, ScrollBarImageColor3 = win.Theme.Stroke2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Parent = tab.Page,
	})
	pad(tab.Scroll, 14, 14, 14, 14)
	vlist(tab.Scroll, 12)
end

local function wireTabButton(win: any, tab: any)
	tab.Button.MouseEnter:Connect(function()
		if win.ActiveTab == tab then return end
		Motion.Spring(tab.Button, "BackgroundTransparency", 0.45, "Snappy", win):To(0.45)
		Motion.Spring(tab.Label, "TextColor3", win.Theme.Text, "Snappy", win):To(win.Theme.Text)
		tab.Icon.SetColor(win.Theme.Text)
	end)
	tab.Button.MouseLeave:Connect(function()
		if win.ActiveTab == tab then return end
		Motion.Spring(tab.Button, "BackgroundTransparency", 1, "Snappy", win):To(1)
		Motion.Spring(tab.Label, "TextColor3", win.Theme.Sub, "Snappy", win):To(win.Theme.Sub)
		tab.Icon.SetColor(win.Theme.Sub)
	end)
	tab.Button.Activated:Connect(function()
		ripple(win, tab.Button, UserInputService:GetMouseLocation())
		Motion.Pop(tab.BtnScale, win, { From = 0.94, Overshoot = 1.03 })
		win:SetActiveTab(tab)
	end)
end

function Window:AddTab(opts: any)
	opts = opts or {}
	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Name = opts.Name or ("Tab " .. (#self.Tabs + 1))
	tab.Order = #self.Tabs + 1
	tab.Rows, tab.Cards = {}, {}

	buildTabButton(self, tab, opts)
	buildTabPage(self, tab)
	wireTabButton(self, tab)

	-- nav pills drop in from above when created
	tab.Button.Position = UDim2.fromOffset(0, -14)
	Motion.Spring(tab.Button, "Position", UDim2.fromOffset(0, 0), "Bouncy", self):To(UDim2.fromOffset(0, 0))

	self.Tabs[#self.Tabs + 1] = tab
	self:_layoutNav()
	if not self.ActiveTab then self:SetActiveTab(tab) end
	return tab
end

function Window:_layoutNav()
	local x = 0
	for _, t in ipairs(self.Tabs) do
		t._x = x
		x += t.Width + 6
	end
	if self.ActiveTab then self:_moveIndicator(self.ActiveTab, true) end
end

function Window:_moveIndicator(tab: any, instant: any)
	local w = math.max(18, tab.Width - 24)
	local target = UDim2.fromOffset(tab._x + (tab.Width - w) / 2, 36)
	self._navX:To(target)
	self._navW:To(UDim2.fromOffset(w, 2))
	if instant and #self.Tabs == 1 then
		self._navX:Snap(target)
		self._navW:Snap(UDim2.fromOffset(w, 2))
	end
end

function Tab:_restyle()
	local win = self.Window
	local active = win.ActiveTab == self
	Motion.Spring(self.Button, "BackgroundTransparency", active and 0 or 1, "Snappy", win):To(active and 0 or 1)
	Motion.Spring(self.Button, "BackgroundColor3", win.Theme.NavSel, "Soft", win):To(win.Theme.NavSel)
	Motion.Spring(self.Stroke, "Transparency", active and 0.25 or 1, "Snappy", win):To(active and 0.25 or 1)
	Motion.Spring(self.Label, "TextColor3", active and win.Theme.Text or win.Theme.Sub, "Soft", win):To(active and win.Theme.Text or win.Theme.Sub)
	self.Icon.SetColor(active and win.Theme.AccentHi or win.Theme.Sub)
end

function Window:_revealCards(tab: any)
	for i, card in ipairs(tab.Cards) do
		local fade = Motion.Spring(card.Frame, "GroupTransparency", 1, "UI", self)
		local grow = Motion.Spring(card.Scale, "Scale", 1, "Bouncy", self)
		fade:Snap(1)
		grow:Snap(0.975)
		later(math.min((i - 1) * 0.05, 0.4), card.Frame, function()
			fade:To(0)
			grow:To(1)
		end)
	end
end

-- Remove a category at runtime. The nav re-packs, the indicator re-targets,
-- and every spring touching the removed subtree is dropped so nothing leaks.
function Tab:Destroy()
	local win = self.Window
	if not win or self._destroyed then return end
	self._destroyed = true
	local wasActive = win.ActiveTab == self
	for i, t in ipairs(win.Tabs) do
		if t == self then table.remove(win.Tabs, i); break end
	end
	if self.Button then
		Motion.Forget(self.Button, true)
		self.Button:Destroy()
	end
	if self.Page then
		Motion.Forget(self.Page, true)
		self.Page:Destroy()
	end
	for i, t in ipairs(win.Tabs) do t.Order = i end
	self.Rows, self.Cards = {}, {}
	win:_layoutNav()
	if wasActive then
		win.ActiveTab = nil
		if win.Tabs[1] then win:SetActiveTab(win.Tabs[1]) end
	end
end

function Window:SetActiveTab(tab: any)
	if typeof(tab) == "number" then tab = self.Tabs[tab] end
	if not tab or self.ActiveTab == tab then return end
	local old = self.ActiveTab
	local forward = true
	if old then forward = tab.Order > old.Order end
	self.ActiveTab = tab
	for _, t in ipairs(self.Tabs) do
		t:_restyle()
		if t ~= tab and t.Page.Visible then
			local page = t.Page
			Motion.Tween(page, 0.12, { GroupTransparency = 1 })
			later(0.13, page, function()
				if self.ActiveTab ~= t then page.Visible = false end
			end)
		end
	end
	self:_moveIndicator(tab)
	tab.Page.Visible = true
	Motion.Spring(tab.Page, "GroupTransparency", 0, "Snappy", self):Snap(1):To(0)
	Motion.Spring(tab.Page, "Position", UDim2.fromOffset(0, 0), "Bouncy", self)
		:Snap(UDim2.fromOffset(forward and 22 or -22, 0))
		:To(UDim2.fromOffset(0, 0))
	self:_revealCards(tab)
end

-- =====================================================================
-- ROWS + CARDS  ·  the two-column grid from the launcher
-- =====================================================================
function Tab:AddRow(height: any)
	local row = setmetatable({}, Row)
	row.Window, row.Tab, row.Cards = self.Window, self, {}
	row.Frame = new("Frame", {
		Name = "Row", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 240),
		LayoutOrder = #self.Rows + 1, Parent = self.Scroll,
	})
	row.Height = height or 240
	local l = hlist(row.Frame, 12, Enum.VerticalAlignment.Top)
	l.VerticalAlignment = Enum.VerticalAlignment.Top
	self.Rows[#self.Rows + 1] = row
	return row
end

function Row:AddCard(opts: any)
	opts = opts or {}
	local win = self.Window
	local card = setmetatable({}, Card)
	card.Window, card.Row, card.Elements = win, self, {}
	card.Weight = opts.Weight or 1
	card.Frame = new("CanvasGroup", {
		Name = opts.Title or "Card", BackgroundColor3 = opts.Hero and win.Theme.Hero2 or win.Theme.Card,
		BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0),
		GroupTransparency = 0, LayoutOrder = #self.Cards + 1, Parent = self.Frame,
	})
	self.Cards[#self.Cards + 1] = card
	-- share the row width by weight, splitting the gutters proportionally
	local total = 0
	for _, c in ipairs(self.Cards) do total += c.Weight end
	local gutters = 12 * (#self.Cards - 1)
	for _, c in ipairs(self.Cards) do
		local frac = c.Weight / total
		Motion.Spring(c.Frame, "Size", UDim2.new(frac, -gutters * frac, 1, 0), "UI", win)
			:To(UDim2.new(frac, -gutters * frac, 1, 0))
	end
	round(card.Frame, 10)
	card.Scale = scaler(card.Frame, 1)
	-- The reference cards read as soft panels, not outlined boxes: the border
	-- is barely there. A strong 1px stroke on every card is what makes a UI
	-- look like a generic dashboard.
	card.Stroke = outline(card.Frame, opts.Hero and win.Theme.SelStroke or win.Theme.Stroke, 1, opts.Hero and 0.6 or 0.82)
	paint(win, card.Frame, "BackgroundColor3", opts.Hero and "Hero2" or "Card")
	if opts.Hero then
		-- Hero wash. The backing frame is Hero1 (never white) and the gradient
		-- only ever MULTIPLIES it down toward Hero2, so if a client drops the
		-- gradient the card still renders as a dark blue panel.
		card.HeroWash = new("Frame", {
			Name = "HeroWash", BorderSizePixel = 0, BackgroundColor3 = win.Theme.Hero1,
			Size = UDim2.fromScale(1, 1), ZIndex = 0, Parent = card.Frame,
		})
		local g = new("UIGradient", { Color = heroSequence(win.Theme), Parent = card.HeroWash })
		paint(win, card.HeroWash, "BackgroundColor3", "Hero1")
		win.HeroGradients = win.HeroGradients or {}
		win.HeroGradients[#win.HeroGradients + 1] = g
		round(card.HeroWash, 10)
	end

	-- Scroll = true turns the card body into its own scrolling column, so a
	-- card can hold more than fits without pushing the grid row taller.
	-- ScrollingFrame-only properties must NOT be passed to a plain Frame:
	-- Roblox raises "X is not a valid member of Frame" and the whole build
	-- dies. Keep the two property sets separate.
	local bodyProps = {
		Name = "Body", BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0), Parent = card.Frame,
	}
	if opts.Scroll then
		bodyProps.ScrollBarThickness = 3
		bodyProps.ScrollBarImageColor3 = win.Theme.Stroke2
		bodyProps.CanvasSize = UDim2.new()
		bodyProps.AutomaticCanvasSize = Enum.AutomaticSize.Y
		bodyProps.ScrollingDirection = Enum.ScrollingDirection.Y
	end
	card.Body = new(opts.Scroll and "ScrollingFrame" or "Frame", bodyProps)
	pad(card.Body, 16, 16, 14, 14)
	if not opts.FreeLayout then vlist(card.Body, opts.Gap or 8) end
	card._headerDone = false
	self.Tab.Cards[#self.Tab.Cards + 1] = card
	return card
end

function Tab:AddCard(opts: any)
	local row = self:AddRow((opts and opts.Height) or 240)
	return row:AddCard(opts)
end

-- Every element gets the next LayoutOrder so cards read top-to-bottom in
-- the order you added them. (Sharing one negative order made all captions
-- jump to the top of the card.)
local function nextOrder(card: any)
	card._order = (card._order or 0) + 1
	return card._order
end

-- card header: UPPERCASE title on the left, text actions on the right
-- Remove every element from a card and start again. Springs targeting the
-- removed subtree are dropped so nothing keeps animating a dead instance.
function Card:Clear()
	for _, e in ipairs(self.Elements) do
		local inst = (type(e) == "table" and (e.Instance or e.Frame)) or e
		if type(e) == "table" and e.Destroy and not e.Instance then
			pcall(function() e:Destroy() end)
		elseif inst and inst.Destroy then
			Motion.Forget(inst, true)
			inst:Destroy()
		end
	end
	self.Elements = {}
	self._order = 0
	self._headerDone = false
end

function Card:SetHeader(opts: any)
	opts = opts or {}
	local win = self.Window
	self._headerDone = true
	self._order = 0
	local head = new("Frame", {
		Name = "Header", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20), LayoutOrder = -1000, Parent = self.Body,
	})
	self.Title = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(0.55, 0, 1, 0),
		Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = win.Theme.Sub,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.upper(opts.Title or ""), Parent = head,
	})
	paint(win, self.Title, "TextColor3", "Sub")
	if opts.Badge then
		local bw = textWidth(opts.Badge, 10) + 14
		local badge = new("Frame", {
			BackgroundColor3 = win.Theme.NavSel, BorderSizePixel = 0,
			Position = UDim2.fromOffset(textWidth(string.upper(opts.Title or ""), 11, Enum.Font.GothamBold) + 10, 2),
			Size = UDim2.fromOffset(bw, 16), Parent = head,
		})
		pill(badge)
		paint(win, badge, "BackgroundColor3", "NavSel")
		local bl = new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = win.Theme.AccentHi,
			Text = opts.Badge, Parent = badge,
		})
		paint(win, bl, "TextColor3", "AccentHi")
		self.BadgeLabel = bl
	end
	if opts.Actions then
		local holder = new("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.6, 0, 0, 24), Parent = head,
		})
		local l = hlist(holder, 10, Enum.VerticalAlignment.Center)
		l.HorizontalAlignment = Enum.HorizontalAlignment.Right
		self._actionHolder = holder
		for i, a in ipairs(opts.Actions) do
			local btn = actionButton(win, holder, {
				Text = a.Text, Icon = a.Icon, Callback = a.Callback,
				TextSize = 11, Height = 22, Pad = 3, Order = i,
			})
			if a.Ref then a.Ref(btn) end
		end
	end
	if opts.Caption then self:AddCaption(opts.Caption) end
	return self
end

function Card:AddCaption(text: any)
	local win = self.Window
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 11,
		TextColor3 = win.Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, Text = tostring(text or ""), LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	paint(win, lbl, "TextColor3", "Dim")
	local api: any = { Instance = lbl }
	function api:SetText(t: any) lbl.Text = tostring(t) end
	self.Elements[#self.Elements + 1] = api
	return api
end

function Card:AddLabel(text: any, opts: any)
	opts = opts or {}
	local win = self.Window
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = opts.Bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		TextSize = opts.Size or 12,
		TextColor3 = win.Theme[opts.Token or "Text"], TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, Text = tostring(text or ""), LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	paint(win, lbl, "TextColor3", opts.Token or "Text")
	local api: any = { Instance = lbl }
	function api:SetText(t: any) lbl.Text = tostring(t) end
	function api:Get() return lbl.Text end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- boxed warning paragraph, as used by the Frame rate / Server panels
function Card:AddNote(text: any)
	local win = self.Window
	local box = new("Frame", {
		BackgroundColor3 = win.Theme.Row, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	round(box, 8)
	paint(win, box, "BackgroundColor3", "Row")
	pad(box, 10, 10, 9, 9)
	-- an explicit list layout makes the auto-height identical in Roblox and
	-- in the offline renderer (a bare Frame + auto-sized label is ambiguous)
	vlist(box, 0)
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 11,
		TextColor3 = win.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
		Text = tostring(text or ""), Parent = box,
	})
	paint(win, lbl, "TextColor3", "Sub")
	local api: any = { Instance = box }
	function api:SetText(t: any) lbl.Text = tostring(t) end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- label + text field + button on one line ("Custom  [30]  Set")
function Card:AddInputRow(opts: any)
	opts = opts or {}
	local win = self.Window
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local lw = opts.Label and (textWidth(opts.Label, 12) + 12) or 0
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(0, lw, 1, 0),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local btnW = opts.Button and (textWidth(opts.Button, 12) + 26) or 0
	local field = new("Frame", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		Position = UDim2.fromOffset(lw, 1),
		Size = UDim2.new(1, -lw - btnW - (opts.Button and 8 or 0), 0, 30), Parent = row,
	})
	round(field, 7)
	outline(field, win.Theme.Stroke, 1, 0.4)
	paint(win, field, "BackgroundColor3", "Inset")
	pad(field, 10, 10, 0, 0)
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Text,
		PlaceholderColor3 = win.Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, Text = tostring(opts.Default or ""),
		PlaceholderText = opts.Placeholder or "", Parent = field,
	})
	paint(win, tb, "TextColor3", "Text")
	local api: any = { Instance = row }
	function api:Get() return tb.Text end
	function api:SetText(t: any) tb.Text = tostring(t) end
	local function fire()
		if opts.Callback then task.spawn(function() pcall(opts.Callback, tb.Text) end) end
	end
	tb.FocusLost:Connect(function(enter) if enter then fire() end end)
	if opts.Button then
		local holder = new("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(btnW, 30), Parent = row,
		})
		actionButton(win, holder, { Text = opts.Button, Filled = true, Height = 30, TextSize = 12, Pad = 12, Callback = fire })
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

function Card:AddDivider()
	local win = self.Window
	local holder = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 9),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	local line = new("Frame", {
		BackgroundColor3 = win.Theme.Stroke, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, 1), Parent = holder,
	})
	paint(win, line, "BackgroundColor3", "Stroke")
	line.Size = UDim2.new(0, 0, 0, 1)
	Motion.Spring(line, "Size", UDim2.new(1, 0, 0, 1), "Bouncy", win):To(UDim2.new(1, 0, 0, 1))
	return { Instance = holder }
end

-- =====================================================================
-- TOGGLE (used standalone inside rows)
-- =====================================================================
local function makeToggle(win: any, parent: any, value: any, cb: any)
	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0,
		BackgroundColor3 = value and win.Theme.Accent or win.Theme.Stroke2, Parent = parent,
	})
	pill(track)
	local knob = new("Frame", {
		Position = value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.fromRGB(248, 250, 255),
		BorderSizePixel = 0, Parent = track,
	})
	pill(knob)
	local ks = scaler(knob, 1)
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromOffset(52, 30),
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 6, 0.5, 0),
		Text = "", AutoButtonColor = false, Parent = parent,
	})
	local api: any = {}
	local function apply(v: any, fire: any)
		local changed = (v == true) ~= value
		value = v == true
		Motion.Spring(track, "BackgroundColor3", value and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win):To(value and win.Theme.Accent or win.Theme.Stroke2)
		Motion.Spring(knob, "Position", value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3), "Groovy", win):To(value and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3))
		Motion.Spring(track, "Size", UDim2.fromOffset(44, 22), "Snappy", win):To(UDim2.fromOffset(44, 22))
		later(0.09, track, function()
			Motion.Spring(track, "Size", UDim2.fromOffset(40, 22), "Groovy", win):To(UDim2.fromOffset(40, 22))
		end)
		ks.Scale = 0.72
		Motion.Spring(ks, "Scale", 1, "Groovy", win):To(1)
		if fire and changed and cb then
			task.spawn(function()
				local ok, err = pcall(cb, value)
				if not ok then warn("[Aether toggle] " .. tostring(err)) end
			end)
		end
	end
	function api:Set(v: any, fire: any) apply(v, fire ~= false) end
	function api:Get() return value end
	function api:_restyle()
		Motion.Spring(track, "BackgroundColor3", value and win.Theme.Accent or win.Theme.Stroke2, "Soft", win):To(value and win.Theme.Accent or win.Theme.Stroke2)
	end
	hit.Activated:Connect(function() apply(not value, true) end)
	hit.MouseEnter:Connect(function() Motion.Spring(ks, "Scale", 1.12, "Groovy", win):To(1.12) end)
	hit.MouseLeave:Connect(function() Motion.Spring(ks, "Scale", 1, "Bouncy", win):To(1) end)
	api.Track, api.Knob = track, knob
	return api
end

