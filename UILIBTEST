-- Panels reuse every Card widget: both lay their children out inside .Body.
setmetatable(Panel, { __index = Card })

function Panel:SetVisible(v: any)
	self.Visible = v == true
	local win = self.Window
	if self.Visible then
		local home = self.Frame.Position
		self.Frame.Visible = true
		self.Frame.GroupTransparency = 1
		self.Frame.Position = UDim2.new(home.X.Scale, home.X.Offset, home.Y.Scale, home.Y.Offset + 14)
		self.Scale.Scale = 0.97
		-- Glide, not Bouncy: a panel that overshoots its own position reads as
		-- a wobble. The border lightens in a beat later so the edge arrives
		-- after the fill.
		Motion.Spring(self.Frame, "GroupTransparency", 0, "UI", win):To(0)
		Motion.Spring(self.Frame, "Position", home, "Glide", win):To(home)
		Motion.Spring(self.Scale, "Scale", 1, "UI", win):To(1)
		if self.Stroke then
			self.Stroke.Transparency = 1
			later(0.08, self.Frame, function()
				if not self.Visible then return end
				Motion.Tween(self.Stroke, 0.24, { Transparency = 0.35 }, Enum.EasingStyle.Quad)
			end)
		end
	else
		Motion.Spring(self.Frame, "GroupTransparency", 1, "Snappy", win):To(1)
		Motion.Spring(self.Scale, "Scale", 0.97, "Snappy", win):To(0.97)
		later(0.18, self.Frame, function()
			if not self.Visible then self.Frame.Visible = false end
		end)
	end
end

-- Remove a panel for good. Without this, temporary panels (self-test,
-- transient HUDs) could only be hidden and would pile up in win.Panels.
function Panel:Destroy()
	local win = self.Window
	if not win or self._destroyed then return end
	self._destroyed = true
	for i, p in ipairs(win.Panels) do
		if p == self then table.remove(win.Panels, i); break end
	end
	if self.Frame then
		Motion.Forget(self.Frame, true)
		self.Frame:Destroy()
	end
	self.Elements, self.Cards = {}, {}
end

function Panel:ResetPosition()
	local p, sz = self.DefaultPosition, self.DefaultSize
	local x, y = p[1] + sz[1] / 2, p[2] + sz[2] / 2
	Motion.Spring(self.Frame, "Position", UDim2.fromOffset(x, y), "Groovy", self.Window)
		:To(UDim2.fromOffset(x, y))
	self.Position = { x, y }
end

-- =====================================================================
-- OVERLAY ENTRANCE / EXIT
-- ---------------------------------------------------------------------
-- Previously the panels just faded in with a scale, all at once, from their
-- final position. Now each panel is choreographed:
--   · it starts slightly below and to the side of where it belongs, smaller
--   · the bar and body fade before the contents, so the panel reads as a
--     surface arriving rather than a picture appearing
--   · the contents stagger in, top to bottom, by layout order
--   · the accent stroke lightens in after the fill, which gives the edge a
--     moment of its own instead of popping
-- Exit is the reverse, faster, and never waits for the content stagger.
-- =====================================================================
-- GroupTransparency only exists on CanvasGroup. An arbitrary GuiObject child
-- fades through whatever transparency properties its own class actually has,
-- and a UIListLayout means Position is ignored - so fading is the only effect
-- that works for list contents.
local function transparencyProps(obj: any): {{ [string]: number }}
	local out = {}
	local function grab(prop: string)
		local ok, v = pcall(function() return obj[prop] end)
		if ok and type(v) == "number" then out[prop] = v end
	end
	if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		grab("TextTransparency")
		grab("TextStrokeTransparency")
		grab("BackgroundTransparency")
	end
	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		grab("ImageTransparency")
		grab("BackgroundTransparency")
	end
	if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
		grab("BackgroundTransparency")
	end
	if obj:IsA("CanvasGroup") then
		grab("GroupTransparency")
	end
	return out
end

function Window:_animatePanelIn(panel: any, index: any, instant: any)
	local frame = panel.Frame
	local home = frame.Position
	local dx, dy = 0, 22 + (index - 1) * 6
	if instant then
		frame.GroupTransparency = 0
		frame.Position = home
		panel.Scale.Scale = 1
		if panel.Stroke then panel.Stroke.Transparency = 0.35 end
		return
	end
	frame.Visible = true
	frame.GroupTransparency = 1
	frame.Position = UDim2.new(home.X.Scale, home.X.Offset + dx, home.Y.Scale, home.Y.Offset + dy)
	panel.Scale.Scale = 0.965
	if panel.Stroke then panel.Stroke.Transparency = 1 end

	local delay = math.min((index - 1) * 0.055, 0.34)
	later(delay, frame, function()
		if not self.OverlayVisible or not frame.Parent then return end
		Motion.Spring(frame, "GroupTransparency", 0, "UI", self):To(0)
		Motion.Spring(frame, "Position", home, "Glide", self):To(home)
		Motion.Spring(panel.Scale, "Scale", 1, "UI", self):To(1)
	end)
	if panel.Stroke then
		later(delay + 0.09, frame, function()
			if not self.OverlayVisible or not frame.Parent then return end
			Motion.Tween(panel.Stroke, 0.28, { Transparency = 0.35 }, Enum.EasingStyle.Quad)
		end)
	end
	-- contents stagger: a short fade per row, in layout order
	later(delay + 0.04, frame, function()
		if not self.OverlayVisible or not frame.Parent then return end
		local kids = {}
		local ok = pcall(function()
			for _, c in ipairs(panel.Body:GetChildren()) do
				if c:IsA("GuiObject") and c.Visible then kids[#kids + 1] = c end
			end
		end)
		if not ok then return end
		table.sort(kids, function(a, b)
			return (a.LayoutOrder or 0) < (b.LayoutOrder or 0)
		end)
		for i, c in ipairs(kids) do
			-- cap the stagger: a 20-row panel must not take a full second
			local step = math.min((i - 1) * 0.012, 0.2)
			local props = transparencyProps(c)
			local restore = {}
			for prop, base in pairs(props) do
				restore[prop] = base
				c[prop] = 1
			end
			later(step, c, function()
				if not self.OverlayVisible or not c.Parent then return end
				Motion.Tween(c, 0.2, restore, Enum.EasingStyle.Quad)
			end)
		end
	end)
end

function Window:SetOverlayVisible(v: any, instant: any)
	self.OverlayVisible = v == true
	if self.OverlayVisible then
		self.OverlayRoot.Visible = true
		for i, p in ipairs(self.Panels) do
			if p.Visible ~= false then
				self:_animatePanelIn(p, i, instant)
			end
		end
	else
		for _, p in ipairs(self.Panels) do
			Motion.Spring(p.Frame, "GroupTransparency", 1, "Snappy", self):To(1)
			Motion.Spring(p.Scale, "Scale", 0.97, "Snappy", self):To(0.97)
		end
		local root = self.OverlayRoot
		later(0.18, root, function()
			if not self.OverlayVisible then root.Visible = false end
		end)
	end
end

function Window:ToggleOverlay() self:SetOverlayVisible(not self.OverlayVisible) end

function Window:ResetLayout()
	for i, p in ipairs(self.Panels) do
		later((i - 1) * 0.03, p.Frame, function() p:ResetPosition() end)
	end
end

function Window:SetOverlayOpacity(a: any)
	self.OverlayOpacity = math.clamp(a, 0.2, 1)
	for _, p in ipairs(self.Panels) do
		p.Frame.BackgroundTransparency = 1 - self.OverlayOpacity
		p.Bar.BackgroundTransparency = 1 - self.OverlayOpacity
	end
end

-- =====================================================================
-- NOTIFICATIONS
-- =====================================================================
-- =====================================================================
-- NOTIFICATIONS
-- ---------------------------------------------------------------------
-- Styled as a small menu panel, not a browser toast: dark card matching the
-- window chrome, an accent rule down the leading edge, an icon tile, a
-- caps-tracked title and a quiet body. Behaviour:
--   · ONE container surface with a header, so a burst reads as a list rather
--     than a pile of unrelated boxes
--   · coalescing by title with an xN counter (a slider drag makes one entry)
--   · a hard cap on visible entries
--   · staggered entry, spring exit, and a footer progress rule that drains
--     over the entry's lifetime so you can see it is about to go
-- =====================================================================
local NOTIFY_ICON = {
	info = "info", success = "check", warn = "warn", error = "close", loading = "refresh",
}

function Window:_notifyHost()
	if self._notifyPanel then
		-- the surface can be destroyed by a theme rebuild; recreate defensively
		local ok = pcall(function() return self._notifyPanel.Frame.Parent end)
		if ok and self._notifyPanel.Frame.Parent then return self._notifyPanel end
		self._notifyPanel = nil
	end
	local host = new("CanvasGroup", {
		Name = "NotifyPanel",
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -54),
		Size = UDim2.fromOffset(292, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = self.Theme.Card, BorderSizePixel = 0,
		GroupTransparency = 1, Visible = false, Parent = self.Gui,
	})
	round(host, 11)
	outline(host, self.Theme.Stroke2, 1, 0.4)
	if self._watchCursorSurface then self._watchCursorSurface(host) end
	paint(self, host, "BackgroundColor3", "Card")

	-- The host needs a vertical list so AutomaticSize has something to measure.
	-- Without it the container's height is ambiguous and it collapses.
	vlist(host, 0)
	local head = new("Frame", {
		Name = "Head", BackgroundTransparency = 1, LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 26), Parent = host,
	})
	local headIcon = drawIcon(head, "bell", 12, self.Theme.Sub, self)
	headIcon.Frame.Position = UDim2.fromOffset(12, 8)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 5),
		Size = UDim2.new(1, -60, 0, 16), Font = Enum.Font.GothamBold, TextSize = 10,
		TextColor3 = self.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "NOTIFICATIONS", Parent = head, Name = "HeadLabel",
	})
	local headRule = new("Frame", {
		BackgroundColor3 = self.Theme.Stroke, BorderSizePixel = 0,
		Position = UDim2.new(0, 10, 1, -1), Size = UDim2.new(1, -20, 0, 1), Parent = head,
	})
	paint(self, headRule, "BackgroundColor3", "Stroke")

	local list = new("Frame", {
		Name = "List", BackgroundTransparency = 1, LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = host,
	})
	local lp = new("UIPadding", { Parent = list })
	lp.PaddingTop = UDim.new(0, 4)
	lp.PaddingBottom = UDim.new(0, 6)
	vlist(list, 2)
	local layout = { Frame = host, List = list, Head = head, HeadRule = headRule, HeadIcon = headIcon }
	self._notifyPanel = layout
	return layout
end

-- Keep the container in step with its contents, and slide it away when empty.
function Window:_notifySync()
	local panel = self._notifyPanel
	if not panel then return end
	local count = 0
	for _, e in ipairs(self._notify) do
		if e.alive and e.Instance.Parent then count += 1 end
	end
	panel.Head.Visible = count > 0
	if count == 0 then
		if panel.Frame.Visible then
			Motion.Spring(panel.Frame, "GroupTransparency", 1, "Snappy", self):To(1)
			Motion.Spring(panel.Frame, "Position", UDim2.new(1, -6, 1, -54), "Snappy", self)
				:To(UDim2.new(1, -6, 1, -54))
			local f = panel.Frame
			later(0.24, f, function()
				local still = 0
				for _, e in ipairs(self._notify) do
					if e.alive then still += 1 end
				end
				if still == 0 then f.Visible = false end
			end)
		end
		return
	end
	if not panel.Frame.Visible then
		panel.Frame.Visible = true
		panel.Frame.GroupTransparency = 1
		Motion.Spring(panel.Frame, "GroupTransparency", 0, "UI", self):To(0)
		Motion.Spring(panel.Frame, "Position", UDim2.new(1, -18, 1, -54), "UI", self)
			:To(UDim2.new(1, -18, 1, -54))
	end
end

function Window:Notify(opts: any)
	opts = opts or {}
	local title = opts.Title or "Aether"
	local body = opts.Text or opts.Body or ""
	local kind = opts.Type or "info"
	local dur = opts.Duration or 3.6
	local token = ({ info = "Accent", success = "Good", warn = "Bad", error = "Bad", loading = "Accent" })[kind] or "Accent"
	local panel = self:_notifyHost()

	-- Coalesce: dragging a slider or a colour picker fires its callback every
	-- frame. A repeat of the same title inside the window updates the live
	-- entry - and restarts its drain bar - instead of stacking a new one.
	local now = os.clock()
	for _, e in ipairs(self._notify) do
		if e.alive and e.title == title and (now - (e.stamp or 0)) < CONFIG.NotifyCoalesce then
			e.stamp = now
			e.gen = (e.gen or 0) + 1
			if e.bodyLabel then
				e.bodyLabel.Text = body
				e.bodyLabel.Visible = body ~= ""
			end
			if e.count then
				e.count += 1
				if e.titleLabel then e.titleLabel.Text = title end
				if e.badge then
					e.badge.Text = "x" .. e.count
				end
				-- the chip is the wrapper; showing the label alone leaves an
				-- invisible container
				if e.badgeWrap then
					e.badgeWrap.Visible = e.count > 1
				end
			end
			-- Motion.Pop animates a UIScale (just as Motion.Glow takes a UIStroke)
			if e.badgeScale then
				Motion.Pop(e.badgeScale, self)
			end
			-- restart the drain rule
			if e.drain then
				e.drain.Size = UDim2.new(1, 0, 0, 2)
				later(0, e.drain, function()
					Motion.Tween(e.drain, dur, { Size = UDim2.new(0, 0, 0, 2) },
						Enum.EasingStyle.Linear)
				end)
			end
			self:_notifySync()
			local myGen = e.gen
			later(dur, e.Instance, function()
				if e.gen == myGen then self:_expireNotify(e) end
			end)
			return e
		end
	end
	-- Hard cap, oldest first.
	while #self._notify >= CONFIG.NotifyMax do
		local oldest = self._notify[1]
		if not oldest then break end
		self:_expireNotify(oldest, true)
	end

	local card = new("CanvasGroup", {
		Name = "Entry", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 0, LayoutOrder = #self._notify, Parent = panel.List,
	})
	local host = new("Frame", {
		Name = "Body", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card,
	})
	-- left padding clears the 24px icon tile sitting at x=10
	pad(host, 42, 12, 9, 9)
	vlist(host, 2)

	-- icon tile: a rounded square holding a glyph, the same language as the
	-- rest of the menu
	local tile = new("Frame", {
		Name = "Tile", BackgroundColor3 = self.Theme.Inset, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(10, 11),
		Size = UDim2.fromOffset(24, 24), Parent = card, LayoutOrder = 9,
	})
	round(tile, 7)
	paint(self, tile, "BackgroundColor3", "Inset")
	local tileIcon = drawIcon(tile, NOTIFY_ICON[kind] or "info", 13, self.Theme[token], self)
	tileIcon.Frame.AnchorPoint = Vector2.new(0.5, 0.5)
	tileIcon.Frame.Position = UDim2.fromScale(0.5, 0.5)

	-- the accent rule down the leading edge
	local bar = new("Frame", {
		BackgroundColor3 = self.Theme[token], BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(0, 7),
		Size = UDim2.new(0, 2, 1, -14), Parent = card,
	})
	pill(bar)
	paint(self, bar, "BackgroundColor3", token)

	local titleRow = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 15), LayoutOrder = 1, Parent = host,
	})
	local titleLabel = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -28, 1, 0),
		Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = self.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, Text = title, Name = "ToastTitle",
		Parent = titleRow,
	})
	paint(self, titleLabel, "TextColor3", "Text")
	local badgeWrap = new("Frame", {
		BackgroundColor3 = self.Theme.Inset, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(20, 14), Visible = false, Parent = titleRow,
	})
	round(badgeWrap, 7)
	paint(self, badgeWrap, "BackgroundColor3", "Inset")
	local badgeScale = scaler(badgeWrap, 1)
	local badge = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = self.Theme.Sub,
		Text = "x1", TextXAlignment = Enum.TextXAlignment.Center, Parent = badgeWrap,
	})
	paint(self, badge, "TextColor3", "Sub")

	local bodyLabel = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Gotham, TextSize = 11,
		TextColor3 = self.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, Text = body, LayoutOrder = 2, Name = "ToastBody",
		Visible = body ~= "", Parent = host,
	})
	paint(self, bodyLabel, "TextColor3", "Sub")

	-- drain rule: shows the entry is going away, and restarts on coalesce
	local track = new("Frame", {
		BackgroundColor3 = self.Theme.Stroke, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2), Parent = card, Name = "Drain",
	})
	paint(self, track, "BackgroundColor3", "Stroke")
	local drain = new("Frame", {
		BackgroundColor3 = self.Theme[token], BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0), Parent = track, Name = "Fill",
	})
	paint(self, drain, "BackgroundColor3", token)

	local entry = { Instance = card, alive = true, title = title, stamp = now, gen = 0, count = 1, kind = kind }
	entry.titleLabel, entry.bodyLabel = titleLabel, bodyLabel
	entry.badge, entry.badgeWrap, entry.drain = badge, badgeWrap, drain
	entry.badgeScale = badgeScale
	self._notify[#self._notify + 1] = entry

	-- staggered entry: fade + a short slide, never a bounce
	card.GroupTransparency = 1
	for _, ch in ipairs({ host, tile, bar, track, titleRow }) do ch.Visible = true end
	Motion.Spring(card, "GroupTransparency", 0, "UI", self):To(0)
	later(0, drain, function()
		Motion.Tween(drain, dur, { Size = UDim2.new(0, 0, 1, 0) }, Enum.EasingStyle.Linear)
	end)
	local myGen = entry.gen
	later(dur, card, function()
		if entry.gen == myGen then self:_expireNotify(entry) end
	end)
	self:_notifySync()
	return entry
end

-- Single expiry path, shared by the timer, the repeat coalescer and the cap.
-- The entry is a row inside the shared notification panel, so it fades and
-- collapses rather than sliding off screen as an independent box.
function Window:_expireNotify(entry: any, instant: any)
	if not entry.alive then return end
	entry.alive = false
	local card = entry.Instance
	local function drop()
		for i, e in ipairs(self._notify) do
			if e == entry then table.remove(self._notify, i); break end
		end
		if card.Parent then card:Destroy() end
		self:_notifySync()
	end
	if instant then
		drop()
		return
	end
	Motion.Spring(card, "GroupTransparency", 1, "Snappy", self):To(1)
	-- collapsing the row height is what makes the list close up smoothly;
	-- destroying it outright snaps everything below it upward
	local body = card:FindFirstChild("Body")
	if body then
		local h = body.AbsoluteSize.Y
		if h > 0 then
			Motion.Tween(card, 0.16, { Size = UDim2.fromOffset(card.AbsoluteSize.X, 0) },
				Enum.EasingStyle.Quad)
		end
	end
	later(0.2, card, drop)
end

-- =====================================================================
-- THEME
-- =====================================================================
-- Only ~96 of ~164 colour sites were registered with paint(), so switching
-- theme left dozens of labels and fills stuck on the old palette. Rather
-- than chase every call site (and every future one), walk the tree and remap
-- any colour that exactly matches an OLD token to the NEW token.
local THEME_TOKEN_ORDER = {
	"Page", "Top", "Card", "CardAlt", "Inset", "Row", "RowHover",
	"Stroke", "Stroke2", "Text", "Sub", "Dim", "Accent", "AccentHi",
	"Sel", "SelStroke", "NavSel", "Hero1", "Hero2", "Good", "Bad", "Footer",
}
local function colorKey(c: any)
	return string.format("%.4f,%.4f,%.4f", c.R, c.G, c.B)
end
local function colorPropsOf(o: any)
	local t = {}
	if o:IsA("GuiObject") then
		t[#t + 1] = "BackgroundColor3"
		t[#t + 1] = "BorderColor3"
	end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		t[#t + 1] = "TextColor3"
		t[#t + 1] = "TextStrokeColor3"
	end
	if o:IsA("TextBox") then t[#t + 1] = "PlaceholderColor3" end
	if o:IsA("ImageLabel") or o:IsA("ImageButton") then t[#t + 1] = "ImageColor3" end
	if o:IsA("ScrollingFrame") then t[#t + 1] = "ScrollBarImageColor3" end
	if o:IsA("UIStroke") then t[#t + 1] = "Color" end
	return t
end
local function remapTree(win: any, old: any, new: any, done: any)
	local byKey = {}
	for _, token in ipairs(THEME_TOKEN_ORDER) do
		local c = old[token]
		if c then
			local k = colorKey(c)
			if not byKey[k] then byKey[k] = token end
		end
	end
	local function walk(o: any)
		for _, prop in ipairs(colorPropsOf(o)) do
			local ok, cur = pcall(function() return o[prop] end)
			if ok and typeof(cur) == "Color3" then
				local token = byKey[colorKey(cur)]
				if token and not (done[o] and done[o][prop]) then
					Motion.Spring(o, prop, new[token], "Soft", win):To(new[token])
				end
			end
		end
		for _, ch in ipairs(o:GetChildren()) do walk(ch) end
	end
	walk(win.Gui)
end

function Window:SetTheme(name: any)
	if not THEMES[name] then return end
	local old = self.Theme
	self.ThemeName = name
	self.Theme = THEMES[name]
	local list = PAINT[self]
	local done = {}
	if list then
		for i = #list, 1, -1 do
			local e = list[i]
			if e.o and e.o.Parent then
				Motion.Spring(e.o, e.p, self.Theme[e.t], "Soft", self):To(self.Theme[e.t])
				done[e.o] = done[e.o] or {}
				done[e.o][e.p] = true
			else
				table.remove(list, i)
			end
		end
	end
	if old and old ~= self.Theme then remapTree(self, old, self.Theme, done) end
	for _, tab in ipairs(self.Tabs) do tab:_restyle() end
	for _, tab in ipairs(self.Tabs) do
		for _, card in ipairs(tab.Cards) do
			for _, el in ipairs(card.Elements) do
				if type(el._restyle) == "function" then pcall(el._restyle) end
			end
		end
	end
	if self.LogoIcon then self.LogoIcon.SetColor(self.Theme.Accent) end
	if self.HeroGradients then
		for _, g in ipairs(self.HeroGradients) do
			if g.Parent then
				g.Color = heroSequence(self.Theme)
			end
		end
	end
	Motion.Spring(self.Stroke, "Color", self.Theme.Stroke2, "Soft", self):To(self.Theme.Stroke2)
	Motion.Wake()
end

function Aether:SetSpeed(v: any) Motion.Speed = math.clamp(tonumber(v) or 1, 0.1, 3) end
function Aether:SetReduceMotion(on: any)
	Motion.Reduce = on == true
	for _, w in ipairs(self.Windows) do if w.Alive then w.Groovy = not on end end
end
function Aether:SetTheme(name: any)
	for _, w in ipairs(self.Windows) do if w.Alive then w:SetTheme(name) end end
end

-- =====================================================================
-- HOTKEYS  ·  Delete (Entf) toggles the overlay, Right Ctrl hides the window
-- =====================================================================
function Window:SetKey(key: any) self.ToggleKey = key end
function Window:SetOverlayKey(key: any)
	self.OverlayKeys = { key }
	for _, p in ipairs(self.Panels) do
		if p._keyRow then p._keyRow:Set(key, false) end
	end
end

local function handleInput(win: any, input: any, processed: any)
	if CAPTURE and CAPTURE.win == win then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local c = CAPTURE
			CAPTURE = nil
			if input.KeyCode == Enum.KeyCode.Escape then
				if c.cancel then c.cancel() end
			elseif c.apply then
				c.apply(input.KeyCode)
			end
			return
		elseif input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			local c = CAPTURE
			CAPTURE = nil
			if c.cancel then c.cancel() end
			return
		end
	end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	-- the overlay hotkey must answer even while a TextBox has focus
	local kc = input.KeyCode
	for _, k in ipairs(win.OverlayKeys) do
		if kc == k then win:ToggleOverlay(); return end
	end
	if processed then return end
	if kc == win.ToggleKey then win:Toggle() end
end

function Window:_bindInput()
	connect(self, UserInputService.InputBegan, function(input, processed)
		local ok, err = pcall(handleInput, self, input, processed)
		if not ok then warn("[Aether input] " .. tostring(err)) end
	end)
end

-- =====================================================================
-- TEARDOWN
-- =====================================================================
function Window:Destroy()
	if CONFIG.CursorImage ~= "" then
		if self._cursorSet then self._cursorSet(false) end
		pcall(function() UserInputService.MouseIcon = "" end)
	end
	if not self.Alive then return end
	self.Alive = false
	Motion.Kill(self)
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	self._conns = {}
	PAINT[self] = nil
	if self.Gui then pcall(function() self.Gui:Destroy() end) end
	for i, w in ipairs(Aether.Windows) do
		if w == self then table.remove(Aether.Windows, i); break end
	end
	if CAPTURE and CAPTURE.win == self then CAPTURE = nil end
end

function Aether:Destroy()
	for i = #self.Windows, 1, -1 do
		local w = self.Windows[i]
		if w then pcall(function() w:Destroy() end) end
	end
	self.Windows = {}
	if Motion._conn then Motion._conn:Disconnect(); Motion._conn = nil end
	Motion.Alive = false
	Motion._tick = nil
end
Aether._destroy = function() pcall(function() Aether:Destroy() end) end

ENV.AetherUI = Aether
ENV.Aether = Aether

