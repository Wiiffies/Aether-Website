-- =====================================================================

-- ---------------------------------------------------------------------
-- Dropdown (single or multi) with a spring-open list and optional search
-- ---------------------------------------------------------------------
function Card:AddDropdown(opts: any)
	opts = opts or {}
	local win = self.Window
	local multi = opts.Multi == true
	local options = opts.Options or {}
	local selected
	if multi then
		selected = {}
		for _, v in ipairs(opts.Default or {}) do selected[v] = true end
	else
		selected = opts.Default or options[1]
	end

	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Label and 46 or 30),
		LayoutOrder = nextOrder(self), ClipsDescendants = false, Parent = self.Body,
	})
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local head = new("TextButton", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0, Text = "",
		Position = UDim2.fromOffset(0, opts.Label and 18 or 0),
		Size = UDim2.new(1, 0, 0, 28), AutoButtonColor = false, Parent = row,
	})
	round(head, 7)
	local hStroke = outline(head, win.Theme.Stroke, 1, 0.35)
	paint(win, head, "BackgroundColor3", "Inset")
	local valueLabel = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(11, 0),
		Size = UDim2.new(1, -40, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 12,
		TextColor3 = win.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = head,
	})
	paint(win, valueLabel, "TextColor3", "Text")
	local chev = drawIcon(head, "chevron", 12, win.Theme.Sub, win)
	chev.Frame.AnchorPoint = Vector2.new(1, 0.5)
	chev.Frame.Position = UDim2.new(1, -10, 0.5, 0)

	local panel = new("CanvasGroup", {
		Name = "Options", BackgroundColor3 = win.Theme.Card, BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, (opts.Label and 18 or 0) + 31),
		Size = UDim2.new(1, 0, 0, 0), GroupTransparency = 1, Visible = false,
		ZIndex = 12, Parent = row,
	})
	round(panel, 8)
	outline(panel, win.Theme.Stroke2, 1, 0.25)
	paint(win, panel, "BackgroundColor3", "Card")
	local pScale = scaler(panel, 1)
	pScale.Scale = 0.97
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 3, ScrollBarImageColor3 = win.Theme.Stroke2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 12, Parent = panel,
	})
	pad(scroll, 6, 6, 6, 6)
	local searchH = 0
	local searchBox
	if opts.Search then
		searchH = 30
		scroll.Position = UDim2.fromOffset(0, searchH)
		scroll.Size = UDim2.new(1, 0, 1, -searchH)
		local sf = new("Frame", {
			BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
			Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 24),
			ZIndex = 13, Parent = panel,
		})
		round(sf, 6)
		paint(win, sf, "BackgroundColor3", "Inset")
		pad(sf, 8, 8, 0, 0)
		searchBox = new("TextBox", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 13,
			Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = win.Theme.Text,
			PlaceholderColor3 = win.Theme.Dim, PlaceholderText = "Search...",
			TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
			Text = "", Parent = sf,
		})
		paint(win, searchBox, "TextColor3", "Text")
	end
	vlist(scroll, 2)

	local api: any = { Instance = row, Open = false }
	local optionButtons = {}
	local listH = 0

	local function displayText()
		if multi then
			local picked = {}
			for _, o in ipairs(options) do if selected[o] then picked[#picked + 1] = tostring(o) end end
			if #picked == 0 then return opts.Placeholder or "None selected" end
			if #picked <= 2 then return table.concat(picked, ", ") end
			return #picked .. " selected"
		end
		return selected ~= nil and tostring(selected) or (opts.Placeholder or "Select...")
	end

	local function refreshMarks()
		for _, b in ipairs(optionButtons) do
			local on = multi and selected[b.value] == true or (not multi and selected == b.value)
			Motion.Spring(b.frame, "BackgroundColor3", on and win.Theme.NavSel or win.Theme.Row, "Snappy", win)
				:To(on and win.Theme.NavSel or win.Theme.Row)
			Motion.Spring(b.frame, "BackgroundTransparency", on and 0 or 1, "Snappy", win):To(on and 0 or 1)
			Motion.Spring(b.label, "TextColor3", on and win.Theme.Text or win.Theme.Sub, "Snappy", win)
				:To(on and win.Theme.Text or win.Theme.Sub)
			b.check.Visible = on
		end
		valueLabel.Text = displayText()
	end

	local function close()
		if not api.Open then return end
		api.Open = false
		Motion.Spring(panel, "GroupTransparency", 1, "Snappy", win):To(1)
		Motion.Spring(pScale, "Scale", 0.97, "Snappy", win):To(0.97)
		Motion.Spring(chev.Frame, "Rotation", 0, "Bouncy", win):To(0)
		Motion.Spring(hStroke, "Color", win.Theme.Stroke, "Snappy", win):To(win.Theme.Stroke)
		later(0.18, panel, function() if not api.Open then panel.Visible = false end end)
	end

	local function open()
		if api.Open then return end
		api.Open = true
		panel.Visible = true
		panel.GroupTransparency = 1
		pScale.Scale = 0.96
		Motion.Spring(panel, "GroupTransparency", 0, "Snappy", win):To(0)
		Motion.Spring(pScale, "Scale", 1, "Groovy", win):To(1)
		Motion.Spring(panel, "Size", UDim2.new(1, 0, 0, listH + searchH + 12), "Bouncy", win)
			:To(UDim2.new(1, 0, 0, listH + searchH + 12))
		Motion.Spring(chev.Frame, "Rotation", 180, "Groovy", win):To(180)
		Motion.Spring(hStroke, "Color", win.Theme.Accent, "Snappy", win):To(win.Theme.Accent)
		Motion.Reveal(scroll, win, { Step = 0.02, Distance = 8, Cap = 0.2 })
	end

	local function fire()
		if not opts.Callback then return end
		local payload
		if multi then
			payload = {}
			for _, o in ipairs(options) do if selected[o] then payload[#payload + 1] = o end end
		else
			payload = selected
		end
		task.spawn(function()
			local ok, err = pcall(opts.Callback, payload)
			if not ok then warn("[Aether dropdown] " .. tostring(err)) end
		end)
	end

	local function build()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		optionButtons = {}
		local filter = searchBox and string.lower(searchBox.Text) or ""
		local shown = 0
		for i, o in ipairs(options) do
			local text = tostring(o)
			if filter == "" or string.find(string.lower(text), filter, 1, true) then
				shown += 1
				local b = new("TextButton", {
					BackgroundColor3 = win.Theme.Row, BackgroundTransparency = 1,
					BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 26), Text = "",
					AutoButtonColor = false, LayoutOrder = i, ZIndex = 13, Parent = scroll,
				})
				round(b, 6)
				local lbl = new("TextLabel", {
					BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -34, 1, 0), Font = Enum.Font.Gotham, TextSize = 12,
					TextColor3 = win.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, Text = text, ZIndex = 13, Parent = b,
				})
				local mark = new("Frame", {
					BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(14, 14),
					ZIndex = 14, Parent = b,
				})
				local chk = drawCheck(mark, 14, win.Theme.AccentHi, win)
				chk.Show(false)
				local entry = { frame = b, label = lbl, value = o, check = mark }
				optionButtons[#optionButtons + 1] = entry
				local sc = scaler(b, 1)
				b.MouseEnter:Connect(function()
					Motion.Spring(b, "BackgroundTransparency", 0.6, "Snappy", win):To(0.6)
					Motion.Spring(sc, "Scale", 1.015, "Bouncy", win):To(1.015)
				end)
				b.MouseLeave:Connect(function()
					local on = multi and selected[o] == true or (not multi and selected == o)
					Motion.Spring(b, "BackgroundTransparency", on and 0 or 1, "Snappy", win):To(on and 0 or 1)
					Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
				end)
				b.Activated:Connect(function()
					if multi then
						selected[o] = not selected[o] or nil
						if selected[o] then chk.Show(true) end
					else
						selected = o
						close()
					end
					refreshMarks()
					fire()
				end)
			end
		end
		listH = math.min(math.max(shown, 1) * 28, opts.MaxHeight or 168)
		panel.Size = UDim2.new(1, 0, 0, listH + searchH + 12)
		refreshMarks()
	end

	function api:Get()
		if not multi then return selected end
		local out = {}
		for _, o in ipairs(options) do if selected[o] then out[#out + 1] = o end end
		return out
	end
	function api:Set(v: any, doFire: any)
		local before = multi and table.concat(api:Get(), "\1") or tostring(selected)
		if multi then
			selected = {}
			for _, x in ipairs(type(v) == "table" and v or { v }) do selected[x] = true end
		else
			selected = v
		end
		refreshMarks()
		local after = multi and table.concat(api:Get(), "\1") or tostring(selected)
		if doFire ~= false and before ~= after then fire() end
	end
	function api:SetOptions(list: any)
		options = list or {}
		build()
	end
	function api:Close() close() end
	-- `Open` is a state flag, so the setter is SetOpen (same as drawers and
	-- accordions). Programmatic open used to be impossible from outside.
	function api:SetOpen(state: any)
		if state then build(); open() else close() end
	end
	function api:Toggle() api:SetOpen(not api.Open) end
	function api:_restyle() refreshMarks() end

	head.Activated:Connect(function()
		ripple(win, head, UserInputService:GetMouseLocation())
		if api.Open then close() else build(); open() end
	end)
	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function() build() end)
	end
	connect(win, UserInputService.InputBegan, function(i)
		if not api.Open then return end
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local m = UserInputService:GetMouseLocation()
		local function inside(o: any)
			local ap, as = o.AbsolutePosition, o.AbsoluteSize
			return m.X >= ap.X and m.X <= ap.X + as.X and m.Y >= ap.Y and m.Y <= ap.Y + as.Y
		end
		if not inside(head) and not inside(panel) then close() end
	end)
	build()
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Textbox with a focus ring, optional validation and a clear button
-- ---------------------------------------------------------------------
function Card:AddTextbox(opts: any)
	opts = opts or {}
	local win = self.Window
	local value = tostring(opts.Default or "")
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Label and 48 or 32),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local field = new("Frame", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, opts.Label and 18 or 0),
		Size = UDim2.new(1, 0, 0, opts.Height or 30), Parent = row,
	})
	round(field, 7)
	paint(win, field, "BackgroundColor3", "Inset")
	local ring = Motion.FocusRing(field, win)
	pad(field, 11, opts.Clearable == false and 11 or 32, 0, 0)
	local iconW = 0
	if opts.Icon then
		local ic = drawIcon(field, opts.Icon, 13, win.Theme.Dim, win)
		ic.Frame.Position = UDim2.fromOffset(-2, ((opts.Height or 30) - 13) / 2)
		iconW = 19
	end
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(iconW, 0),
		Size = UDim2.new(1, -iconW, 1, 0), Font = opts.Mono and Enum.Font.Code or Enum.Font.Gotham,
		TextSize = opts.TextSize or 12, TextColor3 = win.Theme.Text,
		PlaceholderColor3 = win.Theme.Dim, PlaceholderText = opts.Placeholder or "",
		TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
		MultiLine = opts.MultiLine == true, TextWrapped = opts.MultiLine == true,
		TextEditable = opts.Editable ~= false, Text = value, Parent = field,
	})
	paint(win, tb, "TextColor3", "Text")
	local api: any = { Instance = row, Box = tb }
	local function validate(v: any)
		if opts.Numeric then return tonumber(v) ~= nil or v == "" end
		if opts.Pattern then return string.match(v, opts.Pattern) ~= nil or v == "" end
		if opts.Validate then local ok, r = pcall(opts.Validate, v); return ok and r ~= false end
		return true
	end
	local function commit()
		value = tb.Text
		local good = validate(value)
		Motion.Spring(ring.Stroke, "Color", good and win.Theme.Accent or win.Theme.Bad, "Snappy", win)
			:To(good and win.Theme.Accent or win.Theme.Bad)
		if not good then
			Motion.Shake(field, win, { Strength = 5, Duration = 0.3 })
			return
		end
		if opts.Callback then
			task.spawn(function()
				local ok, err = pcall(opts.Callback, opts.Numeric and tonumber(value) or value)
				if not ok then warn("[Aether textbox] " .. tostring(err)) end
			end)
		end
	end
	function api:Get() return opts.Numeric and tonumber(tb.Text) or tb.Text end
	function api:SetText(v: any, fire: any)
		tb.Text = tostring(v)
		value = tb.Text
		if fire then commit() end
	end
	api.Set = api.SetText
	function api:Focus() tb:CaptureFocus() end
	tb.Focused:Connect(function() ring.Enter() end)
	tb.FocusLost:Connect(function() ring.Leave(); commit() end)
	if opts.Clearable ~= false then
		local clear = new("TextButton", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 22, 0.5, 0), Size = UDim2.fromOffset(20, 20),
			Text = "", AutoButtonColor = false, Parent = field,
		})
		local ci = drawIcon(clear, "close", 10, win.Theme.Dim, win)
		ci.Frame.Position = UDim2.fromOffset(5, 5)
		local cs = scaler(clear, 1)
		clear.MouseEnter:Connect(function() Motion.Spring(cs, "Scale", 1.2, "Bouncy", win):To(1.2); ci.SetColor(win.Theme.Text) end)
		clear.MouseLeave:Connect(function() Motion.Spring(cs, "Scale", 1, "Bouncy", win):To(1); ci.SetColor(win.Theme.Dim) end)
		clear.Activated:Connect(function() api:SetText("", true); Motion.Pop(cs, win) end)
	end
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Checkbox (Clean modern card with proper checkmark icon)
-- ---------------------------------------------------------------------
function Card:AddCheckbox(opts: any)
	opts = opts or {}
	local win = self.Window
	local value = opts.Default == true
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Height or 28),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	-- 20x20 well-defined checkbox box
	local box = new("Frame", {
		BackgroundColor3 = value and win.Theme.Accent or win.Theme.Inset, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(20, 20), Parent = row,
	})
	round(box, 5)
	local stroke = outline(box, value and win.Theme.Accent or win.Theme.Stroke2, 1.2, value and 0 or 0.3)
	local bs = scaler(box, 1)

	-- Centered Lucide check icon
	local icon = drawIcon(box, "check", 13, Color3.fromRGB(255, 255, 255), win)
	icon.Frame.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Frame.Position = UDim2.fromScale(0.5, 0.5)
	local iconScale = scaler(icon.Frame, value and 1 or 0)
	icon.Frame.Visible = value

	local label = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(1, -30, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 12,
		TextColor3 = value and win.Theme.Text or win.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
		Text = opts.Name or "Checkbox", Parent = row,
	})
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, Parent = row,
	})
	local api: any = { Instance = row }
	function api:Get() return value end
	function api:Set(v: any, fire: any)
		local changed = (v == true) ~= value
		value = v == true
		Motion.Spring(box, "BackgroundColor3", value and win.Theme.Accent or win.Theme.Inset, "Snappy", win)
			:To(value and win.Theme.Accent or win.Theme.Inset)
		Motion.Spring(stroke, "Transparency", value and 0 or 0.3, "Snappy", win):To(value and 0 or 0.3)
		Motion.Spring(stroke, "Color", value and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win)
			:To(value and win.Theme.Accent or win.Theme.Stroke2)
		label.TextColor3 = value and win.Theme.Text or win.Theme.Sub
		if value then
			icon.Frame.Visible = true
			Motion.Spring(iconScale, "Scale", 1, "Snappy", win):To(1)
		else
			Motion.Spring(iconScale, "Scale", 0, "Snappy", win):To(0)
			later(0.12, icon.Frame, function()
				if not value then icon.Frame.Visible = false end
			end)
		end
		Motion.Pop(bs, win, { From = 0.82, Overshoot = 1.15 })
		if changed and fire ~= false and opts.Callback then
			task.spawn(function() pcall(opts.Callback, value) end)
		end
	end
	function api:_restyle()
		box.BackgroundColor3 = value and win.Theme.Accent or win.Theme.Inset
		stroke.Color = value and win.Theme.Accent or win.Theme.Stroke2
		label.TextColor3 = value and win.Theme.Text or win.Theme.Sub
	end
	hit.Activated:Connect(function() api:Set(not value, true) end)
	hit.MouseEnter:Connect(function()
		Motion.Spring(bs, "Scale", 1.08, "Bouncy", win):To(1.08)
		if not value then Motion.Spring(stroke, "Transparency", 0.1, "Snappy", win):To(0.1) end
	end)
	hit.MouseLeave:Connect(function()
		Motion.Spring(bs, "Scale", 1, "Bouncy", win):To(1)
		if not value then Motion.Spring(stroke, "Transparency", 0.3, "Snappy", win):To(0.3) end
	end)
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Radio group
-- ---------------------------------------------------------------------
function Card:AddRadioGroup(opts: any)
	opts = opts or {}
	local win = self.Window
	local options = opts.Options or {}
	local selected = opts.Default or options[1]
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Height or (26 * #options + (opts.Label and 18 or 0))),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local holder = new("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, opts.Label and 18 or 0),
		Size = UDim2.new(1, 0, 1, opts.Label and -18 or 0), Parent = row,
	})
	if opts.Inline then hlist(holder, 16, Enum.VerticalAlignment.Center) else vlist(holder, 2) end
	local entries = {}
	local api: any = { Instance = row }
	local function repaint()
		for _, e in ipairs(entries) do
			local on = e.value == selected
			Motion.Spring(e.stroke, "Color", on and win.Theme.Accent or win.Theme.Stroke2, "Snappy", win)
				:To(on and win.Theme.Accent or win.Theme.Stroke2)
			Motion.Spring(e.dot, "Size", on and UDim2.fromOffset(9, 9) or UDim2.fromOffset(0, 0), "Groovy", win)
				:To(on and UDim2.fromOffset(9, 9) or UDim2.fromOffset(0, 0))
			Motion.Spring(e.label, "TextColor3", on and win.Theme.Text or win.Theme.Sub, "Snappy", win)
				:To(on and win.Theme.Text or win.Theme.Sub)
		end
	end
	for i, o in ipairs(options) do
		local item = new("TextButton", {
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			Size = opts.Inline and UDim2.fromOffset(textWidth(tostring(o), 12) + 28, 24) or UDim2.new(1, 0, 0, 24),
			LayoutOrder = i, Parent = holder,
		})
		local ring = new("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(17, 17), Parent = item,
		})
		pill(ring)
		local st = outline(ring, win.Theme.Stroke2, 1.4, 0.2)
		local dot = new("Frame", {
			BackgroundColor3 = win.Theme.Accent, BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(0, 0), Parent = ring,
		})
		pill(dot)
		paint(win, dot, "BackgroundColor3", "Accent")
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(26, 0),
			Size = UDim2.new(1, -26, 1, 0), Font = Enum.Font.Gotham, TextSize = 12,
			TextColor3 = win.Theme.Sub, TextXAlignment = Enum.TextXAlignment.Left,
			Text = tostring(o), Parent = item,
		})
		entries[#entries + 1] = { value = o, stroke = st, dot = dot, label = lbl }
		local sc = scaler(ring, 1)
		item.MouseEnter:Connect(function() Motion.Spring(sc, "Scale", 1.12, "Bouncy", win):To(1.12) end)
		item.MouseLeave:Connect(function() Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1) end)
		item.Activated:Connect(function()
			local changed = selected ~= o
			selected = o
			repaint()
			Motion.Pop(sc, win, { From = 0.82, Overshoot = 1.15 })
			if changed and opts.Callback then task.spawn(function() pcall(opts.Callback, o) end) end
		end)
	end
	function api:Get() return selected end
	function api:Set(v: any, fire: any)
		local changed = selected ~= v
		selected = v
		repaint()
		if changed and fire ~= false and opts.Callback then task.spawn(function() pcall(opts.Callback, v) end) end
	end
	function api:_restyle() repaint() end
	repaint()
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Numeric stepper
-- ---------------------------------------------------------------------
function Card:AddStepper(opts: any)
	opts = opts or {}
	local win = self.Window
	local min, max, step = opts.Min or 0, opts.Max or 100, opts.Step or 1
	local value = math.clamp(opts.Default or min, min, max)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, -132, 1, 0),
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Name or "Value", Parent = row,
	})
	local group = new("Frame", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(124, 28), Parent = row,
	})
	round(group, 7)
	outline(group, win.Theme.Stroke, 1, 0.35)
	paint(win, group, "BackgroundColor3", "Inset")
	local vl = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(1, -60, 1, 0), Font = Enum.Font.GothamBold, TextSize = 12,
		TextColor3 = win.Theme.Text, Text = tostring(value) .. (opts.Suffix or ""), Parent = group,
	})
	paint(win, vl, "TextColor3", "Text")
	local vs = scaler(vl, 1)
	local api: any = { Instance = row }
	function api:Get() return value end
	function api:Set(v: any, fire: any)
		local nv = math.clamp(math.floor((tonumber(v) or min) / step + 0.5) * step, min, max)
		nv = math.floor(nv * 1000 + 0.5) / 1000
		local changed = nv ~= value
		value = nv
		vl.Text = tostring(value) .. (opts.Suffix or "")
		Motion.Pop(vs, win, { From = 0.85, Overshoot = 1.08 })
		if changed and fire ~= false and opts.Callback then task.spawn(function() pcall(opts.Callback, value) end) end
	end
	local function side(icon: any, x: any, delta: any)
		local b = new("TextButton", {
			BackgroundTransparency = 1, BackgroundColor3 = win.Theme.Row,
			Position = UDim2.fromOffset(x, 3), Size = UDim2.fromOffset(24, 22),
			Text = "", AutoButtonColor = false, Parent = group,
		})
		round(b, 5)
		local ic = drawIcon(b, icon, 11, win.Theme.Sub, win)
		ic.Frame.Position = UDim2.fromOffset(6.5, 5.5)
		local sc = scaler(b, 1)
		b.MouseEnter:Connect(function()
			Motion.Spring(b, "BackgroundTransparency", 0, "Snappy", win):To(0)
			Motion.Spring(sc, "Scale", 1.1, "Bouncy", win):To(1.1)
			ic.SetColor(win.Theme.Text)
		end)
		b.MouseLeave:Connect(function()
			Motion.Spring(b, "BackgroundTransparency", 1, "Snappy", win):To(1)
			Motion.Spring(sc, "Scale", 1, "Bouncy", win):To(1)
			ic.SetColor(win.Theme.Sub)
		end)
		b.Activated:Connect(function()
			Motion.Pop(sc, win, { From = 0.85 })
			api:Set(value + delta, true)
		end)
		return b
	end
	side("minus", 3, -step)
	side("plus", 97, step)
	self.Elements[#self.Elements + 1] = api
	return api
end

-- ---------------------------------------------------------------------
-- Colour picker: saturation/value square + hue strip + hex field
-- ---------------------------------------------------------------------
function Card:AddColorPicker(opts: any)
	opts = opts or {}
	local win = self.Window
	local color = opts.Default or win.Theme.Accent
	local h, s, v = Color3.toHSV(color)
	local row = new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.Label and 48 or 30),
		LayoutOrder = nextOrder(self), Parent = self.Body,
	})
	if opts.Label then
		new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 16),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = win.Theme.Sub,
			TextXAlignment = Enum.TextXAlignment.Left, Text = opts.Label, Parent = row,
		})
	end
	local api: any = { Instance = row }
	local swatch = new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, opts.Label and 18 or 1),
		Size = UDim2.fromOffset(46, 28), Parent = row,
	})
	round(swatch, 7)
	outline(swatch, win.Theme.Stroke2, 1, 0.3)
	local swScale = scaler(swatch, 1)
	local hexLabel = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(0, opts.Label and 18 or 1),
		Size = UDim2.new(1, -56, 0, 28), Font = Enum.Font.Code, TextSize = 12,
		TextColor3 = win.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "", Parent = row,
	})
	paint(win, hexLabel, "TextColor3", "Text")

	local pop = new("CanvasGroup", {
		Name = "Picker", BackgroundColor3 = win.Theme.Card, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, (opts.Label and 18 or 1) + 32),
		Size = UDim2.fromOffset(212, 176), GroupTransparency = 1, Visible = false,
		ZIndex = 15, Parent = row,
	})
	round(pop, 9)
	outline(pop, win.Theme.Stroke2, 1, 0.25)
	paint(win, pop, "BackgroundColor3", "Card")
	local popScale = scaler(pop, 0.96)

	local square = new("Frame", {
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(150, 116),
		ZIndex = 16, Parent = pop,
	})
	round(square, 6)
	-- Intentional white wash: this IS the saturation axis of a colour picker.
	-- Named so the render-safety regression test can allowlist it.
	local whiteOut = new("Frame", {
		Name = "SaturationWash",
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), ZIndex = 16, Parent = square,
	})
	round(whiteOut, 6)
	new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Parent = whiteOut,
	})
	local blackOut = new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), ZIndex = 17, Parent = square,
	})
	round(blackOut, 6)
	new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
		Rotation = 90, Parent = blackOut,
	})
	local cursor = new("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(s, 1 - v), Size = UDim2.fromOffset(11, 11),
		ZIndex = 18, Parent = square,
	})
	pill(cursor)
	outline(cursor, Color3.new(1, 1, 1), 2, 0)
	-- Intentional white base: a Color UIGradient multiplies it, so the hue
	-- ramp needs a neutral base to show true colours.
	local hue = new("Frame", {
		Name = "HueStrip",
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		Position = UDim2.fromOffset(170, 12), Size = UDim2.fromOffset(14, 116),
		ZIndex = 16, Parent = pop,
	})
	round(hue, 6)
	local stops = {}
	for i = 0, 6 do
		stops[#stops + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1))
	end
	new("UIGradient", { Color = ColorSequence.new(stops), Rotation = 90, Parent = hue })
	local hueKnob = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, h),
		Size = UDim2.new(1, 4, 0, 4), ZIndex = 18, Parent = hue,
	})
	pill(hueKnob)
	local hexBox = new("TextBox", {
		BackgroundColor3 = win.Theme.Inset, BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 138), Size = UDim2.fromOffset(120, 26),
		Font = Enum.Font.Code, TextSize = 12, TextColor3 = win.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
		Text = "", ZIndex = 16, Parent = pop,
	})
	round(hexBox, 6)
	paint(win, hexBox, "BackgroundColor3", "Inset")
	paint(win, hexBox, "TextColor3", "Text")
	pad(hexBox, 8, 8, 0, 0)

	local function hexOf(c: any)
		return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	end
	local function apply(fire: any)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.fromScale(0.5, h)
		hexLabel.Text = hexOf(color)
		hexBox.Text = hexOf(color)
		if fire and opts.Callback then task.spawn(function() pcall(opts.Callback, color) end) end
	end
	function api:Get() return color end
	function api:Set(c: any, fire: any)
		h, s, v = Color3.toHSV(c)
		apply(fire ~= false)
	end
	local dragging = nil
	local function readSquare()
		local m = UserInputService:GetMouseLocation()
		local ap, as = square.AbsolutePosition, square.AbsoluteSize
		if as.X <= 0 or as.Y <= 0 then return end
		s = math.clamp((m.X - ap.X) / as.X, 0, 1)
		v = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
		apply(true)
	end
	local function readHue()
		local m = UserInputService:GetMouseLocation()
		local ap, as = hue.AbsolutePosition, hue.AbsoluteSize
		if as.Y <= 0 then return end
		h = math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
		apply(true)
	end
	for target, kind, reader in pairs({ [square] = "sv", [hue] = "h" }) do
		local hit = new("TextButton", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
			AutoButtonColor = false, ZIndex = 19, Parent = target,
		})
		hit.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = kind
				if kind == "sv" then readSquare() else readHue() end
			end
		end)
	end
	connect(win, UserInputService.InputChanged, function(i)
		if not dragging then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		if dragging == "sv" then readSquare() else readHue() end
	end)
	connect(win, UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			-- OnCommit fires once on release, so a drag can update a value
			-- continuously without spamming a notification per frame.
			if dragging and opts.OnCommit then
				task.spawn(function() pcall(opts.OnCommit, color) end)
			end
			dragging = nil
		end
	end)
	hexBox.FocusLost:Connect(function()
		local r, g, b = hexBox.Text:match("#?(%x%x)(%x%x)(%x%x)")
		if r then
			api:Set(Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)), true)
		else
			Motion.Shake(hexBox, win, { Strength = 4, Duration = 0.25 })
			hexBox.Text = hexOf(color)
		end
	end)
	local open = false
	local toggle = new("TextButton", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, Parent = swatch,
	})
	toggle.MouseEnter:Connect(function() Motion.Spring(swScale, "Scale", 1.06, "Bouncy", win):To(1.06) end)
	toggle.MouseLeave:Connect(function() Motion.Spring(swScale, "Scale", 1, "Bouncy", win):To(1) end)
	toggle.Activated:Connect(function()
		open = not open
		if open then
			pop.Visible = true
			pop.GroupTransparency = 1
			popScale.Scale = 0.94
			Motion.Spring(pop, "GroupTransparency", 0, "Snappy", win):To(0)
			Motion.Spring(popScale, "Scale", 1, "Groovy", win):To(1)
		else
			Motion.Spring(pop, "GroupTransparency", 1, "Snappy", win):To(1)
			Motion.Spring(popScale, "Scale", 0.94, "Snappy", win):To(0.94)
			later(0.18, pop, function() if not open then pop.Visible = false end end)
		end
	end)
	apply(false)
	self.Elements[#self.Elements + 1] = api
	return api
end

